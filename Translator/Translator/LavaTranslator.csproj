<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Translator</AssemblyName>
    <RootNamespace>LavaTranslator</RootNamespace>
    <Version>1.0.0</Version>
    <Description>熔岩翻译助手</Description>
    <Product>Translator</Product>
    <Company>FireNeb-炎序星图</Company>
    <Copyright>© 2026 FireNeb-炎序星图. All rights reserved.</Copyright>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Lava.UI\Lava.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- 独立入口已停用，嵌入 DevBox 使用 -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="App.axaml.cs" />
    <AvaloniaXaml Remove="App.axaml" />
    <Compile Remove="MainWindow.axaml.cs" />
    <AvaloniaXaml Remove="MainWindow.axaml" />
    <!-- 嵌入后不使用独立托盘 / Velopack 更新 -->
    <Compile Remove="Infrastructure\TrayIconService.cs" />
    <Compile Remove="Services\UpdateService.cs" />
  </ItemGroup>

</Project>

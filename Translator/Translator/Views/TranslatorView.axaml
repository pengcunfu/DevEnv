<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LavaTranslator.Views.TranslatorView"
             Background="{DynamicResource BgBrush}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Translator/Themes/Modern.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <StyleInclude Source="avares://Translator/Themes/Controls.axaml"/>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrushKey}"
            BorderThickness="0,1,0,0"
            Padding="10,6">
      <TextBlock x:Name="StatusText" Classes="muted" Text="Alt+Space · 准备就绪"/>
    </Border>

    <Grid Margin="12,8,12,12" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Classes="panel" Padding="8,4" Margin="0,0,0,10">
        <DockPanel LastChildFill="False">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                      DockPanel.Dock="Left">
            <Button x:Name="TabWebButton" Content="网页" Classes="nav-tab selected"
                    Tag="0" Click="OnNavTabClick"/>
            <Button x:Name="TabSettingsButton" Content="设置" Classes="nav-tab"
                    Tag="1" Click="OnNavTabClick"/>
            <Button x:Name="TabAboutButton" Content="关于" Classes="nav-tab"
                    Tag="2" Click="OnNavTabClick"/>
          </StackPanel>

          <StackPanel x:Name="WebToolbar" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center" DockPanel.Dock="Right">
            <ComboBox x:Name="WebSiteCombo" Width="140"
                      DisplayMemberBinding="{Binding Name}"
                      SelectionChanged="OnWebSiteSelectionChanged"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Panel Grid.Row="1">
        <Border x:Name="WebPage" Classes="panel" Padding="0" ClipToBounds="True">
          <NativeWebView x:Name="WebView"
                         NavigationStarted="OnWebNavigationStarted"
                         NavigationCompleted="OnWebNavigationCompleted"/>
        </Border>

        <Grid x:Name="SettingsPage" IsVisible="False" RowDefinitions="*,Auto">
          <Border Grid.Row="0" Classes="panel" Margin="0,10,0,0" Padding="14">
            <StackPanel>
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="开机自启与系统托盘请在 DevBox「设置」中管理。"/>
              <TextBlock x:Name="HotkeyHint" Classes="muted" Margin="0,12,0,0" TextWrapping="Wrap"
                         Text="全局快捷键：Alt+Space（剪贴板有内容时自动填入当前网页翻译站，并切换到本 Tab；否则显示 / 隐藏主窗口）"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="AboutPage" Classes="panel" Padding="24" VerticalAlignment="Top" IsVisible="False">
          <StackPanel>
            <TextBlock Text="熔岩翻译助手" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="VersionText" Text="v1.0.0" Classes="muted" Margin="0,0,0,16"/>
            <TextBlock Text="已内嵌于 DevBox · 基于 .NET 10 + Avalonia" Margin="0,0,0,6"/>
            <TextBlock Text="内嵌有道、搜狗、百度、谷歌、DeepL、必应、腾讯等网页翻译站" Margin="0,0,0,16"/>
            <TextBlock Classes="muted" Text="快捷键：Alt+Space（Windows，剪贴板有内容时自动填入当前网页翻译站）"/>
            <TextBlock Classes="muted" Margin="0,6,0,0"
                       Text="网页翻译需安装 Microsoft Edge WebView2 Runtime"/>
          </StackPanel>
        </Border>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>

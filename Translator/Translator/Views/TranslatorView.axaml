<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LavaTranslator.Views.TranslatorView"
             Background="{DynamicResource BgBrush}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Translator/Themes/Modern.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <StyleInclude Source="avares://Translator/Themes/Controls.axaml"/>
  </UserControl.Styles>
  <NativeWebView x:Name="WebView"
                 NavigationStarted="OnWebNavigationStarted"
                 NavigationCompleted="OnWebNavigationCompleted"/>
</UserControl>

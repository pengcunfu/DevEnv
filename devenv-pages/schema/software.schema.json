{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devenv-download.pages.dev/schema/software.schema.json",
  "title": "开发环境下载站数据",
  "description": "站点数据源 src/data/software.json 的格式定义。在 VS Code 中打开该 JSON 时会自动校验并给出中文提示。",
  "type": "object",
  "required": ["sitename", "categories"],
  "properties": {
    "$schema": { "type": "string", "description": "指向本 Schema 的相对路径" },
    "sitename": { "type": "string", "description": "站点名称（显示在页头）" },
    "description": { "type": "string", "description": "站点副标题" },
    "categories": {
      "type": "array",
      "description": "分类列表",
      "items": { "$ref": "#/definitions/category" }
    }
  },
  "definitions": {
    "category": {
      "type": "object",
      "description": "一个软件分类",
      "required": ["name", "softwares"],
      "properties": {
        "name": { "type": "string", "description": "分类名，如 Java / Python / Node.js" },
        "id": {
          "type": "string",
          "description": "分类锚点标识（仅 ASCII，用于 URL hash，如 common-tools / packaging）。中文分类名必填，避免中文 hash 在不同浏览器编码不一致导致分类切换失效；英文分类可省略（由名称自动推导）"
        },
        "icon": {
          "type": "string",
          "description": "分类图标（对应 SvgIcon 组件中已定义的图标 key，装饰用，可省略）",
          "enum": ["go", "dotnet", "editors", "ai", "api", "devtools", "utils", "pack"]
        },
        "softwares": {
          "type": "array",
          "description": "该分类下的软件列表",
          "items": { "$ref": "#/definitions/software" }
        }
      }
    },
    "software": {
      "type": "object",
      "description": "一个软件",
      "required": ["name", "versions"],
      "properties": {
        "name": { "type": "string", "description": "软件名" },
        "desc": { "type": "string", "description": "一句话描述" },
        "official_site": { "type": "string", "format": "uri", "description": "官网链接（卡片显示「官网」按钮）" },
        "icon": { "type": "string", "description": "软件图标 key（对应 SvgIcon 组件中的图标名，可省略）" },
        "default_source": {
          "type": "string",
          "description": "该软件所有版本的默认下载来源，版本级未写 source 时继承",
          "enum": ["清华镜像", "阿里云", "华为云", "中科大", "GitHub", "官网", "其他"]
        },
        "versions": {
          "type": "array",
          "description": "版本列表（第一个为默认选中）",
          "items": { "$ref": "#/definitions/version" }
        }
      }
    },
    "version": {
      "type": "object",
      "description": "一个可下载版本",
      "required": ["version", "url", "file_name"],
      "properties": {
        "version": { "type": "string", "description": "版本号（纯文本，如 8 / 3.12.3）" },
        "url": { "type": "string", "format": "uri", "description": "下载地址（外链）" },
        "file_name": { "type": "string", "description": "文件名（展示 + 复制）" },
        "source": {
          "type": "string",
          "description": "下载来源（决定徽章颜色），缺省继承软件级 default_source",
          "enum": ["清华镜像", "阿里云", "华为云", "中科大", "GitHub", "官网", "其他"]
        },
        "size": { "type": "string", "description": "文件大小展示文本，如 98 MB" },
        "os": { "type": "string", "description": "平台：windows / macos / linux", "enum": ["windows", "macos", "linux"] },
        "arch": { "type": "string", "description": "架构：x64 / arm64", "enum": ["x64", "arm64"] },
        "remark": { "type": "string", "description": "备注，如「官方下载页」「需授权」" }
      }
    }
  }
}

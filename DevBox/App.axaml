<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:devenvConverters="using:DevEnv.Converters"
             x:Class="ProgramBox.App">

    <Application.Resources>
        <ResourceDictionary>
            <devenvConverters:StringToBrushConverter x:Key="StringToBrushConverter"/>
            <devenvConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <devenvConverters:FileSizeConverter x:Key="FileSizeConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Lava.UI/Themes/Tokens.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://DevEnv/Themes/CompactDataGrid.axaml"/>
        <StyleInclude Source="avares://Lava.UI/Themes/Index.axaml"/>
    </Application.Styles>
</Application>

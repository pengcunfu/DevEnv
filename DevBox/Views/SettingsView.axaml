<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="480"
             x:Class="ProgramBox.Views.SettingsView"
             Background="{DynamicResource BackgroundBrush}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="24">
            <TextBlock Text="设置" Classes="Title"/>
            
            <!-- General Settings -->
            <Border Classes="Card">
                <StackPanel Spacing="16">
                    <TextBlock Text="常规设置" Classes="Subtitle"/>
                    
                    <CheckBox x:Name="TrayIconCheckBox"
                              Content="启用托盘（关闭窗口时隐藏到托盘，不退出程序）"/>
                    <CheckBox x:Name="SelfStartingCheckBox" Content="开机自启动"/>
                    <TextBlock Text="登录 Windows 后自动启动 DevBox"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <CheckBox x:Name="EdgeAutoHideCheckBox" Content="靠边悬停隐藏"/>
                    <TextBlock Text="窗口贴到屏幕边缘后自动隐藏，鼠标移到屏幕边缘即可恢复显示"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="界面语言" Classes="Body"/>
                        <ComboBox x:Name="LanguageComboBox" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                            <ComboBoxItem Content="English" Tag="en-US"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Hotkey Settings -->
            <Border Classes="Card">
                <StackPanel Spacing="16">
                    <TextBlock Text="快捷键" Classes="Subtitle"/>
                    <TextBlock Text="按下快捷键可随时显示并居中 DevBox 窗口"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="显示窗口"
                                   Classes="Body"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 x:Name="HotkeyTextBox"
                                 IsReadOnly="True"
                                 Watermark="未设置快捷键"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                x:Name="CaptureHotkeyButton"
                                Content="录制"
                                Click="CaptureHotkeyButton_Click"
                                MinWidth="72"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="3"
                                Content="清除"
                                Click="ClearHotkeyButton_Click"
                                MinWidth="72"/>
                    </Grid>
                    <TextBlock x:Name="HotkeyHintText"
                               Classes="Body"
                               Foreground="{DynamicResource PrimaryBrush}"
                               IsVisible="False"
                               Text="请按下新的快捷键组合（如 Ctrl+Alt+D），按 Esc 取消"/>
                </StackPanel>
            </Border>

            <!-- Appearance Settings -->
            <Border Classes="Card">
                <StackPanel Spacing="16">
                    <TextBlock Text="外观设置" Classes="Subtitle"/>
                    
                    <CheckBox x:Name="DarkModeCheckBox" Content="深色模式"/>
                </StackPanel>
            </Border>
            
            <!-- Environment Path Settings -->
            <Border Classes="Card">
                <StackPanel Spacing="16">
                    <TextBlock Text="环境路径" Classes="Subtitle"/>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="基础路径" Classes="Body"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BaseEnvPathTextBox" Grid.Column="0" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="浏览..." Click="BrowsePathButton_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Documentation -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Text="文档" Classes="Subtitle"/>
                    <TextBlock Text="查看在线文档：使用说明、发版说明等" Classes="Body"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="查看文档" Click="ViewDocumentationButton_Click"/>
                        <TextBlock x:Name="DocUrlText"
                                   Classes="Body"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="420"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Text="关于" Classes="Subtitle"/>
                    <TextBlock Text="DevBox" Classes="Body" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AboutVersionText"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="专为程序员设计的多语言开发环境管理工具，支持 Java、Node.js、Python、C++ 等多种开发环境。"
                               Classes="Body"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                <Button Content="保存" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lt="using:LavaTranslator.Models"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="480"
             x:Class="ProgramBox.Views.SettingsView"
             Background="{DynamicResource BackgroundBrush}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" Spacing="12">
            <TextBlock Text="设置" Classes="Title"/>
            
            <!-- General Settings -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Text="常规设置" Classes="Subtitle"/>
                    
                    <CheckBox x:Name="TrayIconCheckBox"
                              Content="启用托盘（关闭窗口时隐藏到托盘，不退出程序）"/>
                    <CheckBox x:Name="SelfStartingCheckBox" Content="开机自启动"/>
                    <TextBlock Text="登录 Windows 后自动启动程序盒子"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <CheckBox x:Name="EdgeAutoHideCheckBox" Content="靠边悬停隐藏"/>
                    <TextBlock Text="窗口贴到屏幕边缘后自动隐藏，鼠标移到屏幕边缘即可恢复显示"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="快捷方式启动方式" Classes="Body"/>
                        <ComboBox x:Name="LaunchModeComboBox" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="单击启动" Tag="Single"/>
                            <ComboBoxItem Content="双击启动" Tag="Double"/>
                        </ComboBox>
                        <TextBlock Text="控制本地应用、文件夹、网站以及系统工具卡片的打开方式"
                                   Classes="Body"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="界面语言" Classes="Body"/>
                        <ComboBox x:Name="LanguageComboBox" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                            <ComboBoxItem Content="English" Tag="en-US"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Hotkey Settings -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Text="快捷键" Classes="Subtitle"/>
                    <TextBlock Text="按下快捷键可随时显示并居中程序盒子窗口"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="显示窗口"
                                   Classes="Body"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 x:Name="HotkeyTextBox"
                                 IsReadOnly="True"
                                 PlaceholderText="未设置快捷键"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                x:Name="CaptureHotkeyButton"
                                Content="录制"
                                Click="CaptureHotkeyButton_Click"
                                MinWidth="72"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="3"
                                Content="清除"
                                Click="ClearHotkeyButton_Click"
                                MinWidth="72"/>
                    </Grid>
                    <TextBlock x:Name="HotkeyHintText"
                               Classes="Body"
                               Foreground="{DynamicResource PrimaryBrush}"
                               IsVisible="False"
                               Text="请按下新的快捷键组合（如 Ctrl+Alt+D），按 Esc 取消"/>
                </StackPanel>
            </Border>

            <!-- Appearance Settings -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观设置" Classes="Subtitle"/>
                    
                    <CheckBox x:Name="DarkModeCheckBox" Content="深色模式"/>
                </StackPanel>
            </Border>
            
            <!-- Environment Path Settings -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Text="环境路径" Classes="Subtitle"/>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="基础路径" Classes="Body"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BaseEnvPathTextBox" Grid.Column="0" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="浏览..." Click="BrowsePathButton_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Update Settings -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Text="更新" Classes="Subtitle"/>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="当前版本"
                                   Classes="Body"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="UpdateCurrentVersionText"
                                   Classes="Body"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                x:Name="CheckUpdateButton"
                                Content="检查更新"
                                Click="CheckUpdateButton_Click"
                                MinWidth="96"/>
                    </Grid>

                    <TextBlock x:Name="UpdateStatusText"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <ProgressBar x:Name="UpdateProgressBar"
                                 Minimum="0" Maximum="100"
                                 Height="6"
                                 IsVisible="False"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DownloadUpdateButton"
                                Content="下载并更新"
                                Click="DownloadUpdateButton_Click"
                                IsVisible="False"/>
                        <Button x:Name="RestartUpdateButton"
                                Content="立即重启更新"
                                Click="RestartUpdateButton_Click"
                                IsVisible="False"/>
                        <Button x:Name="GotoReleasesButton"
                                Content="前往下载安装包"
                                Click="GotoReleasesButton_Click"
                                IsVisible="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Documentation -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Text="文档" Classes="Subtitle"/>
                    <TextBlock Text="查看在线文档：使用说明、发版说明等" Classes="Body"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="查看文档" Click="ViewDocumentationButton_Click"/>
                        <TextBlock x:Name="DocUrlText"
                                   Classes="Body"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="420"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 熔岩翻译 -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Text="熔岩翻译" Classes="Subtitle"/>
                    <TextBlock Text="默认网页翻译引擎（在「熔岩翻译」Tab 中打开）"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="TranslatorEngineCombo"
                              Width="200"
                              HorizontalAlignment="Left"
                              DisplayMemberBinding="{Binding Name, DataType=lt:WebTranslateSite}"/>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Text="关于" Classes="Subtitle"/>
                    <TextBlock Text="程序盒子" Classes="Body" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AboutVersionText"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="专为程序员设计的多语言开发环境管理工具，支持 Java、Node.js、Python、C++ 等多种开发环境。"
                               Classes="Body"
                               TextWrapping="Wrap"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4"/>

                    <TextBlock Text="熔岩翻译助手" Classes="Body" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TranslatorAboutVersionText"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="已内嵌于程序盒子 · 基于 .NET 10 + Avalonia"
                               Classes="Body"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="内嵌有道、搜狗、百度、谷歌、DeepL、必应、腾讯等网页翻译站"
                               Classes="Body"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="快捷键：Alt+Space（Windows，剪贴板有内容时自动填入当前网页翻译站，并切换到本 Tab；否则显示 / 隐藏主窗口）"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="网页翻译需安装 Microsoft Edge WebView2 Runtime"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="开机自启与系统托盘请使用上方常规设置"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4"/>

                    <TextBlock Text="熔岩剪贴板" Classes="Body" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ClipboardAboutVersionText"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="已内嵌于程序盒子 · 剪贴板历史管理"
                               Classes="Body"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="自动记录文本与图片历史，支持搜索、导出；可在本 Tab 内配置唤起快捷键"
                               Classes="Body"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="主要功能：自动记录 · 文本/图片 · 搜索 · 导出历史"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="版权所有 © 2026 Fireneb-炎序星图"
                               Classes="Body"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                <Button Content="保存" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ProgramBox.Models"
        x:Class="ProgramBox.Views.StartupManagerWindow"
        Title="启动项管理"
        Width="960" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Grid RowDefinitions="*,Auto" Margin="12">
        <TabControl x:Name="MainTabControl" Grid.Row="0">
            <!-- 启动项 -->
            <TabItem Header="启动项">
                <Grid RowDefinitions="Auto,*" Margin="8">
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="StartupSearchBox" Grid.Column="1"
                                     PlaceholderText="按名称或路径筛选"
                                     TextChanged="StartupSearchBox_TextChanged"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="刷新" MinWidth="72" Click="StartupRefresh_Click"/>
                            <Button Content="添加" MinWidth="72" Click="StartupAdd_Click"/>
                            <Button Content="启用" MinWidth="72" Click="StartupEnable_Click"/>
                            <Button Content="禁用" MinWidth="72" Click="StartupDisable_Click"/>
                            <Button Content="删除" MinWidth="72" Click="StartupRemove_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="StartupGrid" Grid.Row="1"
                              x:DataType="models:StartupEntry"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="命令/路径" Binding="{Binding Command}" Width="*"/>
                            <DataGridTextColumn Header="位置" Binding="{Binding LocationDisplay}" Width="140"/>
                            <DataGridTextColumn Header="已启用" Binding="{Binding EnabledDisplay}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 服务 -->
            <TabItem Header="服务">
                <Grid RowDefinitions="Auto,*" Margin="8">
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="ServiceSearchBox" Grid.Column="1"
                                     PlaceholderText="按显示名、服务名或路径筛选"
                                     TextChanged="ServiceSearchBox_TextChanged"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="刷新" MinWidth="72" Click="ServiceRefresh_Click"/>
                            <Button Content="禁用自启" MinWidth="88" Click="ServiceDisable_Click"/>
                            <Button Content="删除服务" MinWidth="88" Click="ServiceDelete_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="ServiceGrid" Grid.Row="1"
                              x:DataType="models:StartupEntry"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="显示名称" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="服务名称" Binding="{Binding Id}" Width="160"/>
                            <DataGridTextColumn Header="路径" Binding="{Binding Command}" Width="*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding ServiceStatus}" Width="90"/>
                            <DataGridTextColumn Header="启动类型" Binding="{Binding StartType}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 计划任务 -->
            <TabItem Header="计划任务">
                <Grid RowDefinitions="Auto,*" Margin="8">
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TaskSearchBox" Grid.Column="1"
                                     PlaceholderText="按任务名称筛选"
                                     TextChanged="TaskSearchBox_TextChanged"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="刷新" MinWidth="72" Click="TaskRefresh_Click"/>
                            <Button Content="禁用" MinWidth="72" Click="TaskDisable_Click"/>
                            <Button Content="删除" MinWidth="72" Click="TaskDelete_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="TaskGrid" Grid.Row="1"
                              x:DataType="models:StartupEntry"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="任务名称" Binding="{Binding Name}" Width="280"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding ServiceStatus}" Width="120"/>
                            <DataGridTextColumn Header="详情" Binding="{Binding Command}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Margin="0,8,0,0" Padding="8,6"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="4"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <TextBlock x:Name="StatusText"
                       Text="就绪"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>

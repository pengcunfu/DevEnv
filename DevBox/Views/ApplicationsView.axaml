<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:ProgramBox.Models"
             xmlns:converters="using:ProgramBox.Converters"
             mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="480"
             x:Class="ProgramBox.Views.ApplicationsView"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:PathToBitmapConverter x:Key="PathToBitmap"/>
    </UserControl.Resources>

    <TabControl>
        <TabItem Header="本地应用">
            <ScrollViewer x:Name="NativeScrollArea" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="选择程序..." Click="BrowseExeButton_Click"/>
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <StackPanel Margin="16">

                    <ItemsControl x:Name="NativeApplicationsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:NativeAtom">
                                <Border Classes="ToolCard"
                                        Width="140"
                                        Height="64"
                                        Tag="{Binding}"
                                        PointerPressed="NativeAppCard_PointerPressed"
                                        ToolTip.Tip="{Binding ExecPath}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="运行" Tag="{Binding}" Click="NativeRunMenu_Click"/>
                                            <MenuItem Header="在资源管理器中显示" Tag="{Binding}" Click="NativeExplorerMenu_Click"/>
                                            <MenuItem Header="移除" Tag="{Binding}" Click="NativeDeleteMenu_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="Auto,*" Margin="8">
                                        <Border Grid.Column="0"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="6"
                                                Background="{DynamicResource IconBackgroundBrush}"
                                                VerticalAlignment="Center">
                                            <Image Width="32"
                                                   Height="32"
                                                   Stretch="Uniform"
                                                   Source="{Binding IconPath, Converter={StaticResource PathToBitmap}}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="NativeEmptyState"
                            Classes="Card"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Margin="0,24,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="暂无本地应用程序"
                                       Classes="Subtitle"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="右键空白区域选择程序，或直接拖入 .exe"
                                       Classes="Body"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="文件夹">
            <ScrollViewer x:Name="FolderScrollArea" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="选择文件夹..." Click="BrowseFolderButton_Click"/>
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <StackPanel Margin="16">

                    <ItemsControl x:Name="FolderShortcutsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:FolderAtom">
                                <Border Classes="ToolCard"
                                        Width="140"
                                        Height="64"
                                        Tag="{Binding}"
                                        PointerPressed="FolderCard_PointerPressed"
                                        ToolTip.Tip="{Binding FolderPath}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="打开" Tag="{Binding}" Click="FolderOpenMenu_Click"/>
                                            <MenuItem Header="编辑别名与图标" Tag="{Binding}" Click="FolderEditMenu_Click"/>
                                            <MenuItem Header="移除" Tag="{Binding}" Click="FolderDeleteMenu_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="Auto,*" Margin="8">
                                        <Border Grid.Column="0"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="6"
                                                Background="{DynamicResource IconBackgroundBrush}"
                                                VerticalAlignment="Center">
                                            <Image Width="32"
                                                   Height="32"
                                                   Stretch="Uniform"
                                                   Source="{Binding IconPath, Converter={StaticResource PathToBitmap}}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="FolderEmptyState"
                            Classes="Card"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Margin="0,24,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="暂无文件夹快捷方式"
                                       Classes="Subtitle"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="右键空白区域选择文件夹，或直接拖入文件夹"
                                       Classes="Body"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="网站">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="添加网站..." Click="AddWebApplicationButton_Click"/>
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <StackPanel Margin="16">

                    <ItemsControl x:Name="WebApplicationsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:WebAtom">
                                <Border Classes="ToolCard"
                                        Width="140"
                                        Height="64"
                                        Tag="{Binding}"
                                        PointerPressed="WebCard_PointerPressed"
                                        ToolTip.Tip="{Binding Url}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="在浏览器中打开" Tag="{Binding}" Click="WebOpenMenu_Click"/>
                                            <MenuItem Header="编辑标题与图标" Tag="{Binding}" Click="WebEditMenu_Click"/>
                                            <MenuItem Header="移除" Tag="{Binding}" Click="WebDeleteMenu_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="Auto,*" Margin="8">
                                        <Border Grid.Column="0"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="6"
                                                Background="{DynamicResource IconBackgroundBrush}"
                                                VerticalAlignment="Center">
                                            <Image Width="32"
                                                   Height="32"
                                                   Stretch="Uniform"
                                                   Source="{Binding IconPath, Converter={StaticResource PathToBitmap}}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="WebEmptyState"
                            Classes="Card"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            Padding="32"
                            Margin="0,24,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="暂无快捷网站"
                                       Classes="Subtitle"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="右键空白区域添加网站"
                                       Classes="Body"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="系统工具">
            <ContentControl x:Name="SystemToolsHost"/>
        </TabItem>

        <TabItem Header="设置">
            <ContentControl x:Name="SettingsHost"/>
        </TabItem>
    </TabControl>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="540"
        x:Class="ProgramBox.MainWindow"
        Title="DevBox"
        Width="960" Height="540"
        MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（仅关闭，无最小化/最大化） -->
        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <Border Grid.Column="0"
                        Background="Transparent"
                        PointerPressed="TitleBar_PointerPressed">
                    <TextBlock Text="DevBox"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Border>
                <Button Grid.Column="1"
                        x:Name="CloseWindowButton"
                        Classes="TitleBarClose"
                        Content="✕"
                        ToolTip.Tip="关闭到托盘"
                        Click="CloseWindowButton_Click"
                        Width="46"
                        Height="32"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="14"
                        CornerRadius="0"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Margin="0">
                <ContentControl x:Name="ContentArea"/>
                
                <!-- Default Content -->
                <ScrollViewer x:Name="DefaultContent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <!-- Welcome Section -->
                        <Border Classes="Card" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="欢迎使用 DevBox" Classes="Title"/>
                                <TextBlock Text="专为程序员设计的多语言开发环境管理工具" Classes="Body" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Button Content="开始使用" Click="GetStartedButton_Click"/>
                                    <Button Content="查看文档" Click="ViewDocumentationButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Features Grid -->
                        <TextBlock Text="主要功能" Classes="Subtitle" Margin="0,0,0,16"/>
                        <UniformGrid Columns="3" Margin="0,0,0,24">
                            <!-- Development Tools -->
                            <Border Classes="Card" Cursor="Hand" PointerPressed="DevelopmentCard_Click">
                                <StackPanel HorizontalAlignment="Center" Margin="8">
                                    <TextBlock Text="开发环境" Classes="Subtitle" TextAlignment="Center"/>
                                    <TextBlock Text="管理Java、Node.js、Python等开发环境" Classes="Body" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- System Tools -->
                            <Border Classes="Card" Cursor="Hand" PointerPressed="SystemCard_Click">
                                <StackPanel HorizontalAlignment="Center" Margin="8">
                                    <TextBlock Text="系统工具" Classes="Subtitle" TextAlignment="Center"/>
                                    <TextBlock Text="快速访问Windows系统管理工具" Classes="Body" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Application Management -->
                            <Border Classes="Card" Cursor="Hand" PointerPressed="ApplicationCard_Click">
                                <StackPanel HorizontalAlignment="Center" Margin="8">
                                    <TextBlock Text="应用管理" Classes="Subtitle" TextAlignment="Center"/>
                                    <TextBlock Text="管理和快速启动常用应用程序" Classes="Body" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Height="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock x:Name="VersionText" Text="版本 1.0.0" FontSize="12" VerticalAlignment="Center" Margin="8,0" Grid.Column="1"/>
            </Grid>
        </Border>

        <!-- 调整大小热区（四边 + 四角）：无边框窗口没有系统缩放边框，这里提供可拖拽缩放的边缘 -->
        <Border Grid.RowSpan="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6"
                Background="Transparent" Cursor="SizeWestEast" PointerPressed="ResizeWest"/>
        <Border Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="6"
                Background="Transparent" Cursor="SizeWestEast" PointerPressed="ResizeEast"/>
        <Border Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="6"
                Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="ResizeNorth"/>
        <Border Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="6"
                Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="ResizeSouth"/>
        <Border Grid.RowSpan="3" HorizontalAlignment="Left" VerticalAlignment="Top" Width="12" Height="12"
                Background="Transparent" Cursor="SizeAll" PointerPressed="ResizeNorthWest"/>
        <Border Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Width="12" Height="12"
                Background="Transparent" Cursor="SizeAll" PointerPressed="ResizeNorthEast"/>
        <Border Grid.RowSpan="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="12" Height="12"
                Background="Transparent" Cursor="SizeAll" PointerPressed="ResizeSouthWest"/>
        <Border Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12"
                Background="Transparent" Cursor="SizeAll" PointerPressed="ResizeSouthEast"/>
    </Grid>
</Window>

<UserControl x:Class="DevEnv.Host.SigXor.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <!-- 空格预览文件夹时使用：目录导航 + 文件列表，双击文件交给外层预览窗打开 -->
    <UserControl.Resources>
        <Style x:Key="FolderToolbarButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource FolderToolbarButton}" Content="&#xE72B;" ToolTip="后退"
                        Command="{Binding NavigateBackCommand}" IsEnabled="{Binding CanGoBack}" />
                <Button Grid.Column="1" Style="{StaticResource FolderToolbarButton}" Content="&#xE72A;" ToolTip="前进"
                        Command="{Binding NavigateForwardCommand}" IsEnabled="{Binding CanGoForward}" />
                <Button Grid.Column="2" Style="{StaticResource FolderToolbarButton}" Content="&#xE74A;" ToolTip="上级目录"
                        Command="{Binding NavigateUpCommand}" />
                <Button Grid.Column="3" Style="{StaticResource FolderToolbarButton}" Content="&#xE72C;" ToolTip="刷新"
                        Command="{Binding RefreshCommand}" />
                <TextBox x:Name="PathBox" Grid.Column="4" Margin="8,0" Padding="6,4"
                         Text="{Binding CurrentDirectory, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" KeyDown="OnPathKeyDown" />
                <Button Grid.Column="5" Content="转到" Padding="12,4" Click="OnGoClick" ToolTip="进入输入的目录" />
                <Button Grid.Column="6" Content="资源管理器" Padding="10,4" Margin="8,0,0,0"
                        Click="OnOpenExplorerClick" ToolTip="在资源管理器中打开当前目录" />
            </Grid>
        </Border>

        <ListView x:Name="FileList" Grid.Row="1"
                  Background="{DynamicResource SurfaceBrush}" BorderThickness="0"
                  ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                  MouseDoubleClick="OnFileDoubleClick" KeyDown="OnListKeyDown"
                  VirtualizingPanel.IsVirtualizing="True">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="520">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,7,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="大小" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="修改时间" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
    </Grid>
</UserControl>

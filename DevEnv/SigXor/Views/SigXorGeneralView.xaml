<UserControl x:Class="DevEnv.Host.SigXor.Views.SigXorGeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Top">
    <!-- 文件预览的常规选项：字体、备份与更新（与宿主「常规选项」卡片同宽、同 CardStyle）。 -->
    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
        <StackPanel>
            <TextBlock Text="文件预览" Style="{DynamicResource SectionTitleStyle}" />
            <TextBlock Text="文件快速预览的字体、备份与更新选项" Style="{DynamicResource PageHintStyle}" />

            <CheckBox x:Name="BackupCheck" Content="保存前自动备份到 Documents\FNSoftware\SigXor\Backups" Margin="0,14,0,0"/>
            <CheckBox x:Name="CheckUpdatesCheck" Content="启动时自动检查更新（发现新版本时托盘提示）" Margin="0,8,0,0"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="108"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="108"/>
                    <ColumnDefinition Width="88"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="文本字体" Style="{DynamicResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <ComboBox x:Name="FontFamilyCombo" Grid.Column="1" Grid.Row="0"
                          IsEditable="True" StaysOpenOnEdit="True"
                          VerticalContentAlignment="Center" Margin="0,0,10,8"/>
                <TextBlock Grid.Column="2" Grid.Row="0" Text="文本字号" Style="{DynamicResource MutedTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="TextFontSizeBox" Grid.Column="3" Grid.Row="0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="十六进制字号" Style="{DynamicResource MutedTextStyle}" VerticalAlignment="Center"/>
                <TextBox x:Name="HexFontSizeBox" Grid.Column="1" Grid.Row="1" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="2" Grid.Row="1" Text="每行字节数" Style="{DynamicResource MutedTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="BytesPerRowBox" Grid.Column="3" Grid.Row="1" VerticalContentAlignment="Center"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="保存" Width="96" Style="{StaticResource AccentButtonStyle}"
                        Click="OnSaveClick"/>
                <TextBlock x:Name="Message" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{DynamicResource PageHintStyle}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

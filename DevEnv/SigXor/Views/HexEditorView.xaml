<UserControl x:Class="DevEnv.Host.SigXor.Views.HexEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DevEnv.Host.SigXor.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Width="180" Margin="0,0,6,0" ToolTip="十六进制搜索，如 48 65 6C 或 48656C"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="查找" Command="{Binding FindNextCommand}" Padding="10,3" Margin="0,0,4,0"/>
                <Button Grid.Column="2" Content="上一个" Command="{Binding FindPreviousCommand}" Padding="10,3" Margin="0,0,10,0"/>
                <TextBox Grid.Column="3" Width="100" Margin="0,0,4,0" ToolTip="跳转偏移：0x 前缀为十六进制，否则十进制"
                         Text="{Binding GotoText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="4" Content="跳转" Command="{Binding GotoCommand}" Padding="10,3" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="5" SelectedIndex="{Binding CopyFormatIndex}" Width="110" Margin="0,0,4,0">
                    <ComboBoxItem Content="Hex 字符串"/>
                    <ComboBoxItem Content="ASCII 文本"/>
                    <ComboBoxItem Content="C 数组"/>
                </ComboBox>
                <Button Grid.Column="6" Content="复制" Command="{Binding CopyCommand}" Padding="10,3" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="7" Text="{Binding ModeText}" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                <Button Grid.Column="8" Content="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}"
                        Padding="12,3" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="9" Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" CanContentScroll="True"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <!-- 配色走主题资源（AGENTS.md 第 11 条）：DynamicResource 绑到
                 DependencyProperty 上，深浅主题切换时自动跟随。 -->
            <controls:HexEditor x:Name="Editor"
                                Background="{DynamicResource SurfaceBrush}"
                                TextBrush="{DynamicResource TextPrimaryBrush}"
                                OffsetBrush="{DynamicResource TextMutedBrush}"
                                SelectionBrush="{DynamicResource SelectedBrush}"
                                CaretBrush="{DynamicResource AccentBrush}"
                                EditedBrush="{DynamicResource WarningBrush}"
                                MatchBrush="{DynamicResource AccentBrush}"/>
        </ScrollViewer>
    </Grid>
</UserControl>

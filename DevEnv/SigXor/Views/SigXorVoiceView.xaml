<UserControl x:Class="DevEnv.Host.SigXor.Views.SigXorVoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Top">
  <!-- 语音输入与区域截屏；版式与宿主其它设置页一致（CardStyle + 统一表单列宽）。 -->
    <Grid HorizontalAlignment="Stretch">
        <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="语音输入" Style="{DynamicResource SectionTitleStyle}" />
                <TextBlock Text="语音与截屏的快捷键已统一到「快捷键」页签修改。"
                           Style="{DynamicResource PageHintStyle}" TextWrapping="Wrap" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="识别引擎" Style="{DynamicResource MutedTextStyle}" VerticalAlignment="Center" />
                    <ComboBox x:Name="VoiceEngineCombo" Grid.Column="1" Margin="0,0,0,10"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="SenseVoice（推荐）" Tag="sensevoice"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="识别语言" Style="{DynamicResource MutedTextStyle}" VerticalAlignment="Center" />
                    <ComboBox x:Name="VoiceLanguageCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="自动" Tag="auto"/>
                        <ComboBoxItem Content="中文" Tag="zh-CN"/>
                        <ComboBoxItem Content="English" Tag="en-US"/>
                        <ComboBoxItem Content="粤语" Tag="yue"/>
                        <ComboBoxItem Content="日语" Tag="ja"/>
                        <ComboBoxItem Content="韩语" Tag="ko"/>
                    </ComboBox>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,10">
                        <CheckBox x:Name="UseClipboardCheck" Content="使用剪贴板粘贴识别结果" Margin="0,0,0,6"/>
                        <CheckBox x:Name="VoiceAutoStartCheck" Content="启动后自动启动语音服务（模型已安装时）" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ShowNotificationsCheck" Content="显示操作通知" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DebugModeCheck" Content="调试模式（输出诊断日志）" Margin="0,0,0,6"/>
                        <CheckBox x:Name="SaveAudioCheck" Content="保存录音 WAV 到 Documents\FNSoftware\SigXor\Audio" Margin="0,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="长按阈值(秒)" Style="{DynamicResource MutedTextStyle}" VerticalAlignment="Center" />
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HoldThresholdBox" VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="输入延迟(秒)" Style="{DynamicResource MutedTextStyle}"
                                   VerticalAlignment="Center" Margin="12,0,10,0" />
                        <TextBox x:Name="TypingDelayBox" Grid.Column="2" Grid.ColumnSpan="2" VerticalContentAlignment="Center" />
                    </Grid>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="保存" Width="96" Style="{StaticResource AccentButtonStyle}"
                            Click="OnSaveClick"/>
                    <Button Content="恢复默认" Margin="8,0,0,0" Click="OnResetClick"/>
                    <TextBlock x:Name="Message" Margin="12,0,0,0" VerticalAlignment="Center"
                               Style="{DynamicResource PageHintStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

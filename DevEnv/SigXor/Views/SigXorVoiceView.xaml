<UserControl x:Class="DevEnv.Host.SigXor.Views.SigXorVoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 语音输入与区域截屏的设置项。 -->
    <StackPanel>
        <GroupBox Header="语音输入" Padding="10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="识别引擎" VerticalAlignment="Center"/>
                    <ComboBox x:Name="VoiceEngineCombo" Grid.Column="1">
                        <ComboBoxItem Content="SenseVoice（推荐）" Tag="sensevoice"/>
                    </ComboBox>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="语音快捷键" VerticalAlignment="Center"/>
                    <ComboBox x:Name="VoiceShortcutCombo" Grid.Column="1">
                        <ComboBoxItem Content="右 Alt（默认）" Tag="right-alt"/>
                        <ComboBoxItem Content="左 Alt" Tag="left-alt"/>
                        <ComboBoxItem Content="右 Ctrl" Tag="right-ctrl"/>
                        <ComboBoxItem Content="左 Ctrl" Tag="left-ctrl"/>
                        <ComboBoxItem Content="Caps Lock" Tag="caps-lock"/>
                    </ComboBox>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="识别语言" VerticalAlignment="Center"/>
                    <ComboBox x:Name="VoiceLanguageCombo" Grid.Column="1">
                        <ComboBoxItem Content="自动" Tag="auto"/>
                        <ComboBoxItem Content="中文" Tag="zh-CN"/>
                        <ComboBoxItem Content="English" Tag="en-US"/>
                        <ComboBoxItem Content="粤语" Tag="yue"/>
                        <ComboBoxItem Content="日语" Tag="ja"/>
                        <ComboBoxItem Content="韩语" Tag="ko"/>
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="UseClipboardCheck" Content="使用剪贴板粘贴识别结果" Margin="0,0,0,6"/>
                <CheckBox x:Name="VoiceAutoStartCheck" Content="启动后自动启动语音服务（模型已安装时）" Margin="0,0,0,6"/>
                <CheckBox x:Name="ShowNotificationsCheck" Content="显示操作通知" Margin="0,0,0,6"/>
                <CheckBox x:Name="DebugModeCheck" Content="调试模式（输出诊断日志）" Margin="0,0,0,6"/>
                <CheckBox x:Name="SaveAudioCheck" Content="保存录音 WAV 到 Documents\FNSoftware\SigXor\Audio" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="长按阈值(秒)" VerticalAlignment="Center"/>
                    <TextBox x:Name="HoldThresholdBox" Grid.Column="1" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="输入延迟(秒)" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBox x:Name="TypingDelayBox" Grid.Column="3" VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="区域截屏" Padding="10" Margin="0,12,0,0">
            <StackPanel>
                <CheckBox x:Name="CaptureEnabledCheck" Content="启用区域截屏快捷键" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="截屏快捷键" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CaptureShortcutCombo" Grid.Column="1">
                        <ComboBoxItem Content="Alt + `" Tag="alt"/>
                        <ComboBoxItem Content="Ctrl + `" Tag="ctrl"/>
                        <ComboBoxItem Content="Ctrl + Shift + `" Tag="ctrl+shift"/>
                        <ComboBoxItem Content="Win + `" Tag="win"/>
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="AllowBareBacktickCheck" Content="允许无修饰 ` 触发（兼容笔记本 Fn + `）" Margin="0,0,0,6"/>
                <TextBlock x:Name="ShortcutHintText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="保存" Width="96" Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveClick"/>
            <Button Content="恢复默认" Margin="0,0,8,0" Click="OnResetClick"/>
            <TextBlock x:Name="Message" Margin="12,0,0,0" VerticalAlignment="Center"
                       Style="{DynamicResource PageHintStyle}"/>
        </StackPanel>
    </StackPanel>
</UserControl>

<Window x:Class="DevEnv.Host.SigXor.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="600" MaxHeight="460"
        WindowStartupLocation="CenterScreen"
        Deactivated="OnDeactivated"
        ContextMenuOpening="OnContextMenuOpening"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <!-- ListBoxItem 样式 -->
        <Style x:Key="LauncherItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                CornerRadius="4" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F0FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索框下方的常用工具入口：正方形磁贴 -->
        <Style x:Key="QuickEntryStyle" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条样式 -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="0"/>
                            <Track x:Name="PART_VerticalTrack" IsDirectionReversed="True"
                                   HorizontalAlignment="Right" Width="6"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <Track.Thumb>
                                    <Thumb x:Name="VerticalThumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" CornerRadius="3"
                                                        Background="{DynamicResource CardBorderBrush}" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#999"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8"
            AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 常用工具入口：剪贴板 / 翻译（不再占用全局快捷键） -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,8,12,0">
                <Button Style="{StaticResource QuickEntryStyle}" Click="OnOpenClipboardEntry"
                        ToolTip="熔岩剪贴板">
                    <StackPanel>
                        <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="剪贴板" FontSize="10.5" Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickEntryStyle}" Margin="0" Click="OnOpenTranslatorEntry"
                        ToolTip="熔岩翻译（打开时填充剪贴板文本）">
                    <StackPanel>
                        <TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="翻译" FontSize="10.5" Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 搜索框 -->
            <Border Grid.Row="0" Margin="12,12,12,0" CornerRadius="6"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceAltBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 搜索图标：30×30 正方形槽位，左右间距与右侧设置按钮对称 -->
                    <Grid Grid.Column="0" Width="30" Height="30" Margin="6,0,0,0"
                          VerticalAlignment="Center">
                        <TextBlock x:Name="SearchIcon" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="#888"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                             FontSize="16" MinHeight="36" Padding="8,0,8,0"
                             TextChanged="OnSearchTextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <!-- 设置入口 -->
                    <Button Grid.Column="2" x:Name="SettingsButton" Click="OnOpenSettings"
                            ToolTip="设置" Cursor="Hand" Focusable="False" Margin="0,0,6,0"
                            Width="30" Height="30" Padding="0" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#DCDCDC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="#888"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 分类标签 -->
            <TextBlock x:Name="CategoryLabel" Grid.Row="2" Margin="16,8,16,4"
                       FontSize="11" Foreground="#888"/>

            <!-- 结果列表 -->
            <ListBox x:Name="ResultsList" Grid.Row="3" Margin="8,0,8,0"
                     BorderThickness="0" Background="Transparent"
                     SelectionChanged="OnSelectionChanged"
                     PreviewMouseRightButtonDown="OnResultsRightButtonDown"
                     PreviewMouseLeftButtonUp="OnResultClick"
                     ItemContainerStyle="{StaticResource LauncherItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 图标：有真实图标用 Image，无则回退字体图标 -->
                            <Grid Grid.Column="0" Width="24" Height="24">
                                <TextBlock Text="{Binding FontIcon}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Image Source="{Binding Icon}" Width="24" Height="24"
                                       Visibility="{Binding HasIcon}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="#999"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding CategoryText}" FontSize="10.5"
                                       Foreground="#AAA" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态提示 -->
            <TextBlock x:Name="EmptyHint" Grid.Row="3" Text="输入关键词搜索应用、文件夹、网站、文件…"
                       FontSize="13" Foreground="#BBB" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsHitTestVisible="False"/>

            <!-- 拖拽叠加层 -->
            <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="5"
                    Background="{DynamicResource SelectedBrush}" CornerRadius="8" Opacity="0"
                    IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="释放鼠标，添加到快捷应用" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 底部提示 -->
            <Border Grid.Row="4" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,8,8"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="10.5" Foreground="#AAA" Margin="0,0,16,0">
                        <Run Text="↑↓"/><Run Text=" 选择"/>
                    </TextBlock>
                    <TextBlock FontSize="10.5" Foreground="#AAA" Margin="0,0,16,0">
                        <Run Text="单击 / Enter"/><Run Text=" 打开"/>
                    </TextBlock>
                    <TextBlock FontSize="10.5" Foreground="#AAA" Margin="0,0,16,0">
                        <Run Text="Esc"/><Run Text=" 关闭"/>
                    </TextBlock>
                    <TextBlock FontSize="10.5" Foreground="#AAA" Margin="0,0,16,0">
                        <Run Text="&gt;"/><Run Text=" 命令模式"/>
                    </TextBlock>
                    <TextBlock FontSize="10.5" Foreground="#AAA">
                        <Run Text="拖拽"/><Run Text=" 添加应用"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <!-- 右键菜单 -->
    <Window.ContextMenu>
        <ContextMenu x:Name="ResultsContextMenu">
            <MenuItem x:Name="RunMenuItem" Header="运行" Click="OnRunSelected"/>
            <MenuItem x:Name="RunAsAdminMenuItem" Header="以管理员身份运行" Click="OnRunAsAdminSelected"/>
            <MenuItem x:Name="RevealMenuItem" Header="打开所在位置" Click="OnRevealSelected"/>
            <Separator x:Name="PinSeparator"/>
            <MenuItem x:Name="PinMenuItem" Header="固定到快捷应用" Click="OnPinSelected"
                      Visibility="Collapsed"/>
            <MenuItem x:Name="RemovePinnedMenuItem" Header="取消固定" Click="OnRemovePinned"
                      Visibility="Collapsed"/>
        </ContextMenu>
    </Window.ContextMenu>
</Window>

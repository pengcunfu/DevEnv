<Window x:Class="DevEnv.Host.SigXor.Views.ShellPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevEnv.Host.SigXor.Views"
        xmlns:vm="clr-namespace:DevEnv.Host.SigXor.ViewModels"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource SurfaceBrush}"
        Topmost="True" ShowInTaskbar="True" Width="960" Height="680"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown"
        ResizeMode="NoResize"
        Title="{Binding Preview.Title, FallbackValue=SigXor 预览}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TextContentViewModel}">
            <views:TextView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HexContentViewModel}">
            <views:HexEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImageContentViewModel}">
            <views:ImageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InfoContentViewModel}">
            <views:InfoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OfficeContentViewModel}">
            <views:OfficeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MarkdownContentViewModel}">
            <views:MarkdownView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WebContentViewModel}">
            <views:HtmlView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioContentViewModel}">
            <views:AudioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VideoContentViewModel}">
            <views:VideoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PdfContentViewModel}">
            <views:PdfView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SvgContentViewModel}">
            <views:SvgView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArchiveContentViewModel}">
            <views:ArchiveView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CsvContentViewModel}">
            <views:CsvView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FontContentViewModel}">
            <views:FontView/>
        </DataTemplate>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 标题栏，支持拖拽 -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,8"
                    MouseLeftButtonDown="OnTitleBarDrag" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding Preview.Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Preview.Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="8,2"
                                Margin="0,0,4,0" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanGoPrevious}"
                                ToolTip="上一个预览（←）" Cursor="Hand"/>
                        <Button Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="8,2"
                                Margin="0,0,10,0" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}"
                                ToolTip="下一个预览（→）" Cursor="Hand"/>
                        <TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="KeyHintText" Text="Esc 关闭 · ←/→ 切换" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="MiniButton" Content="小窗" FontSize="11" Padding="8,2"
                                Margin="0,0,8,0" Click="OnToggleMini" ToolTip="小窗模式：固定到右上角并缩小窗口" Cursor="Hand"/>
                        <Button x:Name="PinButton" Content="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="8,2"
                                Margin="0,0,8,0" Click="OnTogglePin" ToolTip="切换置顶" Cursor="Hand"/>
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="8,2" Click="OnCloseClick" ToolTip="关闭预览"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding Preview.Content}" Focusable="False"/>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="DevEnv.Host.SigXor.Views.SigXorServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Top">
    <!-- 语音 / OCR 模型管理与后台服务；不自带 ScrollViewer，由设置对话框页签统一滚动。 -->
    <StackPanel HorizontalAlignment="Stretch">
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="语音输入与截屏服务" Style="{DynamicResource SectionTitleStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="StartVoiceServiceButton" Content="开始服务" Padding="16,4"
                            Click="OnStartVoiceServiceClick" Margin="0,0,8,0"/>
                    <Button x:Name="StopVoiceServiceButton" Content="停止服务" Padding="16,4"
                            Click="OnStopVoiceServiceClick" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="ServiceStatusText" Text="未启动" TextWrapping="Wrap" Margin="0,10,0,0"
                           Style="{DynamicResource PageHintStyle}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="可选组件（引擎，不含模型）" Style="{DynamicResource SectionTitleStyle}" />
                <TextBlock Text="基础包只带 Magick.NET；Office 结构化预览、OCR 与语音引擎按需下载。"
                           Style="{DynamicResource PageHintStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                <TextBlock x:Name="OfficeComponentStatusText" Text="未安装" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <ProgressBar x:Name="OfficeComponentProgressBar" Height="6" Margin="0,6,0,0"
                             Minimum="0" Maximum="100" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                    <Button Content="下载组件" Tag="office" Padding="12,3" Margin="0,0,8,0"
                            Click="OnInstallComponentClick"/>
                    <Button Content="删除组件" Tag="office" Padding="12,3" Margin="0,0,8,0"
                            Click="OnDeleteComponentClick"/>
                    <Button Content="打开组件目录" Tag="office" Padding="12,3"
                            Click="OnOpenComponentFolderClick"/>
                </StackPanel>

                <TextBlock x:Name="OcrEngineComponentStatusText" Text="未安装" TextWrapping="Wrap"/>
                <ProgressBar x:Name="OcrEngineComponentProgressBar" Height="6" Margin="0,6,0,0"
                             Minimum="0" Maximum="100" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                    <Button Content="下载组件" Tag="ocr" Padding="12,3" Margin="0,0,8,0"
                            Click="OnInstallComponentClick"/>
                    <Button Content="删除组件" Tag="ocr" Padding="12,3" Margin="0,0,8,0"
                            Click="OnDeleteComponentClick"/>
                    <Button Content="打开组件目录" Tag="ocr" Padding="12,3"
                            Click="OnOpenComponentFolderClick"/>
                </StackPanel>

                <TextBlock x:Name="VoiceEngineComponentStatusText" Text="未安装" TextWrapping="Wrap"/>
                <ProgressBar x:Name="VoiceEngineComponentProgressBar" Height="6" Margin="0,6,0,0"
                             Minimum="0" Maximum="100" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="下载组件" Tag="voice" Padding="12,3" Margin="0,0,8,0"
                            Click="OnInstallComponentClick"/>
                    <Button Content="删除组件" Tag="voice" Padding="12,3" Margin="0,0,8,0"
                            Click="OnDeleteComponentClick"/>
                    <Button Content="打开组件目录" Tag="voice" Padding="12,3"
                            Click="OnOpenComponentFolderClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="语音模型" Style="{DynamicResource SectionTitleStyle}" />
                <TextBlock x:Name="SpeechModelStatusText" Text="未下载" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <ProgressBar x:Name="SpeechDownloadProgressBar" Height="6" Margin="0,8,0,0"
                             Minimum="0" Maximum="100" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="DownloadSpeechModelButton" Content="下载模型"
                            Padding="12,3" Margin="0,0,8,0"
                            Click="OnDownloadSpeechModelClick"/>
                    <Button x:Name="DeleteSpeechModelButton" Content="删除模型"
                            Padding="12,3" Margin="0,0,8,0"
                            Click="OnDeleteSpeechModelClick"/>
                    <Button x:Name="OpenSpeechModelFolderButton" Content="打开模型目录"
                            Padding="12,3" Click="OnOpenSpeechModelFolderClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="OCR 模型" Style="{DynamicResource SectionTitleStyle}" />
                <TextBlock x:Name="OcrModelStatusText" Text="未下载" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <ProgressBar x:Name="OcrDownloadProgressBar" Height="6" Margin="0,8,0,0"
                             Minimum="0" Maximum="100" IsIndeterminate="True"
                             Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="DownloadOcrModelButton" Content="下载模型"
                            Padding="12,3" Margin="0,0,8,0"
                            Click="OnDownloadOcrModelClick"/>
                    <Button x:Name="DeleteOcrModelButton" Content="删除模型"
                            Padding="12,3" Margin="0,0,8,0"
                            Click="OnDeleteOcrModelClick"/>
                    <Button x:Name="OpenOcrModelFolderButton" Content="打开模型目录"
                            Padding="12,3" Click="OnOpenOcrModelFolderClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Button x:Name="MigrateLegacyModelsButton" Content="从旧版 SigXor 迁移模型（语音 + OCR）"
                Click="OnMigrateLegacyModelsClick" Padding="12,4" Margin="0,0,0,12"
                HorizontalAlignment="Left"/>
        <TextBlock x:Name="ServiceUsageHintText" Style="{DynamicResource PageHintStyle}" TextWrapping="Wrap"
                   Text="使用说明：语音快捷键短按开始/再按结束，或按住说话、松手结束；截屏快捷键拖动选择区域。"/>
    </StackPanel>
</UserControl>

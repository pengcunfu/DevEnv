<UserControl x:Class="DevEnv.Host.SigXor.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DevEnv.Host.SigXor.Converters">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="52"
                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,14,0,0" TextAlignment="Center"/>
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                   HorizontalAlignment="Stretch" Margin="0,8,0,0" TextAlignment="Left"
                   LineHeight="22"/>
        <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                Visibility="{Binding ActionLabel, Converter={StaticResource NullToVisibility}}"
                Padding="14,5" HorizontalAlignment="Center" Margin="0,16,0,0"/>
    </StackPanel>
</UserControl>

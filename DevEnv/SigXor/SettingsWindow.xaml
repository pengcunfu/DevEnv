<Window x:Class="DevEnv.Host.SigXor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="560" Height="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0">
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="AutoStartCheck" Content="开机自启动（随 Windows 启动，后台提供空格预览）" Margin="0,0,0,10"/>
                        <CheckBox x:Name="BackupCheck" Content="保存前自动备份到 Documents\FNSoftware\SigXor\Backups" Margin="0,0,0,10"/>
                        <CheckBox x:Name="CheckUpdatesCheck" Content="启动时自动检查更新（发现新版本时托盘提示）" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="文本字体" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <ComboBox x:Name="FontFamilyCombo" Grid.Column="1" Grid.Row="0"
                                      IsEditable="True" StaysOpenOnEdit="True"
                                      VerticalContentAlignment="Center" Margin="0,0,8,6"/>
                            <TextBlock Grid.Column="2" Text="文本字号" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox x:Name="TextFontSizeBox" Grid.Column="3" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="十六进制字号" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="HexFontSizeBox" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="每行字节数" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <TextBox x:Name="BytesPerRowBox" Grid.Column="3" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Button Content="恢复语音与截屏默认设置" Click="OnResetToolkitClick"
                                Padding="12,4" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="语音与截屏">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="语音输入" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="识别引擎" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VoiceEngineCombo" Grid.Column="1">
                                        <ComboBoxItem Content="SenseVoice（推荐）" Tag="sensevoice"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="语音快捷键" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VoiceShortcutCombo" Grid.Column="1">
                                        <ComboBoxItem Content="右 Alt（默认）" Tag="right-alt"/>
                                        <ComboBoxItem Content="左 Alt" Tag="left-alt"/>
                                        <ComboBoxItem Content="右 Ctrl" Tag="right-ctrl"/>
                                        <ComboBoxItem Content="左 Ctrl" Tag="left-ctrl"/>
                                        <ComboBoxItem Content="Caps Lock" Tag="caps-lock"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="识别语言" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VoiceLanguageCombo" Grid.Column="1">
                                        <ComboBoxItem Content="自动" Tag="auto"/>
                                        <ComboBoxItem Content="中文" Tag="zh-CN"/>
                                        <ComboBoxItem Content="English" Tag="en-US"/>
                                        <ComboBoxItem Content="粤语" Tag="yue"/>
                                        <ComboBoxItem Content="日语" Tag="ja"/>
                                        <ComboBoxItem Content="韩语" Tag="ko"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="UseClipboardCheck" Content="使用剪贴板粘贴识别结果" Margin="0,0,0,6"/>
                                <CheckBox x:Name="VoiceAutoStartCheck" Content="启动 SigXor 后自动启动语音服务（模型已安装时）" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ShowNotificationsCheck" Content="显示操作通知" Margin="0,0,0,6"/>
                                <CheckBox x:Name="DebugModeCheck" Content="调试模式（输出诊断日志）" Margin="0,0,0,6"/>
                                <CheckBox x:Name="SaveAudioCheck" Content="保存录音 WAV 到 Documents\FNSoftware\SigXor\Audio" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="长按阈值(秒)" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HoldThresholdBox" Grid.Column="1" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="输入延迟(秒)" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                    <TextBox x:Name="TypingDelayBox" Grid.Column="3" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="区域截屏" Padding="10" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox x:Name="CaptureEnabledCheck" Content="启用区域截屏快捷键" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="截屏快捷键" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CaptureShortcutCombo" Grid.Column="1">
                                        <ComboBoxItem Content="Alt + `" Tag="alt"/>
                                        <ComboBoxItem Content="Ctrl + `" Tag="ctrl"/>
                                        <ComboBoxItem Content="Ctrl + Shift + `" Tag="ctrl+shift"/>
                                        <ComboBoxItem Content="Win + `" Tag="win"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="AllowBareBacktickCheck" Content="允许无修饰 ` 触发（兼容笔记本 Fn + `）" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ShortcutHintText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="启动与托盘" Padding="10" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox x:Name="MinimizeToTrayCheck" Content="关闭设置窗口时隐藏到托盘" Margin="0,0,0,6"/>
                                <CheckBox x:Name="SilentStartCheck" Content="开机自启动时静默运行（不打开任何窗口）" Margin="0,0,0,6"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="服务与模型">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="语音输入与截屏服务" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="StartVoiceServiceButton" Content="开始服务" Padding="16,4"
                                    Click="OnStartVoiceServiceClick" Margin="0,0,8,0"/>
                            <Button x:Name="StopVoiceServiceButton" Content="停止服务" Padding="16,4"
                                    Click="OnStopVoiceServiceClick" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock x:Name="ServiceStatusText" Text="未启动" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <GroupBox Header="语音模型" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="SpeechModelStatusText" Text="未下载" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="SpeechDownloadProgressBar" Height="6" Margin="0,8,0,0"
                                             Minimum="0" Maximum="100" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="DownloadSpeechModelButton" Content="下载模型"
                                            Padding="12,3" Margin="0,0,8,0"
                                            Click="OnDownloadSpeechModelClick"/>
                                    <Button x:Name="DeleteSpeechModelButton" Content="删除模型"
                                            Padding="12,3" Margin="0,0,8,0"
                                            Click="OnDeleteSpeechModelClick"/>
                                    <Button x:Name="OpenSpeechModelFolderButton" Content="打开模型目录"
                                            Padding="12,3" Click="OnOpenSpeechModelFolderClick"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="OCR 模型" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="OcrModelStatusText" Text="未下载" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="OcrDownloadProgressBar" Height="6" Margin="0,8,0,0"
                                             Minimum="0" Maximum="100" IsIndeterminate="True"
                                             Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="DownloadOcrModelButton" Content="下载模型"
                                            Padding="12,3" Margin="0,0,8,0"
                                            Click="OnDownloadOcrModelClick"/>
                                    <Button x:Name="DeleteOcrModelButton" Content="删除模型"
                                            Padding="12,3" Margin="0,0,8,0"
                                            Click="OnDeleteOcrModelClick"/>
                                    <Button x:Name="OpenOcrModelFolderButton" Content="打开模型目录"
                                            Padding="12,3" Click="OnOpenOcrModelFolderClick"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <Button x:Name="MigrateLegacyModelsButton" Content="从旧版 SigXor 迁移模型（语音 + OCR）"
                                Click="OnMigrateLegacyModelsClick" Padding="12,4" Margin="0,0,0,10"
                                HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ServiceUsageHintText" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                                   Text="使用说明：语音快捷键短按开始/再按结束，或按住说话、松手结束；截屏快捷键拖动选择区域。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" IsDefault="True" Click="OnSaveClick" Padding="18,5" Margin="0,0,8,0"/>
            <Button Content="取消" IsCancel="True" Click="OnCancelClick" Padding="18,5"/>
        </StackPanel>
    </Grid>
</Window>

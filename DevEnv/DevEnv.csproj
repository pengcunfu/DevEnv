<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF 承载全部界面；WinForms 仅剩托盘图标（System.Windows.Forms.NotifyIcon）
         与三个常用文件对话框，Application / Clipboard / MessageBox / Timer 一律显式别名。 -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DevEnv.Host</RootNamespace>
    <AssemblyName>DevEnv</AssemblyName>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>FireNeb DevEnv</Product>
    <Company>FNSoftware</Company>
    <Copyright>© 2026 FireNeb. All rights reserved.</Copyright>
    <Authors>FireNeb</Authors>
    <Description>Windows 上的开发环境管理工具：多语言运行时切换、系统工具快捷入口、本地/Web 应用与服务集中管理。</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/pengcunfu/DevEnv</RepositoryUrl>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 自定义 Main：先分发 updater 助手模式，再启动 WPF App（见 Program.cs）。 -->
    <StartupObject>DevEnv.Host.Program</StartupObject>
    <!-- WebView2 package also ships Wpf.dll which pulls WindowsBase 5.x; MSB3277 is the known version-merge warning. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 仅熔岩翻译窗使用（DOM 填充需要真实浏览器），主界面已无 WebView2 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <!-- SigXor 模块（文件快速预览 / 语音输入 / 截图 OCR 取色） -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.2" />
    <PackageReference Include="RapidOcrNet" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms 只为托盘与文件对话框而开：去掉它的隐式 using，
         Application / Clipboard / MessageBox / UserControl 等同名类型才不会和 WPF 撞车。
         需要时显式写 `using Forms = System.Windows.Forms;`。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevEnv.Core\DevEnv.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时按 exe 旁的 Resources/ 读取，必须排除在单文件 bundle 之外 -->
    <Content Include="Resources\icon.ico" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Resources\icon.png" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Resources\icons\win\*.png" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Apache-2.0 §4(a)(d)：安装包内必须随附许可证与归属声明 -->
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- SigXor 模块资源 -->
  <ItemGroup>
    <!-- 语法高亮定义文件（AvalonEdit 的 .xshd），运行时从程序集资源读取 -->
    <EmbeddedResource Include="SigXor\SyntaxHighlighting\*.xshd" />
    <!-- Office 网页预览的离线渲染资产（HTML/JS/CSS 及第三方库）。
         嵌入 exe（而非复制到输出目录），运行时由 WebAssets 解压到 LOCALAPPDATA，
         因为 WebView2 的虚拟主机映射只接受真实目录。 -->
    <EmbeddedResource Include="SigXor\webassets\**\*"
                      LogicalName="webassets/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- 关于窗口用的联系二维码 -->
    <Resource Include="SigXor\Assets\feishu.png" Link="Assets\feishu.png" />
  </ItemGroup>

  <!--
    可选组件瘦身：Office 结构化预览、OCR、语音的运行时资产不在基础包里，
    由 Release 的组件 zip 按需安装到 %LOCALAPPDATA%\DevEnv\Components。
    源码仍保留 PackageReference 以便编译；这里在生成 deps.json 与单文件 bundle
    之前把它们从发布列表移除。组件打包时用 -p:DevEnvIncludeOptionalComponents=true
    关闭本 target，得到完整发布目录。
  -->
  <Target Name="RemoveOptionalComponentsFromPublish"
          BeforeTargets="GeneratePublishDependencyFile;_ComputeFilesToBundle;_CopyResolvedFilesToPublishPreserveNewest"
          Condition="'$(DevEnvIncludeOptionalComponents)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'DocumentFormat.OpenXml.dll'
                  or '%(Filename)%(Extension)' == 'DocumentFormat.OpenXml.Framework.dll'
                  or '%(Filename)%(Extension)' == 'RapidOcrNet.dll'
                  or '%(Filename)%(Extension)' == 'SkiaSharp.dll'
                  or '%(Filename)%(Extension)' == 'libSkiaSharp.dll'
                  or '%(Filename)%(Extension)' == 'Clipper2Lib.dll'
                  or '%(Filename)%(Extension)' == 'System.Numerics.Tensors.dll'
                  or '%(Filename)%(Extension)' == 'Microsoft.ML.OnnxRuntime.dll'
                  or '%(Filename)%(Extension)' == 'onnxruntime.dll'
                  or '%(Filename)%(Extension)' == 'onnxruntime_providers_shared.dll'
                  or '%(Filename)%(Extension)' == 'onnxruntime.lib'
                  or '%(Filename)%(Extension)' == 'onnxruntime_providers_shared.lib'
                  or '%(Filename)%(Extension)' == 'sherpa-onnx.dll'
                  or '%(Filename)%(Extension)' == 'sherpa-onnx-c-api.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('models'))" />
    </ItemGroup>
  </Target>

</Project>
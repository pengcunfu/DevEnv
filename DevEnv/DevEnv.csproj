<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevEnv</RootNamespace>
    <Version>1.0.0</Version>
    <Product>熔岩环境管理工具</Product>
    <AssemblyTitle>熔岩环境管理工具</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- ImageSharp 4.x 需商业许可；改用 Apache-2.0 的 Magick.NET -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Avalonia UI 已退役：只保留 Services / Models / 引导逻辑供 DevBox.Api 使用 -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="App.axaml.cs" />
    <Compile Remove="Views\**" />
    <Compile Remove="ViewModels\**" />
    <Compile Remove="UI\**" />
    <Compile Remove="Converters\**" />
    <Compile Remove="Commands\**" />
    <Compile Remove="Services\UiIcons.cs" />
    <EmbeddedResource Remove="Views\**" />
    <None Remove="App.axaml" />
    <None Remove="Views\**\*.axaml" />
    <None Remove="Views\**\*.xaml" />
  </ItemGroup>

</Project>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 启动器与四个分类窗口共用的控件样式。颜色一律用启动器调色板（Launcher*）的 DynamicResource。
         图标卡片的事件（单击 / 拖拽 / 右键）由各窗口在代码里挂到 ItemsControl 上，
         所以这里的模板不带事件处理器，可以放在独立 ResourceDictionary 里复用。 -->

    <!-- 搜索框：文字、光标与占位提示跟随启动器配色 -->
    <Style x:Key="LaunchpadSearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource LauncherAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource LauncherAccentSelectionBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Focusable="False" />
                        <TextBlock x:Name="Placeholder"
                                   Text="搜索…"
                                   FontSize="13"
                                   Foreground="{DynamicResource LauncherTextMutedBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标卡片：悬停轻微抬起，按下回弹；贴近 Windows 11 开始菜单「已固定」 -->
    <Style x:Key="LaunchpadTile" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Tile"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="6,8,6,4"
                            ClipToBounds="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherTilePressedBrush}" />
                        </Trigger>
                        <!-- 框选：同款抬升底，不要蓝色描边 -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Panel.ZIndex" Value="20" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 左侧页签（纵向条目）；启动器只剩两个工具页 -->
    <Style x:Key="LaunchpadTabItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Pill"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,9"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource LauncherPillSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <!-- 选中时轻弹一下，给左右键 / 滚轮换页一个落点反馈 -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PillScale"
                                                                       Storyboard.TargetProperty="ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="1.09" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PillScale"
                                                                       Storyboard.TargetProperty="ScaleY">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="1.09" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PillScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PillScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标卡片：贴近开始菜单「已固定」，大图标 + 两行标题 -->
    <DataTemplate x:Key="LauncherEntryTemplate">
        <Button Style="{StaticResource LaunchpadTile}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Stretch"
                ToolTip="{Binding TargetPath}">
            <Button.ContextMenu>
                <!-- 占位菜单：让 ContextMenuOpening 能冒泡到外层，实际菜单由窗口代码动态构建 -->
                <ContextMenu />
            </Button.ContextMenu>
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <!-- 普通应用：图标直接铺开，不套灰底板；文件夹才用圆角底板 -->
                <Grid Width="48"
                      Height="48"
                      HorizontalAlignment="Center">
                    <Border Background="{DynamicResource LauncherIconBackdropBrush}"
                            CornerRadius="8"
                            Visibility="{Binding IsGroup, Converter={StaticResource TrueToVisibility}}" />
                    <Grid Visibility="{Binding IsGroup, Converter={StaticResource FalseToVisibility}}">
                        <Image Width="48"
                               Height="48"
                               Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasIcon, Converter={StaticResource TrueToVisibility}}" />
                        <Border Width="48"
                                Height="48"
                                CornerRadius="10"
                                Background="{Binding IconBrush}"
                                Visibility="{Binding HasToolBadge, Converter={StaticResource TrueToVisibility}}">
                            <TextBlock Text="{Binding IconGlyph}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{DynamicResource LauncherBadgeGlyphBrush}" />
                        </Border>
                        <TextBlock Text="{Binding KindGlyph}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="{DynamicResource LauncherTextPrimaryBrush}"
                                   Visibility="{Binding ShowsKindGlyph, Converter={StaticResource TrueToVisibility}}" />
                    </Grid>
                    <ItemsControl Margin="4"
                                  ItemsSource="{Binding GroupPreview}"
                                  Visibility="{Binding IsGroup, Converter={StaticResource TrueToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="18" Height="18" Margin="1">
                                    <Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasIcon, Converter={StaticResource TrueToVisibility}}" />
                                    <Border CornerRadius="4"
                                            Background="{Binding IconBrush}"
                                            Visibility="{Binding HasToolBadge, Converter={StaticResource TrueToVisibility}}">
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource LauncherBadgeGlyphBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding KindGlyph}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{DynamicResource LauncherTextPrimaryBrush}"
                                               Visibility="{Binding ShowsKindGlyph, Converter={StaticResource TrueToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <!-- 开始菜单同款：最多两行换行，超出第二行再省略 -->
                <TextBlock Margin="2,6,2,0"
                           HorizontalAlignment="Stretch"
                           Height="32"
                           Text="{Binding Name}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           FontSize="12"
                           LineHeight="16"
                           LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource LauncherTextPrimaryBrush}" />
                <!-- 仅搜索态显示类型；由视图模型按 IsSearching 设置 ShowsKindText -->
                <TextBlock Margin="2,2,2,0"
                           HorizontalAlignment="Stretch"
                           Text="{Binding KindText}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="10"
                           Foreground="{DynamicResource LauncherTextMutedBrush}"
                           Visibility="{Binding ShowsKindText, Converter={StaticResource TrueToVisibility}}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- 启动器菜单栏：系统工具按分类放进菜单。模板与全局 Menu 一致，
         但颜色换成启动器调色板，避免系统浅色 / DevEnv 深色时文字与底色打架。 -->
    <Style x:Key="LauncherMenuStyle" TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="2,0" />
        <!-- Alt 在本程序里是全局键，不能把菜单当主菜单抢焦点 -->
        <Setter Property="IsMainMenu" Value="False" />
    </Style>

    <!-- 菜单栏顶层项：向下弹出，不画箭头 -->
    <Style x:Key="LauncherTopLevelMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                            <Popup x:Name="PART_Popup"
                                   Grid.Column="1"
                                   Placement="Bottom"
                                   VerticalOffset="-1"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource LauncherCardBrush}"
                                        BorderBrush="{DynamicResource LauncherBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="480">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LauncherPillSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LauncherPillSelectedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LauncherAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 子菜单项：分类子菜单与具体工具叶子项共用 -->
    <Style x:Key="LauncherMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                            <Path x:Name="Arrow"
                                  Grid.Column="1"
                                  Margin="10,0,2,0"
                                  VerticalAlignment="Center"
                                  Data="M 0,0 L 4,4 L 0,8"
                                  Stroke="{DynamicResource LauncherTextSecondaryBrush}"
                                  StrokeThickness="1.3"
                                  Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup"
                                   Grid.Column="1"
                                   Placement="Right"
                                   VerticalOffset="-4"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource LauncherCardBrush}"
                                        BorderBrush="{DynamicResource LauncherBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="480">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LauncherPillSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LauncherPillSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 右下角圆形「＋」 -->
    <Style x:Key="LaunchpadCircleButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource LauncherCircleBrush}"
                            BorderBrush="{DynamicResource LauncherBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="23">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LauncherCircleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LauncherCirclePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 启动器图标网格样式。颜色一律用启动器调色板（Launcher*）的 DynamicResource。
         卡片事件（单击 / 右键）由 ShortcutsWindow 在代码里挂到 ItemsControl 上，
         所以这里的模板不带事件处理器，可以放在独立 ResourceDictionary 里。 -->

    <!-- 图标卡片：悬停轻微抬起，按下回弹；贴近 Windows 11 开始菜单「已固定」 -->
    <Style x:Key="LaunchpadTile" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Tile"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="6,8,6,4"
                            ClipToBounds="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherTilePressedBrush}" />
                        </Trigger>
                        <!-- 框选：同款抬升底，不要蓝色描边 -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Panel.ZIndex" Value="20" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 图标卡片：贴近开始菜单「已固定」，大图标 + 两行标题 -->
    <DataTemplate x:Key="LauncherEntryTemplate">
        <Button Style="{StaticResource LaunchpadTile}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Stretch"
                ToolTip="{Binding TargetPath}">
            <Button.ContextMenu>
                <!-- 占位菜单：让 ContextMenuOpening 能冒泡到外层，实际菜单由窗口代码动态构建 -->
                <ContextMenu />
            </Button.ContextMenu>
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <!-- 普通应用：图标直接铺开，不套灰底板；文件夹才用圆角底板 -->
                <Grid Width="48"
                      Height="48"
                      HorizontalAlignment="Center">
                    <Border Background="{DynamicResource LauncherIconBackdropBrush}"
                            CornerRadius="8"
                            Visibility="{Binding IsGroup, Converter={StaticResource TrueToVisibility}}" />
                    <Grid Visibility="{Binding IsGroup, Converter={StaticResource FalseToVisibility}}">
                        <Image Width="48"
                               Height="48"
                               Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasIcon, Converter={StaticResource TrueToVisibility}}" />
                        <Border Width="48"
                                Height="48"
                                CornerRadius="10"
                                Background="{Binding IconBrush}"
                                Visibility="{Binding HasToolBadge, Converter={StaticResource TrueToVisibility}}">
                            <TextBlock Text="{Binding IconGlyph}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{DynamicResource LauncherBadgeGlyphBrush}" />
                        </Border>
                        <TextBlock Text="{Binding KindGlyph}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="{DynamicResource LauncherTextPrimaryBrush}"
                                   Visibility="{Binding ShowsKindGlyph, Converter={StaticResource TrueToVisibility}}" />
                    </Grid>
                    <ItemsControl Margin="4"
                                  ItemsSource="{Binding GroupPreview}"
                                  Visibility="{Binding IsGroup, Converter={StaticResource TrueToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="18" Height="18" Margin="1">
                                    <Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasIcon, Converter={StaticResource TrueToVisibility}}" />
                                    <Border CornerRadius="4"
                                            Background="{Binding IconBrush}"
                                            Visibility="{Binding HasToolBadge, Converter={StaticResource TrueToVisibility}}">
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource LauncherBadgeGlyphBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding KindGlyph}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{DynamicResource LauncherTextPrimaryBrush}"
                                               Visibility="{Binding ShowsKindGlyph, Converter={StaticResource TrueToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <!-- 开始菜单同款：最多两行换行，超出第二行再省略 -->
                <TextBlock Margin="2,6,2,0"
                           HorizontalAlignment="Stretch"
                           Height="32"
                           Text="{Binding Name}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           FontSize="12"
                           LineHeight="16"
                           LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource LauncherTextPrimaryBrush}" />
                <!-- 仅搜索态显示类型；由视图模型按 IsSearching 设置 ShowsKindText -->
                <TextBlock Margin="2,2,2,0"
                           HorizontalAlignment="Stretch"
                           Text="{Binding KindText}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="10"
                           Foreground="{DynamicResource LauncherTextMutedBrush}"
                           Visibility="{Binding ShowsKindText, Converter={StaticResource TrueToVisibility}}" />
            </StackPanel>
        </Button>
    </DataTemplate>

</ResourceDictionary>

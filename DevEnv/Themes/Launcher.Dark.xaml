<!--
    全局启动器的深色方案：与 Windows 11 开始菜单（深色）保持同等颜色。
    key 与 Launcher.Light.xaml 完全一致，ShortcutsWindow 整块替换即可切换。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 玻璃底色：接近开始菜单深色的 #202020 -->
    <LinearGradientBrush x:Key="LauncherGlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F2202020" />
        <GradientStop Offset="0.55" Color="#ED1C1C1C" />
        <GradientStop Offset="1" Color="#F01A1A1A" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LauncherHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#26FFFFFF" />
        <GradientStop Offset="0.35" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LauncherSurfaceBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="LauncherSurfaceHoverBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="LauncherSurfacePressedBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="LauncherIconBackdropBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="LauncherPillSelectedBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="LauncherBorderBrush" Color="#26FFFFFF" />

    <SolidColorBrush x:Key="LauncherTextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LauncherTextSecondaryBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="LauncherTextMutedBrush" Color="#99FFFFFF" />

    <SolidColorBrush x:Key="LauncherAccentBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="LauncherAccentSelectionBrush" Color="#3360CDFF" />
    <SolidColorBrush x:Key="LauncherAccentFaintBrush" Color="#2660CDFF" />

    <SolidColorBrush x:Key="LauncherTileHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="LauncherTilePressedBrush" Color="#33FFFFFF" />

    <SolidColorBrush x:Key="LauncherCircleBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="LauncherCircleHoverBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="LauncherCirclePressedBrush" Color="#66FFFFFF" />

    <SolidColorBrush x:Key="LauncherCardBrush" Color="#F22B2B2B" />
    <SolidColorBrush x:Key="LauncherEdgeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="LauncherDangerBrush" Color="#FFFF99A4" />

</ResourceDictionary>

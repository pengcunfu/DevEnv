<!--
    启动器的深色方案：与 Windows 11 开始菜单（深色）保持同等颜色。
    key 与 Launcher.Light.xaml 完全一致，ShortcutsWindow 整块替换即可切换。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 窗口背景：接近开始菜单深色的 #202020，标准窗口不透明，不再依赖桌面磨砂 -->
    <LinearGradientBrush x:Key="LauncherBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF202020" />
        <GradientStop Offset="0.55" Color="#FF1C1C1C" />
        <GradientStop Offset="1" Color="#FF1A1A1A" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LauncherSurfaceBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="LauncherSurfaceHoverBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="LauncherSurfacePressedBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="LauncherIconBackdropBrush" Color="#28FFFFFF" />
    <!-- 侧栏选中底：比未选中透明底更亮一档 -->
    <SolidColorBrush x:Key="LauncherPillSelectedBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="LauncherBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="LauncherScrimBrush" Color="#99000000" />

    <SolidColorBrush x:Key="LauncherTextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LauncherTextSecondaryBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="LauncherTextMutedBrush" Color="#99FFFFFF" />

    <SolidColorBrush x:Key="LauncherAccentBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="LauncherAccentSelectionBrush" Color="#3360CDFF" />
    <SolidColorBrush x:Key="LauncherAccentFaintBrush" Color="#2660CDFF" />

    <!-- 磁贴悬停 / 按下：开始菜单深色抬升面 -->
    <SolidColorBrush x:Key="LauncherTileHoverBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="LauncherTilePressedBrush" Color="#3DFFFFFF" />

    <SolidColorBrush x:Key="LauncherCircleBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="LauncherCircleHoverBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="LauncherCirclePressedBrush" Color="#66FFFFFF" />

    <!-- 文件夹浮层：半透明深灰，避免与底层网格反差过硬 -->
    <SolidColorBrush x:Key="LauncherCardBrush" Color="#E6252525" />
    <SolidColorBrush x:Key="LauncherDangerBrush" Color="#FFFF99A4" />

    <!-- 内置工具彩色图标里的白色字形：两套主题都保持白色，保证与品牌底色对比 -->
    <SolidColorBrush x:Key="LauncherBadgeGlyphBrush" Color="#FFFFFFFF" />

</ResourceDictionary>

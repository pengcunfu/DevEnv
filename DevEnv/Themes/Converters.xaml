<!-- 全局转换器：各视图直接 StaticResource 引用，不必重复声明 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DevEnv.Host.Converters">

    <conv:FilePathToImageConverter x:Key="PathToImage" />
    <conv:CountToVisibilityConverter x:Key="HasItems" />
    <conv:CountToVisibilityConverter x:Key="NoItems" Invert="True" />
    <conv:StringToVisibilityConverter x:Key="NonEmptyString" />
    <conv:StringToVisibilityConverter x:Key="EmptyString" Invert="True" />
    <conv:BoolToVisibilityConverter x:Key="TrueToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="FalseToVisibility" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:StringEqualsConverter x:Key="StringEquals" />
    <conv:IntEqualsConverter x:Key="IntEquals" />
    <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />

</ResourceDictionary>
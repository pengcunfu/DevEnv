<!--
    全局启动器的浅色方案：与 Windows 11 开始菜单（浅色）保持同等颜色。
    只被 ShortcutsWindow 的本地资源字典引用，不参与 App 主题切换；
    ShortcutsWindow 按系统的「应用模式」（AppsUseLightTheme）在浅 / 深两套之间切换。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 窗口背景：接近开始菜单的 #F3F3F3，标准窗口不透明，不再依赖桌面磨砂 -->
    <LinearGradientBrush x:Key="LauncherBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFF3F3F3" />
        <GradientStop Offset="0.55" Color="#FFF2F2F2" />
        <GradientStop Offset="1" Color="#FFEFEFEF" />
    </LinearGradientBrush>

    <!-- 搜索框 / 工具文件夹：半透明雾面灰，避免在浅底上落成一块死白 -->
    <SolidColorBrush x:Key="LauncherSurfaceBrush" Color="#B3F5F5F5" />
    <SolidColorBrush x:Key="LauncherSurfaceHoverBrush" Color="#CCF8F8F8" />
    <SolidColorBrush x:Key="LauncherSurfacePressedBrush" Color="#D9EDEDED" />
    <SolidColorBrush x:Key="LauncherIconBackdropBrush" Color="#99F0F0F0" />
    <SolidColorBrush x:Key="LauncherPillSelectedBrush" Color="#BFECECEC" />
    <SolidColorBrush x:Key="LauncherBorderBrush" Color="#1F000000" />
    <!-- 文件夹浮层遮罩 -->
    <SolidColorBrush x:Key="LauncherScrimBrush" Color="#80000000" />

    <SolidColorBrush x:Key="LauncherTextPrimaryBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="LauncherTextSecondaryBrush" Color="#CC1A1A1A" />
    <SolidColorBrush x:Key="LauncherTextMutedBrush" Color="#993C3C43" />

    <SolidColorBrush x:Key="LauncherAccentBrush" Color="#FF0078D4" />
    <SolidColorBrush x:Key="LauncherAccentSelectionBrush" Color="#330078D4" />
    <SolidColorBrush x:Key="LauncherAccentFaintBrush" Color="#260078D4" />

    <SolidColorBrush x:Key="LauncherTileHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="LauncherTilePressedBrush" Color="#1F000000" />

    <SolidColorBrush x:Key="LauncherCircleBrush" Color="#99F0F0F0" />
    <SolidColorBrush x:Key="LauncherCircleHoverBrush" Color="#BFF5F5F5" />
    <SolidColorBrush x:Key="LauncherCirclePressedBrush" Color="#D9E8E8E8" />

    <!-- 文件夹浮层卡片：略抬升的灰面，与窗口底 #F3F3F3 同色系 -->
    <SolidColorBrush x:Key="LauncherCardBrush" Color="#EBF0F0F0" />
    <SolidColorBrush x:Key="LauncherDangerBrush" Color="#FFC42B1C" />

    <!-- 内置工具彩色图标里的白色字形：两套主题都保持白色，保证与品牌底色对比 -->
    <SolidColorBrush x:Key="LauncherBadgeGlyphBrush" Color="#FFFFFFFF" />

</ResourceDictionary>

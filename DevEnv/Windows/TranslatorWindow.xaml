<Window x:Class="DevEnv.Host.Windows.TranslatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="熔岩翻译"
        Width="960"
        Height="680"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SiteCombo" Grid.Column="0" Width="150" Margin="0,0,8,0"
                          Tag="选择翻译站点"
                          DisplayMemberPath="Name" SelectionChanged="OnSiteChanged" />
                <Button x:Name="FillButton" Grid.Column="1" Content="填充剪贴板"
                        Click="OnFillClick" Padding="14,5" />
                <TextBlock x:Name="StatusText" Grid.Column="2" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{DynamicResource PageHintStyle}" />
            </Grid>
        </Border>

        <!-- WpfWebView2 在代码里 new：它的程序集引用的是 WindowsBase 5.x，
             XAML 标记编译器解析不到该类型（C# 侧已用 NoWarn MSB3277 处理）。 -->
        <Grid x:Name="BrowserHost">
            <TextBlock x:Name="Placeholder"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="正在初始化翻译站…"
                       Style="{DynamicResource PageHintStyle}" />
        </Grid>
    </DockPanel>
</Window>
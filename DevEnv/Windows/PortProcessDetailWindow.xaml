<Window x:Class="DevEnv.Host.Windows.PortProcessDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="进程详情"
        Width="560"
        MaxHeight="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ChromeBrush}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Width="84" Height="32" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" TextWrapping="Wrap" />
                <TextBlock x:Name="SubtitleText" Style="{DynamicResource MutedTextStyle}" Margin="0,2,0,0" />

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource DangerBrush}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <StackPanel x:Name="DetailPanel">
                    <Border BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,12,0,10" />

                    <TextBlock Text="基本信息" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="PID" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Pid}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Text="名称" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Name}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Text="路径" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExePath}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="3" Text="启动时间" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StartTime}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="4" Text="响应" Style="{DynamicResource MutedTextStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Responding}" />
                    </Grid>

                    <TextBlock Text="连接信息" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="协议" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Protocol}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Text="本地" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocalEndpoint}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Text="远程" Style="{DynamicResource MutedTextStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RemoteEndpoint}" />
                    </Grid>

                    <TextBlock Text="CPU / 内存" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="CPU" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuUsage}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Text="工作集" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WorkingSet}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Text="虚拟内存" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VirtualMemory}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="3" Text="峰值工作集" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PeakWorkingSet}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="4" Text="内存占比" Style="{DynamicResource MutedTextStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MemoryPercent}" />
                    </Grid>

                    <TextBlock Text="其他" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="线程 / 句柄" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                            <Run Text="{Binding ThreadCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding HandleCount, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Row="1" Text="命令行" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommandLine}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Text="工作目录" Style="{DynamicResource MutedTextStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WorkingDirectory}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

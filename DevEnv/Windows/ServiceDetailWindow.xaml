<Window x:Class="DevEnv.Host.Windows.ServiceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ServicesViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="服务详情"
        Width="640"
        MinWidth="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ChromeBrush}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="打开目录"
                    Width="88"
                    Height="32"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding CanOpenFolderSelected}"
                    Command="{Binding OpenFolderCommand}" />
            <Button Content="关闭"
                    Width="84"
                    Height="32"
                    IsCancel="True"
                    IsDefault="True"
                    Click="OnCloseClick" />
        </StackPanel>

        <StackPanel>
            <!-- 标题 -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Selected.StatusText}"
                           Margin="12,2,0,0"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected.IsRunning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Selected.IsPaused}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel>
                    <TextBlock Text="{Binding Selected.DisplayName}" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Selected.ServiceName}"
                               Style="{DynamicResource MutedTextStyle}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock Margin="0,10,0,0"
                       Text="{Binding Selected.DescriptionText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <Border BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,14,0,12" />

            <!-- 字段 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="启动类型"
                           Style="{DynamicResource MutedTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,10" />
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <ComboBox Width="160"
                              Height="28"
                              ItemsSource="{Binding StartupOptions}"
                              DisplayMemberPath="Title"
                              SelectedItem="{Binding SelectedStartupOption, Mode=TwoWay}" />
                    <Button Content="应用"
                            Margin="8,0,0,0"
                            Padding="12,4"
                            IsEnabled="{Binding CanApplyStartupType}"
                            Command="{Binding ApplyStartupTypeCommand}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="登录身份"
                           Style="{DynamicResource MutedTextStyle}"
                           Margin="0,0,0,10" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding Selected.LogOnAsText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <TextBlock Grid.Row="2" Text="服务类型"
                           Style="{DynamicResource MutedTextStyle}"
                           Margin="0,0,0,10" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding Selected.ServiceTypeText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <TextBlock Grid.Row="3" Text="可执行文件"
                           Style="{DynamicResource MutedTextStyle}"
                           Margin="0,0,0,10" />
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding Selected.ImagePathText}"
                           Style="{DynamicResource MonoTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <TextBlock Grid.Row="4" Text="依赖服务"
                           Style="{DynamicResource MutedTextStyle}"
                           Margin="0,0,0,10" />
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding Selected.DependenciesDisplayText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <TextBlock Grid.Row="5" Text="被依赖"
                           Style="{DynamicResource MutedTextStyle}" />
                <TextBlock Grid.Row="5" Grid.Column="1"
                           Text="{Binding Selected.DependentsDisplayText}"
                           TextWrapping="Wrap" />
            </Grid>

            <TextBlock Margin="0,12,0,0"
                       Text="{Binding Message}"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}" />
        </StackPanel>
    </DockPanel>
</Window>

<Window x:Class="DevEnv.Host.Windows.DevServiceLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行日志"
        Width="760"
        Height="520"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStyle}" Margin="12,12,12,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="刷新" Style="{StaticResource ToolbarButtonStyle}" Click="OnRefreshClick" />
                <Button Content="清空" Style="{StaticResource ToolbarButtonStyle}" Click="OnClearClick" />
                <Button Content="打开日志目录" Style="{StaticResource ToolbarButtonStyle}" Click="OnOpenDirectoryClick" />
                <CheckBox x:Name="FollowCheckBox" Content="跟随最新" IsChecked="True"
                          Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TextBox x:Name="LogBox"
                 Margin="12"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 HorizontalContentAlignment="Left"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas"
                 FontSize="12"
                 Padding="8" />
    </DockPanel>
</Window>

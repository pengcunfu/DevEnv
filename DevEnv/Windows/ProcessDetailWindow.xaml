<Window x:Class="DevEnv.Host.Windows.ProcessDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="进程详情"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ChromeBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Style="{DynamicResource MutedTextStyle}" Margin="0,2,0,0">
            <Run Text="PID " /><Run Text="{Binding ProcessId, Mode=OneWay}" />
            <Run Text=" · 启动于 " /><Run Text="{Binding StartTimeText, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{Binding PathText}" Style="{DynamicResource MonoTextStyle}" Margin="0,8,0,0" />

        <Border BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,12,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="CPU" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuText}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Text="工作集" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MemoryText}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="2" Text="专用内存" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PrivateMemoryText}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="3" Text="虚拟内存" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VirtualMemoryText}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="4" Text="线程" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ThreadCount}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="5" Text="句柄" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HandleCount}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="6" Text="状态" Style="{DynamicResource MutedTextStyle}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RespondingText}" />
        </Grid>

        <TextBlock x:Name="StatusText"
                   Foreground="{DynamicResource WarningBrush}"
                   Visibility="Collapsed"
                   Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="刷新" Width="84" Height="32" Margin="0,0,8,0" Click="OnRefreshClick" />
            <Button Content="关闭" Width="84" Height="32" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</Window>

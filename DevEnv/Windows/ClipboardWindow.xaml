<Window x:Class="DevEnv.Host.Windows.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
        Title="熔岩剪贴板"
        Width="920"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.DataContext>
        <vm:ClipboardViewModel />
    </Window.DataContext>

    <DockPanel Margin="14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="熔岩剪贴板" Style="{DynamicResource PageTitleStyle}" />
                <TextBlock Text="自动记录文本 / 图片 · 双击还原 · Ctrl+Space 唤起" Style="{DynamicResource PageHintStyle}" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top"
                       Text="{Binding Message}" Style="{DynamicResource PageHintStyle}" />
        </Grid>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox Width="180" Margin="0,0,8,0" Style="{StaticResource SearchBoxStyle}"
                     Tag="搜索剪贴板内容"
                     ToolTip="搜索" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="100" Margin="0,0,8,0"
                      Tag="全部类型"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding TypeFilter, Mode=TwoWay}"
                      ToolTip="类型">
                <ComboBoxItem Content="全部" Tag="" />
                <ComboBoxItem Content="文本" Tag="text" />
                <ComboBoxItem Content="图片" Tag="image" />
            </ComboBox>
            <ComboBox x:Name="ClearModeCombo" Width="110" Margin="0,0,8,0"
                      Tag="清空记录…"
                      SelectionChanged="OnClearModeChanged" />
            <Button Content="导出" Margin="0,0,8,0" Command="{Binding ExportCommand}" />
            <Button Content="刷新" Command="{Binding ReloadCommand}" />
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="0">
              <Grid>
                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         MouseDoubleClick="OnEntryDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Style="{DynamicResource MutedTextStyle}">
                                    <Run Text="{Binding Timestamp, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Type, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock TextTrimming="CharacterEllipsis" MaxHeight="40" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="{Binding Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                    <Setter Property="Text" Value="[图片]" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="暂无记录"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{DynamicResource PageHintStyle}"
                           Visibility="{Binding Entries.Count, Converter={StaticResource NoItems}}" />
              </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="选择一条记录查看详情（双击可还原到系统剪贴板）"
                                   Style="{DynamicResource PageHintStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Selected, Converter={StaticResource FalseToVisibility}}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding Selected, Converter={StaticResource TrueToVisibility}}"
                                DataContext="{Binding Selected}">
                        <TextBlock Text="{Binding Timestamp}" Style="{DynamicResource MutedTextStyle}" />
                        <Image Source="{Binding ImageFullPath, Converter={StaticResource PathToImage}}"
                               MaxHeight="320" Margin="0,8,0,8"
                               Stretch="Uniform"
                               Visibility="{Binding IsImage, Converter={StaticResource TrueToVisibility}}" />
                        <TextBox Text="{Binding Text, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 MaxHeight="320"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsImage, Converter={StaticResource FalseToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="还原到剪贴板" Margin="0,0,8,0" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="删除"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
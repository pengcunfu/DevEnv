<Window x:Class="DevEnv.Host.Windows.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
        Title="熔岩剪贴板"
        Width="960"
        Height="680"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="Manual"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.DataContext>
        <vm:ClipboardViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- 左侧列表与右侧详情共用：复制 / 删除当前条目 -->
        <ContextMenu x:Key="EntryContextMenu" x:Shared="False"
                     ContextMenuOpening="OnEntryMenuOpening">
            <MenuItem Header="复制" Click="OnEntryCopyClick" />
            <MenuItem Header="删除" Click="OnEntryDeleteClick" />
        </ContextMenu>
    </Window.Resources>

    <DockPanel>
        <!-- 底部状态栏：左侧常驻统计，右侧最近一次操作反馈 -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatsText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Message}"
                           FontSize="11"
                           Margin="24,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <DockPanel Margin="14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="熔岩剪贴板" Style="{DynamicResource PageTitleStyle}" />
                <TextBlock Text="自动记录文本 / 图片 · 双击复制 · 按 Ctrl+Space 或从托盘菜单打开" Style="{DynamicResource PageHintStyle}" />
            </StackPanel>
        </Grid>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox Width="180" Margin="0,0,8,0" Style="{StaticResource SearchBoxStyle}"
                     Tag="搜索剪贴板内容"
                     ToolTip="搜索" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="100" Margin="0,0,8,0"
                      Tag="全部类型"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding TypeFilter, Mode=TwoWay}"
                      ToolTip="类型">
                <ComboBoxItem Content="全部" Tag="" />
                <ComboBoxItem Content="文本" Tag="text" />
                <ComboBoxItem Content="图片" Tag="image" />
            </ComboBox>
            <Button Content="清空记录" Margin="0,0,8,0" Click="OnClearButtonClick">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="清空文本记录">
                            <MenuItem Header="全部" Tag="text|all" Click="OnClearRangeClick" />
                            <MenuItem Header="今天" Tag="text|today" Click="OnClearRangeClick" />
                            <MenuItem Header="昨天" Tag="text|yesterday" Click="OnClearRangeClick" />
                            <MenuItem Header="前天" Tag="text|daybefore" Click="OnClearRangeClick" />
                        </MenuItem>
                        <MenuItem Header="清空图片记录">
                            <MenuItem Header="全部" Tag="image|all" Click="OnClearRangeClick" />
                            <MenuItem Header="今天" Tag="image|today" Click="OnClearRangeClick" />
                            <MenuItem Header="昨天" Tag="image|yesterday" Click="OnClearRangeClick" />
                            <MenuItem Header="前天" Tag="image|daybefore" Click="OnClearRangeClick" />
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="导出" Margin="0,0,8,0" Command="{Binding ExportCommand}" />
            <Button Content="刷新" Command="{Binding ReloadCommand}" />
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="0">
              <Grid>
                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ContextMenu="{StaticResource EntryContextMenu}"
                         PreviewMouseRightButtonDown="OnEntryListRightButtonDown"
                         MouseDoubleClick="OnEntryDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Style="{DynamicResource MutedTextStyle}">
                                    <Run Text="{Binding Timestamp, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Type, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock TextTrimming="CharacterEllipsis" MaxHeight="40" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="{Binding Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                    <Setter Property="Text" Value="[图片]" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="暂无记录"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{DynamicResource PageHintStyle}"
                           Visibility="{Binding Entries.Count, Converter={StaticResource NoItems}}" />
              </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0"
                    ContextMenu="{StaticResource EntryContextMenu}">
                <Grid DataContext="{Binding Selected}">
                    <Image Source="{Binding ImageFullPath, Converter={StaticResource PathToImage}}"
                           Margin="8"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsImage, Converter={StaticResource TrueToVisibility}}" />
                    <TextBox Text="{Binding Text, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="10,8"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Visibility="{Binding IsImage, Converter={StaticResource FalseToVisibility}}" />
                </Grid>
            </Border>
        </Grid>
        </DockPanel>
    </DockPanel>
</Window>
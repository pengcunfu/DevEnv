<Window x:Class="DevEnv.Host.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevEnv.Host.Views"
        Title="设置"
        Width="820"
        Height="720"
        MinWidth="700"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <!-- 各页签：TabControl 与 ScrollViewer 均拉伸；Grid 绑定 ViewportWidth 保证卡片铺满 -->
    <TabControl x:Name="Tabs"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top">
        <TabItem Header="常规" x:Name="GeneralTab">
            <ScrollViewer Style="{StaticResource SettingsPageScrollStyle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <Grid Style="{StaticResource SettingsPageHostStyle}">
                    <StackPanel HorizontalAlignment="Stretch">
                        <views:SettingsView x:Name="GeneralHostView" HorizontalAlignment="Stretch" />
                        <ContentControl x:Name="SigXorGeneralSlot" Style="{StaticResource SettingsSectionHostStyle}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="快捷键" x:Name="HotkeysTab">
            <ScrollViewer Style="{StaticResource SettingsPageScrollStyle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <Grid Style="{StaticResource SettingsPageHostStyle}">
                    <ContentControl x:Name="HotkeysSlot" Style="{StaticResource SettingsSectionHostStyle}" />
                </Grid>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="语音与截屏" x:Name="VoiceTab">
            <ScrollViewer Style="{StaticResource SettingsPageScrollStyle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <Grid Style="{StaticResource SettingsPageHostStyle}">
                    <ContentControl x:Name="VoiceSlot" Style="{StaticResource SettingsSectionHostStyle}" />
                </Grid>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="服务与模型" x:Name="ServiceTab">
            <ScrollViewer Style="{StaticResource SettingsPageScrollStyle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <Grid Style="{StaticResource SettingsPageHostStyle}">
                    <ContentControl x:Name="ServiceSlot" Style="{StaticResource SettingsSectionHostStyle}" />
                </Grid>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="关于与帮助" x:Name="AboutTab">
            <ScrollViewer Style="{StaticResource SettingsPageScrollStyle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <Grid Style="{StaticResource SettingsPageHostStyle}">
                    <views:AboutHelpView x:Name="AboutHelpHost" HorizontalAlignment="Stretch" />
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>

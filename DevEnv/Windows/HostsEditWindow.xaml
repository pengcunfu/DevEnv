<Window x:Class="DevEnv.Host.Windows.HostsEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hosts 文件编辑器（管理员）"
        Width="760"
        Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBrush}">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   x:Name="PathText"
                   Margin="10,8"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource ChromeBrush}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="10,8">
                <Button Content="保存" Width="88" Height="28" Margin="0,0,8,0"
                        IsDefault="True"
                        Click="OnSaveClick" />
                <Button Content="关闭" Width="88" Height="28"
                        IsCancel="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </Border>
        <TextBox x:Name="Editor"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="13"
                 SpellCheck.IsEnabled="False"
                 BorderThickness="0"
                 Padding="10"
                 Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
    </DockPanel>
</Window>
<Window x:Class="DevEnv.Host.Windows.AboutHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevEnv.Host.Views"
        Title="关于与帮助"
        Width="760"
        Height="640"
        MinWidth="600"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- 独立的模态「关于与帮助」窗口，内容与设置对话框原本的页签一致 -->
    <ScrollViewer Style="{StaticResource SettingsPageScrollStyle}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
        <Grid Style="{StaticResource SettingsPageHostStyle}">
            <views:AboutHelpView x:Name="AboutHelpHost" HorizontalAlignment="Stretch" />
        </Grid>
    </ScrollViewer>
</Window>

<Window x:Class="DevEnv.Host.Windows.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DevEnv.Host.Controls"
        xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
        Title="全局启动器"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <!-- 全屏启动器（Launchpad 样式）：铺满屏幕的半透明深色背景上，
         顶部搜索、中部大图标网格、底部横向页签（本地应用 / 文件夹 / 网站 / 系统工具 / 内置工具）；
         单击图标即启动，Esc 关闭；空白处拖拽框选，拖到图标上合并为文件夹。 -->
    <Window.DataContext>
        <vm:ShortcutLauncherViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- 搜索框：启动器背景恒为深色，文字与占位提示固定用白色系，不跟随主题 -->
        <Style x:Key="LaunchpadSearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFFFF" />
            <Setter Property="SelectionBrush" Value="#CC5B9BFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False" />
                            <TextBlock x:Name="Placeholder"
                                       Text="搜索应用、文件夹、网站或工具"
                                       FontSize="15"
                                       Foreground="#80FFFFFF"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标卡片 -->
        <Style x:Key="LaunchpadTile" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="8,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#8C5B9BFF" />
                            </Trigger>
                            <!-- 框选 / Ctrl+单击的选中态 -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#335B9BFF" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#FF5B9BFF" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部页签（横向胶囊） -->
        <Style x:Key="LaunchpadTabItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill"
                                Background="#14FFFFFF"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="15,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="#E6FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标卡片：页签网格与文件夹浮层共用 -->
        <DataTemplate x:Key="LauncherEntryTemplate">
            <Button Style="{StaticResource LaunchpadTile}"
                    ToolTip="{Binding TargetPath}"
                    Click="OnEntryClick"
                    PreviewMouseLeftButtonDown="OnEntryPreviewMouseLeftButtonDown"
                    PreviewMouseMove="OnEntryPreviewMouseMove"
                    ContextMenuOpening="OnEntryContextMenuOpening">
                <StackPanel Width="116">
                    <Grid Height="76">
                        <Border Width="72"
                                Height="72"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#1FFFFFFF"
                                CornerRadius="17"
                                Tag="IconDropZone">
                            <Grid>
                                <!-- 普通卡片：单图标 -->
                                <Grid Visibility="{Binding IsGroup, Converter={StaticResource FalseToVisibility}}">
                                    <Image Width="56"
                                           Height="56"
                                           Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasIcon, Converter={StaticResource TrueToVisibility}}" />
                                    <TextBlock Text="{Binding KindGlyph}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="30"
                                               Foreground="#E6FFFFFF"
                                               Visibility="{Binding HasIcon, Converter={StaticResource FalseToVisibility}}" />
                                </Grid>
                                <!-- 启动器文件夹：前四项 2×2 预览 -->
                                <ItemsControl Margin="7"
                                              ItemsSource="{Binding GroupPreview}"
                                              Visibility="{Binding IsGroup, Converter={StaticResource TrueToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="2" Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="27" Height="27">
                                                <Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource TrueToVisibility}}" />
                                                <TextBlock Text="{Binding KindGlyph}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="#E6FFFFFF"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource FalseToVisibility}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               MaxWidth="116"
                               MaxHeight="34"
                               Text="{Binding Name}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12.5"
                               Foreground="#F2FFFFFF" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding KindText}"
                               TextAlignment="Center"
                               FontSize="10.5"
                               Foreground="#80FFFFFF">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSearching, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- 系统工具的卡片始终显示分类 -->
                                    <DataTrigger Binding="{Binding IsToolCard}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- 文件夹磁贴始终显示条目数 -->
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- 右下角圆形「＋」 -->
        <Style x:Key="LaunchpadCircleButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#26FFFFFF"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#59FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root"
          PreviewMouseLeftButtonDown="OnRootPreviewMouseLeftButtonDown"
          PreviewMouseMove="OnRootPreviewMouseMove"
          PreviewMouseLeftButtonUp="OnRootPreviewMouseLeftButtonUp"
          PreviewMouseWheel="OnPreviewMouseWheel">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#E6141820" />
                <GradientStop Offset="0.55" Color="#E60A0C10" />
                <GradientStop Offset="1" Color="#E6171A22" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="添加本地应用…" Click="OnAddAppMenu" />
                <MenuItem Header="添加文件夹…" Click="OnAddFolderMenu" />
                <MenuItem Header="添加网站…" Click="OnAddWebMenu" />
                <Separator />
                <MenuItem x:Name="MergeSelectionMenu" Header="合并为文件夹…" Click="OnMergeSelectionMenu"
                          Visibility="Collapsed" />
                <Separator />
                <MenuItem Header="刷新" Click="OnReloadMenu" />
                <MenuItem Header="关闭启动器" Click="OnCloseMenu" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- 固定底行高度：右下角「＋」只在可编辑页显示，若由它撑高，切换系统工具 /
                 内置工具页时底行会矮一截，页签跟着上下跳 -->
            <RowDefinition Height="Auto" MinHeight="82" />
        </Grid.RowDefinitions>

        <!-- 顶部：提示 + 搜索框 -->
        <TextBlock Grid.Row="0"
                   Margin="28,24,0,0"
                   HorizontalAlignment="Left"
                   Text="拖入 .exe 或文件夹即可添加"
                   FontSize="11"
                   Foreground="#73FFFFFF"
                   Visibility="{Binding CanAddOnCurrentPage, Converter={StaticResource TrueToVisibility}}" />
        <TextBlock Grid.Row="0"
                   Margin="0,24,28,0"
                   HorizontalAlignment="Right"
                   Text="拖动空白框选 · Esc 关闭"
                   FontSize="11"
                   Foreground="#73FFFFFF" />

        <Border x:Name="SearchShell"
                Grid.Row="0"
                Width="560"
                Height="46"
                Margin="0,54,0,0"
                HorizontalAlignment="Center"
                Background="#22FFFFFF"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="16,0,10,0"
                           VerticalAlignment="Center"
                           Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="#99FFFFFF" />
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Margin="0,0,12,0"
                         Style="{StaticResource LaunchpadSearchBox}"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <!-- 中部：图标网格 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <ScrollViewer x:Name="EntryScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,0,24,0"
                          Background="Transparent">
                <ItemsControl x:Name="EntryGrid"
                              ItemsSource="{Binding PageEntries}"
                              ItemTemplate="{StaticResource LauncherEntryTemplate}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:CenteredWrapPanel ItemWidth="132" ItemHeight="150" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态（当前页还没有快捷方式） -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                                    <Condition Binding="{Binding IsSearching}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE8A9;"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="40"
                           Foreground="#59FFFFFF" />
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Text="这里还没有快捷方式"
                           FontSize="15"
                           Foreground="#B3FFFFFF" />
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Text="把 .exe 或文件夹拖进来，或点右下角 ＋ 添加"
                           FontSize="12"
                           Foreground="#73FFFFFF" />
            </StackPanel>

            <!-- 空状态（搜索没有命中） -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                                    <Condition Binding="{Binding IsSearching}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE721;"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="36"
                           Foreground="#59FFFFFF" />
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Text="没有找到匹配项"
                           FontSize="15"
                           Foreground="#B3FFFFFF" />
            </StackPanel>
        </Grid>

        <!-- 底部：提示 + 横向页签 -->
        <StackPanel Grid.Row="3"
                    Margin="0,4,0,34"
                    HorizontalAlignment="Center">
            <TextBlock Margin="0,0,0,10"
                       HorizontalAlignment="Center"
                       Text="{Binding Summary}"
                       FontSize="12"
                       Foreground="#8CFFFFFF"
                       Visibility="{Binding Summary, Converter={StaticResource NonEmptyString}}" />
            <TextBlock Margin="0,0,0,8"
                       HorizontalAlignment="Center"
                       Text="{Binding Message}"
                       FontSize="12"
                       Foreground="#FFFF9A9A"
                       TextWrapping="Wrap"
                       MaxWidth="640"
                       Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}" />
            <ListBox x:Name="PageTabs"
                     ItemsSource="{Binding Pages}"
                     SelectedIndex="{Binding SelectedPage, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource LaunchpadTabItem}"
                     Focusable="False">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInsideGroup}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Glyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Title}"
                                       FontSize="12.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- 右下角添加 -->
        <Button Grid.Row="3"
                Margin="0,0,40,36"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource LaunchpadCircleButton}"
                ToolTip="添加当前页的快捷方式"
                Visibility="{Binding CanAddOnCurrentPage, Converter={StaticResource TrueToVisibility}}"
                Click="OnAddClick">
            <TextBlock Text="&#xE710;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>

        <!-- 启动器文件夹：居中浮层卡片（类似平板文件夹），不占满启动器；
             不用单独的返回按钮，点击卡片外的空白处或按 Esc 收起。
             底层网格仍显示当前页签，浮层只负责组内条目。 -->
        <Grid x:Name="GroupLayer"
              Grid.Row="1"
              Grid.RowSpan="3"
              Visibility="{Binding IsInsideGroup, Converter={StaticResource TrueToVisibility}}">
            <Border Background="#73000000" />
            <Border x:Name="FolderCard"
                    MinWidth="360"
                    MaxWidth="840"
                    MaxHeight="560"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F5161A22"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="18,16,18,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32"
                                      ShadowDepth="0"
                                      Opacity="0.55"
                                      Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 文件夹名 + 条目数 + 关闭提示（不放返回按钮） -->
                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding CurrentGroup.Name}"
                                   FontSize="15"
                                   Foreground="#F2FFFFFF" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Summary}"
                                   FontSize="11.5"
                                   Foreground="#80FFFFFF" />
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Text="点击空白处或按 Esc 关闭"
                                   FontSize="11"
                                   Foreground="#73FFFFFF" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="440"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent">
                        <ItemsControl x:Name="GroupGrid"
                                      ItemsSource="{Binding VisibleEntries}"
                                      ItemTemplate="{StaticResource LauncherEntryTemplate}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:CenteredWrapPanel ItemWidth="132" ItemHeight="150" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 框选矩形与拖拽落点提示；不参与命中测试，避免挡住卡片和右键菜单 -->
        <Canvas x:Name="SelectionLayer"
                Grid.RowSpan="4"
                IsHitTestVisible="False"
                ClipToBounds="True">
            <Rectangle x:Name="SelectionRect"
                       Visibility="Collapsed"
                       Fill="#265B9BFF"
                       Stroke="#FF5B9BFF"
                       StrokeThickness="1.5" />
            <Border x:Name="DropHighlight"
                    Visibility="Collapsed"
                    Background="#265B9BFF"
                    BorderBrush="#FF5B9BFF"
                    BorderThickness="2"
                    CornerRadius="16" />
            <Rectangle x:Name="InsertionBar"
                       Width="3"
                       Height="110"
                       RadiusX="1.5"
                       RadiusY="1.5"
                       Fill="#FF5B9BFF"
                       Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>

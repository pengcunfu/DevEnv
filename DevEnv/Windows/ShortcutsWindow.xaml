<Window x:Class="DevEnv.Host.Windows.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DevEnv.Host.Controls"
        xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
        Title="全局启动器"
        Background="{DynamicResource LauncherBackgroundBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <!-- 启动器（Launchpad 样式）：使用 Windows 默认窗口边框与标题栏，固定 1200 × 800 DIP、在工作区内居中，
         内容配色与 Windows 11 开始菜单一致。顶部一行从左到右是横向页签（本地应用 / 文件夹 / 网站 / 开始菜单）、
         紧凑搜索框，以及「系统工具」「内置工具」两个只读页签；中部是大图标网格；
         单击图标即启动，Esc 关闭；空白处拖拽框选，拖到图标上合并为文件夹。 -->
    <Window.DataContext>
        <vm:ShortcutLauncherViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <!-- 启动器配色：与 Windows 11 开始菜单一致，按系统「应用模式」在浅 / 深之间切换。
                 两套 key 完全一致，代码里整块替换即可，所有颜色都用 DynamicResource 引用。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevEnv;component/Themes/Launcher.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 搜索框：文字、光标与占位提示跟随启动器配色 -->
            <Style x:Key="LaunchpadSearchBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource LauncherAccentBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource LauncherAccentSelectionBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False" />
                            <TextBlock x:Name="Placeholder"
                                       Text="搜索应用、文件夹、网站或工具"
                                       FontSize="14"
                                       Foreground="{DynamicResource LauncherTextMutedBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索框右侧的固定工具文件夹：与搜索框同高的玻璃胶囊，点击后在文件夹浮层里展开 -->
        <Style x:Key="LaunchpadShelfButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shelf"
                                Background="{DynamicResource LauncherSurfaceBrush}"
                                BorderBrush="{DynamicResource LauncherBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shelf" Property="Background" Value="{DynamicResource LauncherSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shelf" Property="Background" Value="{DynamicResource LauncherSurfacePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标卡片：悬停轻微放大抬起，按下回弹，离场复位 -->
        <Style x:Key="LaunchpadTile" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="8,10"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.05" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.05" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherTilePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource LauncherAccentBrush}" />
                            </Trigger>
                            <!-- 框选 / Ctrl+单击的选中态 -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherAccentSelectionBrush}" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource LauncherAccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 放大后的卡片要盖住相邻卡片，否则右 / 下方的邻居会压住它 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="20" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 左上角页签（横向胶囊） -->
        <Style x:Key="LaunchpadTabItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource LauncherTextMutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10,6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource LauncherPillSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                                <!-- 选中时轻弹一下，给滚轮 / 左右键换页一个落点反馈 -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PillScale"
                                                                           Storyboard.TargetProperty="ScaleX">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="1.09" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PillScale"
                                                                           Storyboard.TargetProperty="ScaleY">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="1.09" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标卡片：页签网格与文件夹浮层共用 -->
        <DataTemplate x:Key="LauncherEntryTemplate">
            <Button Style="{StaticResource LaunchpadTile}"
                    ToolTip="{Binding TargetPath}"
                    Click="OnEntryClick"
                    PreviewMouseLeftButtonDown="OnEntryPreviewMouseLeftButtonDown"
                    PreviewMouseMove="OnEntryPreviewMouseMove"
                    ContextMenuOpening="OnEntryContextMenuOpening">
                <StackPanel Width="116">
                    <Grid Height="68">
                        <Border Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource LauncherIconBackdropBrush}"
                                CornerRadius="15"
                                Tag="IconDropZone">
                            <Grid>
                                <!-- 普通卡片：单图标 -->
                                <Grid Visibility="{Binding IsGroup, Converter={StaticResource FalseToVisibility}}">
                                    <Image Width="48"
                                           Height="48"
                                           Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasIcon, Converter={StaticResource TrueToVisibility}}" />
                                    <!-- 内置工具：固定品牌色圆角底 + 白色字形，和图片图标一眼区分 -->
                                    <Border Width="48"
                                            Height="48"
                                            CornerRadius="12"
                                            Background="{Binding IconBrush}"
                                            Visibility="{Binding HasToolBadge, Converter={StaticResource TrueToVisibility}}">
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="24"
                                                   Foreground="{DynamicResource LauncherBadgeGlyphBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding KindGlyph}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="26"
                                               Foreground="{DynamicResource LauncherTextPrimaryBrush}"
                                               Visibility="{Binding ShowsKindGlyph, Converter={StaticResource TrueToVisibility}}" />
                                </Grid>
                                <!-- 启动器文件夹：前四项 2×2 预览 -->
                                <ItemsControl Margin="6"
                                              ItemsSource="{Binding GroupPreview}"
                                              Visibility="{Binding IsGroup, Converter={StaticResource TrueToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="2" Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="24" Height="24">
                                                <Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource TrueToVisibility}}" />
                                                <Border CornerRadius="6"
                                                        Background="{Binding IconBrush}"
                                                        Visibility="{Binding HasToolBadge, Converter={StaticResource TrueToVisibility}}">
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource LauncherBadgeGlyphBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding KindGlyph}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource LauncherTextPrimaryBrush}"
                                                           Visibility="{Binding ShowsKindGlyph, Converter={StaticResource TrueToVisibility}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               MaxWidth="116"
                               MaxHeight="34"
                               Text="{Binding Name}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12.5"
                               Foreground="{DynamicResource LauncherTextPrimaryBrush}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding KindText}"
                               TextAlignment="Center"
                               FontSize="10.5"
                               Foreground="{DynamicResource LauncherTextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSearching, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- 系统工具的卡片始终显示分类 -->
                                    <DataTrigger Binding="{Binding IsToolCard}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- 文件夹磁贴始终显示条目数 -->
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- 右下角圆形「＋」 -->
        <Style x:Key="LaunchpadCircleButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource LauncherCircleBrush}"
                                BorderBrush="{DynamicResource LauncherBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LauncherCircleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LauncherCirclePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root"
          PreviewMouseLeftButtonDown="OnRootPreviewMouseLeftButtonDown"
          PreviewMouseMove="OnRootPreviewMouseMove"
          PreviewMouseLeftButtonUp="OnRootPreviewMouseLeftButtonUp"
          PreviewMouseWheel="OnPreviewMouseWheel">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="添加本地应用…" Click="OnAddAppMenu" />
                <MenuItem Header="添加文件夹…" Click="OnAddFolderMenu" />
                <MenuItem Header="添加网站…" Click="OnAddWebMenu" />
                <Separator />
                <MenuItem x:Name="MergeSelectionMenu" Header="合并为文件夹…" Click="OnMergeSelectionMenu"
                          Visibility="Collapsed" />
                <Separator />
                <MenuItem Header="刷新" Click="OnReloadMenu" />
                <MenuItem Header="关闭启动器" Click="OnCloseMenu" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- 固定底行高度：右下角「＋」只在可编辑页显示，若由它撑高，
                 进入文件夹浮层时底行会矮一截，状态提示跟着上下跳 -->
            <RowDefinition Height="Auto" MinHeight="82" />
        </Grid.RowDefinitions>

        <!-- 窗口使用系统默认边框与标题栏，背景色由 Window.Background 提供 -->

        <!-- 顶部一行：六个页签与搜索框；系统工具 / 内置工具与本地应用等并列，不再使用右侧文件夹按钮。 -->
        <Grid Grid.Row="0"
              Margin="16,14,16,0"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="PageTabs"
                     Grid.Column="0"
                     VerticalAlignment="Center"
                     ItemsSource="{Binding Pages}"
                     SelectedIndex="{Binding SelectedPage, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource LaunchpadTabItem}"
                     Focusable="False">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- 用 Hidden 而不是 Collapsed：搜索 / 文件夹浮层时页签不可见但仍占位，
                                 后面的搜索框与工具文件夹不会突然向左跳 -->
                            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInsideGroup}" Value="True">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Glyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Title}"
                                       FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="SearchShell"
                    Grid.Column="1"
                    Height="38"
                    MinWidth="120"
                    MaxWidth="250"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource LauncherSurfaceBrush}"
                    BorderBrush="{DynamicResource LauncherBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="10,0,7,0"
                               VerticalAlignment="Center"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Margin="0,0,10,0"
                             Style="{StaticResource LaunchpadSearchBox}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 中部：图标网格 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <ScrollViewer x:Name="EntryScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,0,24,0"
                          Background="Transparent">
                <ItemsControl x:Name="EntryGrid"
                              ItemsSource="{Binding PageEntries}"
                              ItemTemplate="{StaticResource LauncherEntryTemplate}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <EventSetter Event="Loaded" Handler="OnEntryContainerLoaded" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:CenteredWrapPanel ItemWidth="132" ItemHeight="150" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态（当前页还没有快捷方式） -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                                    <Condition Binding="{Binding IsSearching}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE8A9;"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="40"
                           Foreground="{DynamicResource LauncherTextMutedBrush}" />
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Text="{Binding EmptyTitle}"
                           FontSize="15"
                           Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Text="{Binding EmptyHint}"
                           FontSize="12"
                           Foreground="{DynamicResource LauncherTextMutedBrush}" />
            </StackPanel>

            <!-- 空状态（搜索没有命中） -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                                    <Condition Binding="{Binding IsSearching}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE721;"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="36"
                           Foreground="{DynamicResource LauncherTextMutedBrush}" />
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Text="没有找到匹配项"
                           FontSize="15"
                           Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 底部：操作提示 / 搜索条数 / 文件夹条目数 / 操作失败提示。
             顶部一行已排满，提示从右上角移到底部居中。 -->
        <StackPanel Grid.Row="3"
                    Margin="0,4,0,26"
                    HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center"
                       Text="拖动空白框选 · Esc 关闭"
                       FontSize="11"
                       Foreground="{DynamicResource LauncherTextMutedBrush}" />
            <TextBlock Margin="0,2,0,0"
                       HorizontalAlignment="Center"
                       Text="拖入 .exe 或文件夹即可添加"
                       FontSize="11"
                       Foreground="{DynamicResource LauncherTextMutedBrush}"
                       Visibility="{Binding CanAddOnCurrentPage, Converter={StaticResource TrueToVisibility}}" />
            <TextBlock Margin="0,8,0,8"
                       HorizontalAlignment="Center"
                       Text="{Binding Notice}"
                       FontSize="12"
                       Foreground="{DynamicResource LauncherTextSecondaryBrush}"
                       Visibility="{Binding Notice, Converter={StaticResource NonEmptyString}}" />
            <TextBlock Margin="0,0,0,8"
                       HorizontalAlignment="Center"
                       Text="{Binding Summary}"
                       FontSize="12"
                       Foreground="{DynamicResource LauncherTextMutedBrush}"
                       Visibility="{Binding Summary, Converter={StaticResource NonEmptyString}}" />
            <TextBlock Margin="0,0,0,6"
                       HorizontalAlignment="Center"
                       Text="{Binding Message}"
                       FontSize="12"
                       Foreground="{DynamicResource LauncherDangerBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="640"
                       Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}" />
        </StackPanel>

        <!-- 右下角添加 -->
        <Button Grid.Row="3"
                Margin="0,0,40,36"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource LaunchpadCircleButton}"
                ToolTip="添加当前页的快捷方式"
                Visibility="{Binding CanAddOnCurrentPage, Converter={StaticResource TrueToVisibility}}"
                Click="OnAddClick">
            <TextBlock Text="&#xE710;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>

        <!-- 启动器文件夹：居中浮层卡片（类似平板文件夹），不占满启动器；
             不用单独的返回按钮，点击卡片外的空白处或按 Esc 收起。
             底层网格仍显示当前页签，浮层只负责组内条目。 -->
        <Grid x:Name="GroupLayer"
              Grid.Row="0"
              Grid.RowSpan="4"
              Visibility="{Binding IsInsideGroup, Converter={StaticResource TrueToVisibility}}">
            <!-- 遮罩铺满整窗（含顶栏），避免顶栏在浅色主题下成为一条未压暗的白带 -->
            <Border x:Name="GroupDim" Background="{DynamicResource LauncherScrimBrush}" />
            <Border x:Name="FolderCard"
                    MinWidth="360"
                    MaxWidth="760"
                    MaxHeight="560"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource LauncherCardBrush}"
                    BorderBrush="{DynamicResource LauncherBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="18,16,18,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      ShadowDepth="0"
                                      Opacity="0.22"
                                      Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 文件夹名 + 条目数 + 关闭提示（不放返回按钮） -->
                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding CurrentGroup.Name}"
                                   FontSize="15"
                                   Foreground="{DynamicResource LauncherTextPrimaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Summary}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource LauncherTextMutedBrush}" />
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Text="点击空白处或按 Esc 关闭"
                                   FontSize="11"
                                   Foreground="{DynamicResource LauncherTextMutedBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="440"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent">
                        <ItemsControl x:Name="GroupGrid"
                                      ItemsSource="{Binding VisibleEntries}"
                                      ItemTemplate="{StaticResource LauncherEntryTemplate}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:CenteredWrapPanel ItemWidth="132" ItemHeight="150" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 框选矩形与拖拽落点提示；不参与命中测试，避免挡住卡片和右键菜单 -->
        <Canvas x:Name="SelectionLayer"
                Grid.RowSpan="4"
                IsHitTestVisible="False"
                ClipToBounds="True">
            <Rectangle x:Name="SelectionRect"
                       Visibility="Collapsed"
                       Fill="{DynamicResource LauncherAccentFaintBrush}"
                       Stroke="{DynamicResource LauncherAccentBrush}"
                       StrokeThickness="1.5" />
            <Border x:Name="DropHighlight"
                    Visibility="Collapsed"
                    Background="{DynamicResource LauncherAccentFaintBrush}"
                    BorderBrush="{DynamicResource LauncherAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="16" />
            <Rectangle x:Name="InsertionBar"
                       Width="3"
                       Height="110"
                       RadiusX="1.5"
                       RadiusY="1.5"
                       Fill="{DynamicResource LauncherAccentBrush}"
                       Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>

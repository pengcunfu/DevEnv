<Window x:Class="DevEnv.Host.Windows.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DevEnv.Host.Controls"
        xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
        Title="FireNeb DevEnv"
        Background="{DynamicResource LauncherBackgroundBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <!-- 启动器（Launchpad 样式）：使用 Windows 默认窗口边框与标题栏，固定 960 × 680 DIP、在工作区内居中，
         内容配色与 Windows 11 开始菜单一致。左侧栏自上而下是搜索框与纵向页签（本地应用 / 文件夹 /
         网站 / 系统工具 / 内置工具 / 开始菜单），右侧是大图标网格；
         单击图标即启动，Esc 关闭；空白处拖拽框选，拖到图标上合并为文件夹。 -->
    <Window.DataContext>
        <vm:ShortcutLauncherViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <!-- 启动器配色：与 Windows 11 开始菜单一致，按系统「应用模式」在浅 / 深之间切换。
                 两套 key 完全一致，代码里整块替换即可，所有颜色都用 DynamicResource 引用。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevEnv;component/Themes/Launcher.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 搜索框：文字、光标与占位提示跟随启动器配色 -->
            <Style x:Key="LaunchpadSearchBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource LauncherAccentBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource LauncherAccentSelectionBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False" />
                            <TextBlock x:Name="Placeholder"
                                       Text="搜索…"
                                       FontSize="13"
                                       Foreground="{DynamicResource LauncherTextMutedBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索框右侧的固定工具文件夹：与搜索框同高的玻璃胶囊，点击后在文件夹浮层里展开 -->
        <Style x:Key="LaunchpadShelfButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shelf"
                                Background="{DynamicResource LauncherSurfaceBrush}"
                                BorderBrush="{DynamicResource LauncherBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shelf" Property="Background" Value="{DynamicResource LauncherSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shelf" Property="Background" Value="{DynamicResource LauncherSurfacePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标卡片：悬停轻微放大抬起，按下回弹，离场复位 -->
        <!-- 贴近 Windows 11 开始菜单「已固定」：圆角抬升底、不缩放、无描边 -->
        <Style x:Key="LaunchpadTile" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="6,8,6,4"
                                ClipToBounds="True">
                            <!-- Top：内容贴顶，避免格高大于内容时上下居中把分类间距撑大 -->
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherTilePressedBrush}" />
                            </Trigger>
                            <!-- 框选：同款抬升底，不要蓝色描边 -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="20" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 左侧页签（纵向条目） -->
        <Style x:Key="LaunchpadTabItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- 未选中用 Secondary，Muted 在浅色底上偏淡，侧栏页签会看不清 -->
            <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,9"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource LauncherPillSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <!-- 选中时轻弹一下，给滚轮 / 左右键换页一个落点反馈 -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PillScale"
                                                                           Storyboard.TargetProperty="ScaleX">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="1.09" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PillScale"
                                                                           Storyboard.TargetProperty="ScaleY">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="1.09" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标卡片：贴近开始菜单「已固定」——大图标 + 单行标题 -->
        <DataTemplate x:Key="LauncherEntryTemplate">
            <Button Style="{StaticResource LaunchpadTile}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Stretch"
                    ToolTip="{Binding TargetPath}"
                    Click="OnEntryClick"
                    PreviewMouseLeftButtonDown="OnEntryPreviewMouseLeftButtonDown"
                    PreviewMouseMove="OnEntryPreviewMouseMove"
                    ContextMenuOpening="OnEntryContextMenuOpening">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <!-- 普通应用：图标直接铺开，不套灰底板；文件夹才用圆角底板 -->
                    <Grid Width="48"
                          Height="48"
                          HorizontalAlignment="Center"
                          Tag="IconDropZone">
                        <Border Background="{DynamicResource LauncherIconBackdropBrush}"
                                CornerRadius="8"
                                Visibility="{Binding IsGroup, Converter={StaticResource TrueToVisibility}}" />
                        <Grid Visibility="{Binding IsGroup, Converter={StaticResource FalseToVisibility}}">
                            <Image Width="48"
                                   Height="48"
                                   Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource TrueToVisibility}}" />
                            <Border Width="48"
                                    Height="48"
                                    CornerRadius="10"
                                    Background="{Binding IconBrush}"
                                    Visibility="{Binding HasToolBadge, Converter={StaticResource TrueToVisibility}}">
                                <TextBlock Text="{Binding IconGlyph}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="22"
                                           Foreground="{DynamicResource LauncherBadgeGlyphBrush}" />
                            </Border>
                            <TextBlock Text="{Binding KindGlyph}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="24"
                                       Foreground="{DynamicResource LauncherTextPrimaryBrush}"
                                       Visibility="{Binding ShowsKindGlyph, Converter={StaticResource TrueToVisibility}}" />
                        </Grid>
                        <ItemsControl Margin="4"
                                      ItemsSource="{Binding GroupPreview}"
                                      Visibility="{Binding IsGroup, Converter={StaticResource TrueToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="18" Height="18" Margin="1">
                                        <Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={StaticResource TrueToVisibility}}" />
                                        <Border CornerRadius="4"
                                                Background="{Binding IconBrush}"
                                                Visibility="{Binding HasToolBadge, Converter={StaticResource TrueToVisibility}}">
                                            <TextBlock Text="{Binding IconGlyph}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource LauncherBadgeGlyphBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding KindGlyph}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource LauncherTextPrimaryBrush}"
                                                   Visibility="{Binding ShowsKindGlyph, Converter={StaticResource TrueToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <!-- 开始菜单同款：最多两行换行，超出第二行再省略 -->
                    <TextBlock Margin="2,6,2,0"
                               HorizontalAlignment="Stretch"
                               Height="32"
                               Text="{Binding Name}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12"
                               LineHeight="16"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource LauncherTextPrimaryBrush}" />
                    <!-- 仅搜索态显示类型；文件夹不再显示「N 项」副标题（贴近开始菜单） -->
                    <TextBlock Margin="2,2,2,0"
                               HorizontalAlignment="Stretch"
                               Text="{Binding KindText}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="10"
                               Foreground="{DynamicResource LauncherTextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSearching, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- 右下角圆形「＋」 -->
        <Style x:Key="LaunchpadCircleButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource LauncherTextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource LauncherCircleBrush}"
                                BorderBrush="{DynamicResource LauncherBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LauncherCircleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LauncherCirclePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root"
          PreviewMouseLeftButtonDown="OnRootPreviewMouseLeftButtonDown"
          PreviewMouseMove="OnRootPreviewMouseMove"
          PreviewMouseLeftButtonUp="OnRootPreviewMouseLeftButtonUp"
          PreviewMouseWheel="OnPreviewMouseWheel">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="添加本地应用…" Click="OnAddAppMenu" />
                <MenuItem Header="添加文件夹…" Click="OnAddFolderMenu" />
                <MenuItem Header="添加网站…" Click="OnAddWebMenu" />
                <Separator />
                <MenuItem x:Name="MergeSelectionMenu" Header="合并为文件夹…" Click="OnMergeSelectionMenu"
                          Visibility="Collapsed" />
                <Separator />
                <MenuItem Header="刷新" Click="OnReloadMenu" />
                <MenuItem Header="关闭启动器" Click="OnCloseMenu" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 窗口使用系统默认边框与标题栏，背景色由 Window.Background 提供 -->

        <!-- 左侧栏：搜索在上、页签居中、操作提示贴底 -->
        <Border Grid.Column="0"
                Padding="12,14,12,14"
                BorderBrush="{DynamicResource LauncherBorderBrush}"
                BorderThickness="0,0,1,0"
                Background="{DynamicResource LauncherSurfaceBrush}">
            <DockPanel LastChildFill="True">
                <Border x:Name="SearchShell"
                        DockPanel.Dock="Top"
                        Height="36"
                        Background="{DynamicResource LauncherBackgroundBrush}"
                        BorderBrush="{DynamicResource LauncherBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="10,0,6,0"
                                   VerticalAlignment="Center"
                                   Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource LaunchpadSearchBox}"
                                 FontSize="13"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,16,4,4">
                    <TextBlock Text="拖动空白框选 · Esc 关闭"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource LauncherTextMutedBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="拖入 .exe 或文件夹即可添加"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource LauncherTextMutedBrush}"
                               Visibility="{Binding CanAddOnCurrentPage, Converter={StaticResource TrueToVisibility}}" />
                </StackPanel>

                <ListBox x:Name="PageTabs"
                         Margin="0,12,0,0"
                         VerticalAlignment="Top"
                         HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding Pages}"
                         SelectedIndex="{Binding SelectedPage, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource LaunchpadTabItem}"
                         Focusable="False"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Title}"
                                           FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧：图标网格 + 底栏 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- 底行只留状态提示与「＋」；操作说明已移到左侧栏底部 -->
                <RowDefinition Height="Auto" MinHeight="56" />
            </Grid.RowDefinitions>

            <Grid x:Name="PageContentHost" Grid.Row="0" Margin="0,12,0,0">
                <!-- 普通页签 / 搜索：扁平图标网格 -->
                <ScrollViewer x:Name="EntryScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="4,0,4,0"
                              Background="Transparent"
                              Visibility="{Binding ShowsToolSections, Converter={StaticResource FalseToVisibility}}">
                    <ItemsControl x:Name="EntryGrid"
                                  ItemsSource="{Binding PageEntries}"
                                  ItemTemplate="{StaticResource LauncherEntryTemplate}"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <EventSetter Event="Loaded" Handler="OnEntryContainerLoaded" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 开始菜单式格子：图标 48 + 两行标题，每行 8 个 -->
                                <controls:CenteredWrapPanel ItemWidth="90" ItemHeight="112" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 系统工具 / 内置工具：上方分类标签，下方图标 -->
                <ScrollViewer x:Name="SectionScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="4,0,4,0"
                              Background="Transparent"
                              Visibility="{Binding ShowsToolSections, Converter={StaticResource TrueToVisibility}}">
                    <ItemsControl x:Name="SectionGrid"
                                  ItemsSource="{Binding ToolSections}"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 分类间距要紧凑：格子贴合图标+两行标题，区块底边距尽量小 -->
                                <StackPanel Margin="0,0,0,2">
                                    <TextBlock Margin="8,0,8,2"
                                               Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource LauncherTextPrimaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding Entries}"
                                                  ItemTemplate="{StaticResource LauncherEntryTemplate}"
                                                  HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:CenteredWrapPanel ItemWidth="90" ItemHeight="100" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态（当前页还没有快捷方式） -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEmpty}" Value="True" />
                                        <Condition Binding="{Binding IsSearching}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE8A9;"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="40"
                               Foreground="{DynamicResource LauncherTextMutedBrush}" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Text="{Binding EmptyTitle}"
                               FontSize="15"
                               Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Text="{Binding EmptyHint}"
                               FontSize="12"
                               Foreground="{DynamicResource LauncherTextMutedBrush}" />
                </StackPanel>

                <!-- 空状态（搜索没有命中） -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEmpty}" Value="True" />
                                        <Condition Binding="{Binding IsSearching}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE721;"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="36"
                               Foreground="{DynamicResource LauncherTextMutedBrush}" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Text="没有找到匹配项"
                               FontSize="15"
                               Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,4,0,12"
                        HorizontalAlignment="Center">
                <TextBlock Margin="0,0,0,4"
                           HorizontalAlignment="Center"
                           Text="{Binding Notice}"
                           FontSize="12"
                           Foreground="{DynamicResource LauncherTextSecondaryBrush}"
                           Visibility="{Binding Notice, Converter={StaticResource NonEmptyString}}" />
                <TextBlock Margin="0,0,0,4"
                           HorizontalAlignment="Center"
                           Text="{Binding Summary}"
                           FontSize="12"
                           Foreground="{DynamicResource LauncherTextMutedBrush}"
                           Visibility="{Binding Summary, Converter={StaticResource NonEmptyString}}" />
                <TextBlock Margin="0,0,0,4"
                           HorizontalAlignment="Center"
                           Text="{Binding Message}"
                           FontSize="12"
                           Foreground="{DynamicResource LauncherDangerBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="640"
                           Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}" />
            </StackPanel>

            <Button Grid.Row="1"
                    Margin="0,0,20,16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource LaunchpadCircleButton}"
                    ToolTip="添加当前页的快捷方式"
                    Visibility="{Binding CanAddOnCurrentPage, Converter={StaticResource TrueToVisibility}}"
                    Click="OnAddClick">
                <TextBlock Text="&#xE710;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </Grid>

        <!-- 启动器文件夹：相对右侧内容区居中的半透明卡片，宽度随条目收窄；
             点击卡片外空白或 Esc 收起。遮罩仍铺满整窗（含侧栏）。 -->
        <Grid x:Name="GroupLayer"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Visibility="{Binding IsInsideGroup, Converter={StaticResource TrueToVisibility}}">
            <Border x:Name="GroupDim" Background="{DynamicResource LauncherScrimBrush}" />
            <!-- 与侧栏同宽占位，卡片只在内容列里居中 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="FolderCard"
                        Grid.Column="1"
                        MinWidth="240"
                        MaxWidth="480"
                        MaxHeight="520"
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource LauncherCardBrush}"
                        BorderBrush="{DynamicResource LauncherBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,12,14,10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28"
                                          ShadowDepth="0"
                                          Opacity="0.22"
                                          Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding CurrentGroup.Name}"
                                       FontSize="15"
                                       Foreground="{DynamicResource LauncherTextPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Summary}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource LauncherTextMutedBrush}" />
                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Text="点击空白处或按 Esc 关闭"
                                       FontSize="11"
                                       Foreground="{DynamicResource LauncherTextMutedBrush}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      MaxHeight="400"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Center"
                                      Background="Transparent">
                            <ItemsControl x:Name="GroupGrid"
                                          ItemsSource="{Binding VisibleEntries}"
                                          ItemTemplate="{StaticResource LauncherEntryTemplate}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:CenteredWrapPanel ItemWidth="90" ItemHeight="112" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 框选矩形与拖拽落点提示；不参与命中测试，避免挡住卡片和右键菜单 -->
        <Canvas x:Name="SelectionLayer"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                IsHitTestVisible="False"
                ClipToBounds="True">
            <Rectangle x:Name="SelectionRect"
                       Visibility="Collapsed"
                       Fill="{DynamicResource LauncherAccentFaintBrush}"
                       Stroke="{DynamicResource LauncherAccentBrush}"
                       StrokeThickness="1.5" />
            <Border x:Name="DropHighlight"
                    Visibility="Collapsed"
                    Background="{DynamicResource LauncherAccentFaintBrush}"
                    BorderBrush="{DynamicResource LauncherAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="16" />
            <Rectangle x:Name="InsertionBar"
                       Width="3"
                       Height="110"
                       RadiusX="1.5"
                       RadiusY="1.5"
                       Fill="{DynamicResource LauncherAccentBrush}"
                       Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>

<Window x:Class="DevEnv.Host.Windows.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DevEnv.Host.Controls"
        xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
        Title="燧岚开发盒子"
        Background="{DynamicResource LauncherBackgroundBrush}"
        ResizeMode="CanResize"
        MinWidth="800"
        MinHeight="560"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown"
        StateChanged="OnWindowStateChanged"
        Deactivated="OnDeactivated">
    <!-- 启动器（主窗口）：顶部菜单栏放全部系统工具，内容区是内置工具分类网格。
         本地应用 / 文件夹 / 网站 / 开始菜单已拆成独立窗口，从「内置工具 → 窗口入口」打开。
         使用 Windows 默认窗口边框与标题栏，默认 960 × 680 DIP、在工作区内居中。 -->
    <Window.DataContext>
        <vm:ShortcutLauncherViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <!-- 启动器配色：与 Windows 11 开始菜单一致，按系统「应用模式」在浅 / 深之间切换。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevEnv;component/Themes/LauncherControls.xaml" />
                <ResourceDictionary Source="/DevEnv;component/Themes/Launcher.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 系统工具叶子项（DataContext 是 LauncherEntry）：图标 + 名称。
                 必须先于使用它的分组样式定义，StaticResource 不支持向前引用。 -->
            <Style x:Key="SystemToolLeafMenuItem"
                   TargetType="MenuItem"
                   BasedOn="{StaticResource LauncherMenuItemStyle}">
                <Setter Property="Header" Value="{Binding}" />
                <Setter Property="ToolTip" Value="{Binding TargetPath}" />
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16"
                                       Height="16"
                                       Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasIcon, Converter={StaticResource TrueToVisibility}}" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Click" Handler="OnSystemToolMenuClick" />
            </Style>

            <!-- 系统工具菜单：分类子菜单（DataContext 是 LauncherSection） -->
            <Style x:Key="SystemToolGroupMenuItem"
                   TargetType="MenuItem"
                   BasedOn="{StaticResource LauncherMenuItemStyle}">
                <Setter Property="Header" Value="{Binding Title}" />
                <Setter Property="ItemsSource" Value="{Binding Entries}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource SystemToolLeafMenuItem}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部菜单栏：全部系统工具按分类收进「系统工具」 -->
        <Border Grid.Row="0"
                Background="{DynamicResource LauncherSurfaceBrush}"
                BorderBrush="{DynamicResource LauncherBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,3">
            <Menu x:Name="MainMenu"
                  VerticalAlignment="Center"
                  Style="{StaticResource LauncherMenuStyle}">
                <MenuItem x:Name="SystemToolsMenuItem"
                          Header="系统工具(_S)"
                          Style="{StaticResource LauncherTopLevelMenuItemStyle}"
                          ItemsSource="{Binding SystemToolMenus}"
                          ItemContainerStyle="{StaticResource SystemToolGroupMenuItem}" />
            </Menu>
        </Border>

        <Grid x:Name="Root" Grid.Row="1" Margin="12,0,12,0">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="刷新" Click="OnReloadMenu" />
                    <MenuItem Header="关闭启动器" Click="OnCloseMenu" />
                </ContextMenu>
            </Grid.ContextMenu>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" MinHeight="56" />
            </Grid.RowDefinitions>

            <Grid x:Name="PageContentHost" Grid.Row="0" Margin="0,12,0,0">
                <!-- 内置工具：上方分类标签，下方图标 -->
                <ScrollViewer x:Name="SectionScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="4,0,4,0"
                              Background="Transparent">
                    <ItemsControl x:Name="SectionGrid"
                                  ItemsSource="{Binding ToolSections}"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,2">
                                    <TextBlock Margin="8,0,8,2"
                                               Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource LauncherTextPrimaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding Entries}"
                                                  ItemTemplate="{StaticResource LauncherEntryTemplate}"
                                                  HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:CenteredWrapPanel ItemWidth="90" ItemHeight="100" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态（没有内置工具可显示） -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource TrueToVisibility}}">
                    <TextBlock Text="&#xE8A9;"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="40"
                               Foreground="{DynamicResource LauncherTextMutedBrush}" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Text="{Binding EmptyTitle}"
                               FontSize="15"
                               Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Text="{Binding EmptyHint}"
                               FontSize="12"
                               Foreground="{DynamicResource LauncherTextMutedBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,4,0,12"
                        HorizontalAlignment="Center">
                <TextBlock Margin="0,0,0,4"
                           HorizontalAlignment="Center"
                           Text="{Binding Notice}"
                           FontSize="12"
                           Foreground="{DynamicResource LauncherTextSecondaryBrush}"
                           Visibility="{Binding Notice, Converter={StaticResource NonEmptyString}}" />
                <TextBlock Margin="0,0,0,4"
                           HorizontalAlignment="Center"
                           Text="{Binding Summary}"
                           FontSize="12"
                           Foreground="{DynamicResource LauncherTextMutedBrush}"
                           Visibility="{Binding Summary, Converter={StaticResource NonEmptyString}}" />
                <TextBlock Margin="0,0,0,4"
                           HorizontalAlignment="Center"
                           Text="{Binding Message}"
                           FontSize="12"
                           Foreground="{DynamicResource LauncherDangerBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="640"
                           Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

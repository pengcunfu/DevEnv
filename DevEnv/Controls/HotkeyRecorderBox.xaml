<UserControl x:Class="DevEnv.Host.Controls.HotkeyRecorderBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" IsTabStop="True">
    <Border x:Name="RootBorder"
            Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="5"
            Padding="9,6" Cursor="Hand"
            MouseLeftButtonDown="OnMouseLeftButtonDown">
        <StackPanel>
            <TextBlock x:Name="ValueText" Text="未设置" FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="HintText" FontSize="11" Margin="0,3,0,0"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>

<UserControl x:Class="DevEnv.Host.Views.HotkeysSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DevEnv.Host.Controls"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Top">
    <StackPanel HorizontalAlignment="Stretch">
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="全局热键" Style="{DynamicResource SectionTitleStyle}" />
                <TextBlock Text="点击输入框后直接按下组合键；Esc 取消。快捷键至少包含 Ctrl、Alt、Win 之一。Win 组合键可能被系统优先处理，建议使用 Ctrl / Alt / Shift 组合。"
                           Style="{DynamicResource PageHintStyle}" TextWrapping="Wrap" />

                <TextBlock Text="显示主窗口" Style="{DynamicResource MutedTextStyle}" Margin="0,14,0,4" />
                <controls:HotkeyRecorderBox x:Name="ShowWindowRecorder" Width="260"
                                            HorizontalAlignment="Left" />

                <TextBlock Text="熔岩剪贴板" Style="{DynamicResource MutedTextStyle}" Margin="0,12,0,4" />
                <controls:HotkeyRecorderBox x:Name="ClipboardRecorder" Width="260"
                                            HorizontalAlignment="Left" />

                <TextBlock Text="熔岩翻译" Style="{DynamicResource MutedTextStyle}" Margin="0,12,0,4" />
                <controls:HotkeyRecorderBox x:Name="TranslatorRecorder" Width="260"
                                            HorizontalAlignment="Left" />

                <CheckBox x:Name="AltKeyLauncherCheck" Content="单独按一下左 Alt 键打开启动器"
                          Margin="0,16,0,0" />
                <TextBlock Text="左 Alt 是固定手势，只能启用或关闭；Alt+Tab / Alt+F4 / Alt+空格 等组合键不受影响。"
                           Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="语音输入与区域截屏" Style="{DynamicResource SectionTitleStyle}" />

                <TextBlock Text="语音输入" Style="{DynamicResource MutedTextStyle}" Margin="0,14,0,4" />
                <ComboBox x:Name="VoiceShortcutCombo" Width="260" HorizontalAlignment="Left" />

                <CheckBox x:Name="CaptureEnabledCheck" Content="启用区域截屏快捷键" Margin="0,14,0,6" />
                <TextBlock Text="区域截屏" Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,4" />
                <ComboBox x:Name="CaptureModifierCombo" Width="260" HorizontalAlignment="Left" />
                <CheckBox x:Name="AllowBareBacktickCheck"
                          Content="允许无修饰 ` 触发（兼容笔记本 Fn + `）"
                          Margin="0,8,0,4" />
                <TextBlock x:Name="CaptureHintText" Style="{DynamicResource MutedTextStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="文件快速预览" Style="{DynamicResource SectionTitleStyle}" />
                <TextBlock Text="仅在资源管理器前台且焦点不在输入框时生效；预览键与关闭键都只支持单键。"
                           Style="{DynamicResource PageHintStyle}" TextWrapping="Wrap" />

                <TextBlock Text="打开预览" Style="{DynamicResource MutedTextStyle}" Margin="0,14,0,4" />
                <ComboBox x:Name="PreviewOpenCombo" Width="200" HorizontalAlignment="Left" />

                <TextBlock Text="关闭预览" Style="{DynamicResource MutedTextStyle}" Margin="0,12,0,4" />
                <ComboBox x:Name="PreviewCloseCombo" Width="200" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal">
            <Button Content="保存" Width="96" Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveClick" />
            <Button Content="恢复默认" Margin="8,0,0,0" Click="OnResetClick" />
            <TextBlock x:Name="Message" Margin="12,0,0,0" VerticalAlignment="Center"
                       Style="{DynamicResource PageHintStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>

<UserControl x:Class="DevEnv.Host.Views.LavaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LavaViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:LavaViewModel />
    </UserControl.DataContext>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="熔岩" Style="{DynamicResource PageTitleStyle}" />
            <TextBlock Style="{DynamicResource PageHintStyle}">
                <TextBlock.Text>
                    <Binding Path="DataInfo.About.Tagline" FallbackValue="开源智能开发环境管理工具" />
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>

        <Border DockPanel.Dock="Top"
                Style="{StaticResource CardStyle}"
                Padding="8"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="应用目录" Margin="0,0,6,0" Command="{Binding OpenAppsDirectoryCommand}" />
                <Button Content="下载缓存" Margin="0,0,6,0" Command="{Binding OpenCacheDirectoryCommand}" />
                <Button Content="数据目录" Margin="0,0,6,0" Command="{Binding OpenDataRootCommand}" />
                <Button Content="环境变量" Margin="0,0,6,0" Command="{Binding OpenEnvironmentVariablesCommand}" />
                <Button Content="官方文档" Command="{Binding OpenDocsCommand}" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   Text="{Binding Message}"
                   Style="{DynamicResource PageHintStyle}" />

        <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- ============ 服务 ============ -->
            <TabItem Header="服务">
                <DataGrid ItemsSource="{Binding Services}" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="服务" Binding="{Binding DisplayName}" Width="2*" />
                        <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="2*" />
                        <DataGridTemplateColumn Header="状态" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="ExternalRunning">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NotConfigured">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="启动" Margin="0,0,6,0" Padding="10,3"
                                                IsEnabled="{Binding CanStart}"
                                                Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="停止" Margin="0,0,6,0" Padding="10,3"
                                                IsEnabled="{Binding CanStop}"
                                                Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="去下载" Padding="10,3"
                                                Foreground="{DynamicResource WarningBrush}"
                                                Visibility="{Binding NeedsInstall, Converter={StaticResource TrueToVisibility}}"
                                                Command="{Binding DataContext.GoToDownloadsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ============ 软件下载 ============ -->
            <TabItem Header="软件下载">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="200" Margin="0,0,8,0"
                                 Style="{StaticResource SearchBoxStyle}"
                                 Text="{Binding CatalogQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索软件" />
                        <ComboBox Width="150" Margin="0,0,8,0"
                                  ItemsSource="{Binding CatalogCategories}"
                                  SelectedItem="{Binding CatalogCategory}" />
                        <Button Content="重置" Margin="0,0,8,0" Command="{Binding ResetCatalogFilterCommand}" />
                        <TextBlock VerticalAlignment="Center" Style="{DynamicResource MutedTextStyle}">
                            <Run Text="活动" /><Run Text="{Binding ActiveDownloads.Count, Mode=OneWay}" />
                            <Run Text=" · 完成" /><Run Text="{Binding DownloadStats.Completed, Mode=OneWay}" />
                            <Run Text=" · 失败" /><Run Text="{Binding DownloadStats.Failed, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredCatalog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Category}" Style="{DynamicResource MutedTextStyle}" Margin="2,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Item.Description}" Style="{DynamicResource PageHintStyle}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ComboBox Width="120" Margin="0,0,8,0"
                                                                          ItemsSource="{Binding Versions}"
                                                                          SelectedValuePath="Version"
                                                                          DisplayMemberPath="Version"
                                                                          SelectedValue="{Binding SelectedVersion}" />
                                                                <Button Content="下载" Padding="14,4"
                                                                        Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ 活动下载 ============ -->
            <TabItem Header="活动下载">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="刷新" Margin="0,0,6,0" Command="{Binding RefreshDownloadsCommand}" />
                        <Button Content="打开缓存" Margin="0,0,6,0" Command="{Binding OpenCacheDirectoryCommand}" />
                        <Button Content="去下载软件" Command="{Binding SelectDownloadsTabCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ActiveDownloads}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="软件" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SoftwareName}" />
                                            <TextBlock Style="{DynamicResource MutedTextStyle}">
                                                <Run Text="{Binding Version}" /><Run Text=" · " /><Run Text="{Binding FileName}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding SizeText}" Style="{DynamicResource MutedTextStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="进度" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" />
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                                                       Style="{DynamicResource MutedTextStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="速度" Binding="{Binding SpeedText}" Width="100" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="140" />
                            <DataGridTemplateColumn Header="操作" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="取消"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ 下载历史 ============ -->
            <TabItem Header="下载历史">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="刷新" Margin="0,0,6,0" Command="{Binding RefreshDownloadsCommand}" />
                            <Button Content="打开缓存" Margin="0,0,6,0" Command="{Binding OpenCacheDirectoryCommand}" />
                            <Button Content="清除已完成" Margin="0,0,6,0" Command="{Binding ClearCompletedCommand}" />
                            <Button Content="清除失败" Margin="0,0,6,0" Command="{Binding ClearFailedCommand}" />
                            <Button Content="清空全部" Command="{Binding ClearAllCommand}" />
                        </StackPanel>
                        <Border Visibility="{Binding DownloadFilter, Converter={StaticResource NonEmptyString}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center">
                                    <Run Text="筛选：" /><Run Text="{Binding DownloadFilter, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="清除筛选" Margin="8,0,0,0" Padding="8,2"
                                        Command="{Binding ClearDownloadFilterCommand}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,8">
                            <Run Text="共" /><Run Text="{Binding DownloadStats.Total, Mode=OneWay}" />
                            <Run Text=" · 完成" /><Run Text="{Binding DownloadStats.Completed, Mode=OneWay}" />
                            <Run Text=" · 失败" /><Run Text="{Binding DownloadStats.Failed, Mode=OneWay}" />
                            <Run Text=" · 总量" /><Run Text="{Binding DownloadStats.TotalBytesText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding FilteredHistory}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="软件" Binding="{Binding SoftwareName}" Width="160" />
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="100" />
                            <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="220" />
                            <DataGridTextColumn Header="进度" Binding="{Binding Progress}" Width="70" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="120" />
                            <DataGridTextColumn Header="完成时间" Binding="{Binding EndTime}" Width="150" />
                            <DataGridTemplateColumn Header="操作" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="打开" Margin="0,0,6,0" Padding="8,2"
                                                    Visibility="{Binding CanOpen, Converter={StaticResource TrueToVisibility}}"
                                                    Command="{Binding DataContext.OpenDownloadedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="取消" Padding="8,2"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ 镜像 ============ -->
            <TabItem Header="镜像">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox Width="200" Margin="0,0,8,0"
                                  ItemsSource="{Binding MirrorTools}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Label"
                                  SelectedValue="{Binding SelectedMirrorTool}" />
                        <Button Content="刷新" Margin="0,0,6,0" Command="{Binding RefreshMirrorsCommand}" />
                        <Button Content="测试速度" Command="{Binding TestMirrorsCommand}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{DynamicResource PageHintStyle}">
                            <Run Text="当前：" /><Run Text="{Binding CurrentMirror, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Mirrors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Width="420" Margin="0,0,10,10">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock HorizontalAlignment="Right" Style="{DynamicResource PageHintStyle}">
                                                <Run Text="{Binding ResponseTimeMs, StringFormat={}{0:0} ms}" />
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{Binding Url}" Style="{DynamicResource MutedTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Content="使用此镜像" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.UseMirrorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </TabItem>

            <!-- ============ 扫描 ============ -->
            <TabItem Header="扫描">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="开始扫描" Command="{Binding ScanCommand}" />
                        <ItemsControl Margin="12,0,0,0" ItemsSource="{Binding ScanSummary}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="3"
                                            Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Style="{DynamicResource MutedTextStyle}">
                                            <Run Text="{Binding Key}" /><Run Text=": " /><Run Text="{Binding Count}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ScanResults}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="120" />
                            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="在 PATH" Binding="{Binding IsInPath}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ 数据目录 ============ -->
            <TabItem Header="数据目录">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="路径" Style="{DynamicResource SectionTitleStyle}" />
                                <TextBlock Style="{DynamicResource MonoTextStyle}"><Run Text="根目录: " /><Run Text="{Binding DataInfo.Root, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{DynamicResource MonoTextStyle}"><Run Text="运行时配置: " /><Run Text="{Binding DataInfo.ConfigFile, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{DynamicResource MonoTextStyle}"><Run Text="下载缓存: " /><Run Text="{Binding DataInfo.CacheDir, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{DynamicResource MonoTextStyle}"><Run Text="应用目录: " /><Run Text="{Binding DataInfo.AppsDir, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{DynamicResource MonoTextStyle}"><Run Text="下载历史: " /><Run Text="{Binding DataInfo.HistoryFile, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="当前配置" Style="{DynamicResource SectionTitleStyle}" />
                                <TextBlock><Run Text="自动解压: " /><Run Text="{Binding DataInfo.Settings.AutoExtractPortable, Mode=OneWay}" /></TextBlock>
                                <TextBlock><Run Text="最大重试: " /><Run Text="{Binding DataInfo.Settings.MaxRetries, Mode=OneWay}" /><Run Text=" 次" /></TextBlock>
                                <TextBlock><Run Text="连接超时: " /><Run Text="{Binding DataInfo.Settings.Timeout, Mode=OneWay}" /><Run Text=" 秒" /></TextBlock>
                                <TextBlock><Run Text="下载块大小: " /><Run Text="{Binding DataInfo.Settings.ChunkSizeMb, Mode=OneWay}" /><Run Text=" MB" /></TextBlock>
                                <TextBlock><Run Text="系统代理: " /><Run Text="{Binding DataInfo.Settings.UseSystemProxy, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding DataInfo.About.ProductName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DataInfo.About.Tagline}" Style="{DynamicResource PageHintStyle}" />
                                <TextBlock><Run Text="版本: " /><Run Text="{Binding DataInfo.About.Version, Mode=OneWay}" /></TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="官方文档" Margin="0,0,8,0" Padding="10,3" Command="{Binding OpenDocsCommand}" />
                                    <Button Content="GitHub" Padding="10,3" Command="{Binding OpenRepositoryCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
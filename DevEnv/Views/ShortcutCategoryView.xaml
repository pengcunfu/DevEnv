<UserControl x:Class="DevEnv.Host.Views.ShortcutCategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DevEnv.Host.Controls"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             PreviewKeyDown="OnPreviewKeyDown"
             Loaded="OnLoaded">
    <!-- 独立分类窗口的内容：本地应用 / 文件夹 / 网站 / 开始菜单各一个实例，
         由 ToolWindow 承载（普通非模态窗口，可最小化）。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevEnv;component/Themes/LauncherControls.xaml" />
                <ResourceDictionary Source="/DevEnv;component/Themes/Launcher.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource LauncherBackgroundBrush}">
        <Grid x:Name="Root"
              PreviewMouseLeftButtonDown="OnRootPreviewMouseLeftButtonDown"
              PreviewMouseMove="OnRootPreviewMouseMove"
              PreviewMouseLeftButtonUp="OnRootPreviewMouseLeftButtonUp">
            <Grid.ContextMenu>
                <ContextMenu x:Name="RootMenu" Opened="OnRootMenuOpened">
                    <MenuItem x:Name="AddAppMenu" Header="添加本地应用…" Click="OnAddAppMenu" />
                    <MenuItem x:Name="AddFolderMenu" Header="添加文件夹…" Click="OnAddFolderMenu" />
                    <MenuItem x:Name="AddWebMenu" Header="添加网站…" Click="OnAddWebMenu" />
                    <Separator x:Name="AddSeparator" />
                    <MenuItem x:Name="MergeSelectionMenu" Header="合并为文件夹…"
                              Click="OnMergeSelectionMenu" Visibility="Collapsed" />
                    <Separator x:Name="MergeSeparator" Visibility="Collapsed" />
                    <MenuItem Header="刷新" Click="OnReloadMenu" />
                </ContextMenu>
            </Grid.ContextMenu>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" MinHeight="56" />
            </Grid.RowDefinitions>

            <!-- 顶部搜索：只搜当前分类 -->
            <Border x:Name="SearchShell"
                    Grid.Row="0"
                    Height="36"
                    Margin="16,12,16,0"
                    Background="{DynamicResource LauncherSurfaceBrush}"
                    BorderBrush="{DynamicResource LauncherBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="10,0,6,0"
                               VerticalAlignment="Center"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Margin="0,0,8,0"
                             Style="{StaticResource LaunchpadSearchBox}"
                             FontSize="13"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <!-- 图标网格 + 空状态 + 框选层 -->
            <Grid x:Name="ContentHost" Grid.Row="1" Margin="16,12,16,0">
                <ScrollViewer x:Name="EntryScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="4,0,4,0"
                              Background="Transparent">
                    <ItemsControl x:Name="EntryGrid"
                                  ItemsSource="{Binding PageEntries}"
                                  ItemTemplate="{StaticResource LauncherEntryTemplate}"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:CenteredWrapPanel ItemWidth="90" ItemHeight="112" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态（本分类还没有内容） -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEmpty}" Value="True" />
                                        <Condition Binding="{Binding IsSearching}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE8A9;"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="40"
                               Foreground="{DynamicResource LauncherTextMutedBrush}" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Text="{Binding EmptyTitle}"
                               FontSize="15"
                               Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Text="{Binding EmptyHint}"
                               FontSize="12"
                               Foreground="{DynamicResource LauncherTextMutedBrush}" />
                </StackPanel>

                <!-- 空状态（搜索没有命中） -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEmpty}" Value="True" />
                                        <Condition Binding="{Binding IsSearching}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE721;"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="36"
                               Foreground="{DynamicResource LauncherTextMutedBrush}" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Text="没有找到匹配项"
                               FontSize="15"
                               Foreground="{DynamicResource LauncherTextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 底栏：状态提示 + 添加按钮 -->
            <Grid Grid.Row="2" Margin="0,4,0,12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,0,4"
                               HorizontalAlignment="Center"
                               Text="{Binding Notice}"
                               FontSize="12"
                               Foreground="{DynamicResource LauncherTextSecondaryBrush}"
                               Visibility="{Binding Notice, Converter={StaticResource NonEmptyString}}" />
                    <TextBlock Margin="0,0,0,4"
                               HorizontalAlignment="Center"
                               Text="{Binding Summary}"
                               FontSize="12"
                               Foreground="{DynamicResource LauncherTextMutedBrush}"
                               Visibility="{Binding Summary, Converter={StaticResource NonEmptyString}}" />
                    <TextBlock Margin="0,0,0,4"
                               HorizontalAlignment="Center"
                               Text="{Binding Message}"
                               FontSize="12"
                               Foreground="{DynamicResource LauncherDangerBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="640"
                               Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}" />
                </StackPanel>

                <Button Margin="0,0,20,4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource LaunchpadCircleButton}"
                        ToolTip="添加当前分类的快捷方式"
                        Visibility="{Binding CanAddOnCurrentPage, Converter={StaticResource TrueToVisibility}}"
                        Click="OnAddClick">
                    <TextBlock Text="&#xE710;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <!-- 启动器文件夹浮层：铺满整个视图，卡片居中；点卡片外空白或 Esc 收起 -->
            <Grid x:Name="GroupLayer"
                  Grid.Row="0"
                  Grid.RowSpan="3"
                  Visibility="{Binding IsInsideGroup, Converter={StaticResource TrueToVisibility}}">
                <Border x:Name="GroupDim" Background="{DynamicResource LauncherScrimBrush}" />
                <Border x:Name="FolderCard"
                        MinWidth="240"
                        MaxWidth="480"
                        MaxHeight="520"
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource LauncherCardBrush}"
                        BorderBrush="{DynamicResource LauncherBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,12,14,10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28"
                                          ShadowDepth="0"
                                          Opacity="0.22"
                                          Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding CurrentGroup.Name}"
                                       FontSize="15"
                                       Foreground="{DynamicResource LauncherTextPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Summary}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource LauncherTextMutedBrush}" />
                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Text="点击空白处或按 Esc 关闭"
                                       FontSize="11"
                                       Foreground="{DynamicResource LauncherTextMutedBrush}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      MaxHeight="400"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Center"
                                      Background="Transparent">
                            <ItemsControl x:Name="GroupGrid"
                                          ItemsSource="{Binding VisibleEntries}"
                                          ItemTemplate="{StaticResource LauncherEntryTemplate}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:CenteredWrapPanel ItemWidth="90" ItemHeight="112" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 框选矩形与拖拽落点提示；不参与命中测试 -->
            <Canvas x:Name="SelectionLayer"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    IsHitTestVisible="False"
                    ClipToBounds="True">
                <Rectangle x:Name="SelectionRect"
                           Visibility="Collapsed"
                           Fill="{DynamicResource LauncherAccentFaintBrush}"
                           Stroke="{DynamicResource LauncherAccentBrush}"
                           StrokeThickness="1.5" />
                <Border x:Name="DropHighlight"
                        Visibility="Collapsed"
                        Background="{DynamicResource LauncherAccentFaintBrush}"
                        BorderBrush="{DynamicResource LauncherAccentBrush}"
                        BorderThickness="2"
                        CornerRadius="16" />
                <Rectangle x:Name="InsertionBar"
                           Width="3"
                           Height="110"
                           RadiusX="1.5"
                           RadiusY="1.5"
                           Fill="{DynamicResource LauncherAccentBrush}"
                           Visibility="Collapsed" />
            </Canvas>
        </Grid>
    </Border>
</UserControl>

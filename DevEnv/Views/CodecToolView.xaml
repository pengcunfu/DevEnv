<UserControl x:Class="DevEnv.Host.Views.CodecToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:CodecToolViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:CodecToolViewModel />
    </UserControl.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource ChromeBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="0,0,0,1">
            <MenuItem Header="编码(_E)" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="Base64 编解码" Command="{Binding OpenBase64Command}" />
                <MenuItem Header="URL 编解码" Command="{Binding OpenUrlCommand}" />
                <MenuItem Header="Hex 编解码" Command="{Binding OpenHexCommand}" />
                <MenuItem Header="Unicode 编解码" Command="{Binding OpenUnicodeCommand}" />
                <MenuItem Header="HTML 编解码" Command="{Binding OpenHtmlCommand}" />
            </MenuItem>
            <MenuItem Header="解码(_D)" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="Base64 编解码" Command="{Binding OpenBase64Command}" />
                <MenuItem Header="URL 编解码" Command="{Binding OpenUrlCommand}" />
                <MenuItem Header="Hex 编解码" Command="{Binding OpenHexCommand}" />
                <MenuItem Header="Unicode 编解码" Command="{Binding OpenUnicodeCommand}" />
                <MenuItem Header="HTML 编解码" Command="{Binding OpenHtmlCommand}" />
            </MenuItem>
            <MenuItem Header="加密(_C)" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="AES 加解密" Command="{Binding OpenAesCommand}" />
                <MenuItem Header="XOR 加解密" Command="{Binding OpenXorCommand}" />
            </MenuItem>
            <MenuItem Header="解密(_Y)" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="AES 加解密" Command="{Binding OpenAesCommand}" />
                <MenuItem Header="XOR 加解密" Command="{Binding OpenXorCommand}" />
            </MenuItem>
            <MenuItem Header="哈希(_H)" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="哈希计算" Command="{Binding OpenHashCommand}" />
            </MenuItem>
            <MenuItem Header="时间工具(_I)" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="Unix 时间戳" Command="{Binding OpenTimeCommand}" />
            </MenuItem>
            <MenuItem Header="帮助(_P)" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="关于(_A)" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <Grid>
            <TextBlock Text="从顶部菜单打开一项工具"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{DynamicResource MutedTextStyle}"
                       Visibility="{Binding HasTabs, Converter={StaticResource FalseToVisibility}}" />

            <TabControl ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        Visibility="{Binding HasTabs, Converter={StaticResource TrueToVisibility}}"
                        Margin="8,6,8,8">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="✕"
                                    Padding="4,0"
                                    MinWidth="18"
                                    MinHeight="18"
                                    FontSize="11"
                                    ToolTip="关闭"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:CodecTabViewModel}">
                        <DockPanel Margin="4,8,4,0">
                            <!-- 选项区 -->
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <GroupBox Header="模式"
                                          Margin="0,0,10,8"
                                          Padding="8,4"
                                          Visibility="{Binding ShowsBase64Modes, Converter={StaticResource TrueToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="文本" Margin="0,0,12,0"
                                                     IsChecked="{Binding ModeIndex, Converter={StaticResource IntEquals}, ConverterParameter=0}" />
                                        <RadioButton Content="图片" Margin="0,0,12,0"
                                                     IsChecked="{Binding ModeIndex, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
                                        <RadioButton Content="二进制文件"
                                                     IsChecked="{Binding ModeIndex, Converter={StaticResource IntEquals}, ConverterParameter=2}" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="文本编码方式"
                                          Margin="0,0,10,8"
                                          Padding="8,4"
                                          Visibility="{Binding ShowsEncoding, Converter={StaticResource TrueToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="编码：" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox Width="120"
                                                  ItemsSource="{Binding TextEncodings}"
                                                  SelectedItem="{Binding TextEncoding}" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="哈希算法"
                                          Margin="0,0,10,8"
                                          Padding="8,4"
                                          Visibility="{Binding ShowsHashAlgorithm, Converter={StaticResource TrueToVisibility}}">
                                    <ComboBox Width="120"
                                              ItemsSource="{Binding HashAlgorithms}"
                                              SelectedItem="{Binding HashAlgorithm}" />
                                </GroupBox>

                                <GroupBox Header="密钥"
                                          Margin="0,0,10,8"
                                          Padding="8,4"
                                          Visibility="{Binding ShowsPassword, Converter={StaticResource TrueToVisibility}}">
                                    <TextBox Width="200"
                                             Tag="输入密钥"
                                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                                </GroupBox>

                                <GroupBox Header="时间选项"
                                          Margin="0,0,10,8"
                                          Padding="8,4"
                                          Visibility="{Binding ShowsTimeOptions, Converter={StaticResource TrueToVisibility}}">
                                    <CheckBox Content="使用毫秒时间戳"
                                              IsChecked="{Binding UseMilliseconds}" />
                                </GroupBox>

                                <Button Content="选择文件…"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding IsFileMode, Converter={StaticResource TrueToVisibility}}"
                                        Command="{Binding PickFileCommand}" />
                            </WrapPanel>

                            <!-- 底部按钮 -->
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button MinWidth="96" Margin="0,0,8,0" Padding="12,6"
                                        Visibility="{Binding ShowsPrimaryPair, Converter={StaticResource TrueToVisibility}}"
                                        Content="{Binding PrimaryLabel}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding RunPrimaryCommand}" />
                                <Button MinWidth="96" Margin="0,0,8,0" Padding="12,6"
                                        Visibility="{Binding ShowsPrimaryPair, Converter={StaticResource TrueToVisibility}}"
                                        Content="{Binding SecondaryLabel}"
                                        Command="{Binding RunSecondaryCommand}" />

                                <Button MinWidth="96" Margin="0,0,8,0" Padding="12,6"
                                        Visibility="{Binding ShowsHashActions, Converter={StaticResource TrueToVisibility}}"
                                        Content="计算哈希 ↓"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding RunHashCommand}" />

                                <Button MinWidth="96" Margin="0,0,8,0" Padding="12,6"
                                        Visibility="{Binding ShowsTimeActions, Converter={StaticResource TrueToVisibility}}"
                                        Content="戳 → 时间"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding TimeToDateCommand}" />
                                <Button MinWidth="96" Margin="0,0,8,0" Padding="12,6"
                                        Visibility="{Binding ShowsTimeActions, Converter={StaticResource TrueToVisibility}}"
                                        Content="时间 → 戳"
                                        Command="{Binding TimeToUnixCommand}" />
                                <Button MinWidth="96" Margin="0,0,8,0" Padding="12,6"
                                        Visibility="{Binding ShowsTimeActions, Converter={StaticResource TrueToVisibility}}"
                                        Content="当前时间"
                                        Command="{Binding TimeNowCommand}" />

                                <Button MinWidth="80" Margin="0,0,8,0" Padding="12,6"
                                        Content="交换"
                                        Command="{Binding SwapCommand}" />
                                <Button MinWidth="80" Margin="0,0,8,0" Padding="12,6"
                                        Content="清空"
                                        Command="{Binding ClearCommand}" />
                                <Button MinWidth="88" Margin="0,0,8,0" Padding="12,6"
                                        Content="复制输入"
                                        Command="{Binding CopyInputCommand}" />
                                <Button MinWidth="88" Padding="12,6"
                                        Content="复制输出"
                                        Command="{Binding CopyOutputCommand}" />
                            </WrapPanel>

                            <!-- 输入 / 输出 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0">
                                    <TextBlock DockPanel.Dock="Top" Text="输入" Margin="0,0,0,4" FontWeight="SemiBold" />
                                    <TextBox AcceptsReturn="True"
                                             AcceptsTab="True"
                                             VerticalContentAlignment="Top"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             Tag="{Binding InputHint}"
                                             Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="输出" Margin="0,0,0,4" FontWeight="SemiBold" />
                                    <TextBox AcceptsReturn="True"
                                             AcceptsTab="True"
                                             VerticalContentAlignment="Top"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             Tag="{Binding OutputHint}"
                                             Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>

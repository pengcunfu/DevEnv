<UserControl x:Class="DevEnv.Host.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProcessesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:ProcessesViewModel />
    </UserControl.DataContext>

    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox Width="220" Margin="0,0,8,0"
                     Style="{StaticResource SearchBoxStyle}"
                     Tag="搜索进程名 / PID / 路径"
                     ToolTip="搜索进程名 / PID / 路径"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="120" Margin="0,0,8,0"
                      Tag="排序方式"
                      ItemsSource="{Binding SortModes}"
                      SelectedItem="{Binding Sort}" />
            <Button Content="暂停" Margin="0,0,8,0" Command="{Binding TogglePauseCommand}" />
            <Button Content="立即刷新" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
            <Button Content="结束进程" Margin="0,0,8,0"
                    IsEnabled="{Binding HasSelection}"
                    Command="{Binding KillCommand}" />
            <Button Content="结束进程树" Margin="0,0,8,0"
                    IsEnabled="{Binding HasSelection}"
                    Command="{Binding KillTreeCommand}" />
            <Button Content="打开目录"
                    IsEnabled="{Binding HasSelection}"
                    Command="{Binding OpenFolderCommand}" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,6"
                   Text="{Binding Message}"
                   Foreground="{DynamicResource DangerBrush}"
                   Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}" />

        <DataGrid x:Name="ProcessGrid"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  ToolTip="双击行查看进程详情"
                  PreviewMouseLeftButtonDown="OnGridPreviewMouseDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="进程" Binding="{Binding DisplayName}" Width="2*" />
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="80" />
                <DataGridTextColumn Header="内存" Binding="{Binding MemoryText}" Width="90" />
                <DataGridTextColumn Header="线程" Binding="{Binding ThreadCount}" Width="60" />
                <DataGridTextColumn Header="路径" Binding="{Binding PathText}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="10,6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock>
                    <Run Text="进程数: " /><Run Text="{Binding ProcessCount, Mode=OneWay}" />
                    <Run Text="  |  " /><Run Text="{Binding StatusHint, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="24,0,0,0">
                    <Run Text="工作集合计: " /><Run Text="{Binding TotalMemoryText, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Margin="24,0,0,0">
                    <Run Text="更新于 " /><Run Text="{Binding Timestamp, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
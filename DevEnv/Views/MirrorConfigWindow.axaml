<Window x:Class="DevEnv.Views.MirrorConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="镜像源配置" Height="580" Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="配置各语言/包管理器的国内镜像源，支持测速与一键应用"
                   Foreground="Gray" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="工具类型:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Name="CmbToolType" Width="180" SelectionChanged="CmbToolType_SelectionChanged"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="可用镜像源" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox Name="MirrorList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Name="TxtCurrentMirror" Margin="0,10,0,10" TextWrapping="Wrap"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F0F0F0" BorderBrush="#D1D1D1" BorderThickness="0,1,0,0" Padding="8,4" VerticalAlignment="Center">
                <TextBlock Name="TxtStatus" Text="就绪"/>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="测试速度" Width="90" Height="30" Margin="0,0,8,0" Click="BtnTest_Click"/>
                <Button Content="应用配置" Width="90" Height="30" IsDefault="True" Click="BtnApply_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>


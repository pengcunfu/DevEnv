<UserControl x:Class="DevEnv.Host.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:SettingsViewModel />
    </UserControl.DataContext>

    <!-- 只提供内容，不自带 ScrollViewer：
         设置对话框的页签统一负责滚动，避免嵌套出现双滚动条。 -->
    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="常规选项" Style="{DynamicResource PageTitleStyle}" />
                    <TextBlock Text="托盘、自启、主题与快捷键等全局选项（与 data.json 的 Config 段对齐）" Style="{DynamicResource PageHintStyle}" />

                    <CheckBox Content="显示托盘图标" Margin="0,14,0,0" IsChecked="{Binding Config.TrayIcon}" />
                    <CheckBox Content="开机自启动" Margin="0,8,0,0" IsChecked="{Binding Config.SelfStarting}" />
                    <CheckBox Content="深色模式" Margin="0,8,0,0" IsChecked="{Binding Config.DarkMode}" />
                    <TextBlock Text="显示窗口、快捷应用、语音、截屏与文件预览快捷键统一在「快捷键」页签管理。"
                               Style="{DynamicResource MutedTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <TextBlock Text="环境根目录" Style="{DynamicResource MutedTextStyle}" Margin="0,14,0,0" />
                    <TextBox Tag="环境根目录路径"
                             Text="{Binding Config.BaseEnvPath, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="默认翻译引擎" Style="{DynamicResource MutedTextStyle}" Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200" Margin="0,0,8,0"
                                  Tag="默认翻译引擎"
                                  ItemsSource="{Binding Sites}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedSiteId}" />
                        <Button Content="设为默认" Margin="0,0,8,0" Command="{Binding PickDefaultSiteCommand}" />
                        <Button Content="打开翻译窗" Command="{Binding OpenTranslatorWindowCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="保存" Width="96" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SaveCommand}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding Message}" Style="{DynamicResource PageHintStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="检查更新" Style="{DynamicResource SectionTitleStyle}" />
                    <TextBlock Style="{DynamicResource PageHintStyle}">
                        <Run Text="当前版本 " /><Run Text="{Binding Update.CurrentVersion, Mode=OneWay}" />
                    </TextBlock>

                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="检查更新" Margin="0,0,8,0" Command="{Binding CheckUpdateCommand}" />
                        <Button Content="下载更新" Margin="0,0,8,0"
                                Visibility="{Binding Update.PendingVersion, Converter={StaticResource NonEmptyString}}"
                                IsEnabled="{Binding Update.Downloading, Converter={StaticResource FalseToVisibility}}"
                                Command="{Binding DownloadUpdateCommand}" />
                        <Button Content="重启并应用" Style="{StaticResource AccentButtonStyle}"
                                Visibility="{Binding Update.Downloading, Converter={StaticResource FalseToVisibility}}"
                                Command="{Binding ApplyUpdateCommand}" />
                    </WrapPanel>

                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding Update.Downloading, Converter={StaticResource TrueToVisibility}}">
                        <ProgressBar Value="{Binding Update.DownloadProgress, Mode=OneWay}" Maximum="100" />
                        <TextBlock Text="{Binding Update.DownloadProgress, StringFormat={}{0}%}"
                                   Style="{DynamicResource MutedTextStyle}" Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding UpdateMessage}"
                               Style="{DynamicResource PageHintStyle}"
                               Visibility="{Binding UpdateMessage, Converter={StaticResource NonEmptyString}}" />
                </StackPanel>
            </Border>
        </StackPanel>
</UserControl>
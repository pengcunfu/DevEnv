<UserControl x:Class="DevEnv.Host.Views.FileToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:FileToolViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AllowDrop="True">
    <UserControl.DataContext>
        <vm:FileToolViewModel />
    </UserControl.DataContext>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="文件解锁与粉碎" Style="{DynamicResource PageTitleStyle}" />
            <TextBlock Text="定位占用文件的进程，或用随机数据覆盖后彻底删除文件" Style="{DynamicResource PageHintStyle}" />
        </StackPanel>

        <TabControl x:Name="Tabs" SelectedIndex="0" AllowDrop="True">
            <!-- ============ 解除占用 ============ -->
            <TabItem Header="解除占用">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,8">
                            <TextBox Width="420" Margin="0,0,8,0"
                                     Style="{StaticResource SearchBoxStyle}"
                                     Tag="选择或输入文件 / 文件夹路径"
                                     Text="{Binding LockPath, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnLockPathKeyDown" />
                            <Button Content="浏览文件…" Margin="0,0,8,0" Command="{Binding PickLockFileCommand}" />
                            <Button Content="浏览文件夹…" Margin="0,0,8,0" Command="{Binding PickLockFolderCommand}" />
                            <Button Content="检测占用" Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{Binding CanScan}"
                                    Command="{Binding ScanLockCommand}" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding IsElevated, Converter={StaticResource FalseToVisibility}}">
                            <TextBlock Text="当前为普通权限，部分系统进程可能检测不到或无法结束。"
                                       Style="{DynamicResource MutedTextStyle}"
                                       VerticalAlignment="Center" />
                            <Button Content="以管理员身份重启" Margin="8,0,0,0"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding RestartElevatedCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding LockMessage}"
                                   Style="{DynamicResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding LockMessage, Converter={StaticResource NonEmptyString}}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="结束所选进程" Margin="0,0,8,0"
                                IsEnabled="{Binding HasLockSelection}"
                                Command="{Binding EndLockProcessCommand}"
                                CommandParameter="{Binding SelectedLock}" />
                        <Button Content="结束全部可结束进程"
                                IsEnabled="{Binding HasLockProcesses}"
                                Command="{Binding EndAllLockProcessesCommand}" />
                    </StackPanel>

                    <Grid>
                        <DataGrid ItemsSource="{Binding LockProcesses}"
                                  SelectedItem="{Binding SelectedLock, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                                <DataGridTextColumn Header="类型" Binding="{Binding AppTypeText}" Width="100" />
                                <DataGridTextColumn Header="启动时间" Binding="{Binding StartTimeText}" Width="140" />
                                <DataGridTextColumn Header="路径" Binding="{Binding PathText}" Width="3*" />
                                <DataGridTemplateColumn Header="操作" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="结束"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    IsEnabled="{Binding CanEnd}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.EndLockProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="选择文件或文件夹后点击「检测占用」"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Style="{DynamicResource MutedTextStyle}"
                                   Visibility="{Binding LockProcesses.Count, Converter={StaticResource NoItems}}" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============ 文件粉碎 ============ -->
            <TabItem Header="文件粉碎">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="添加文件…" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanEditShredList}"
                                    Command="{Binding PickShredFilesCommand}" />
                            <Button Content="添加文件夹…" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanEditShredList}"
                                    Command="{Binding PickShredFolderCommand}" />
                            <TextBox Width="300" Margin="0,0,8,0"
                                     Style="{StaticResource SearchBoxStyle}"
                                     Tag="输入完整路径后回车"
                                     IsEnabled="{Binding CanEditShredList}"
                                     Text="{Binding ShredInput, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnShredInputKeyDown" />
                            <Button Content="添加路径"
                                    IsEnabled="{Binding CanEditShredList}"
                                    Command="{Binding AddShredInputCommand}" />
                        </WrapPanel>

                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="覆盖遍数" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Style="{DynamicResource MutedTextStyle}" />
                            <ComboBox Width="140" Margin="0,0,16,0"
                                      Tag="覆盖遍数"
                                      IsEnabled="{Binding CanEditShredList}"
                                      ItemsSource="{Binding PassOptions}"
                                      SelectedIndex="{Binding PassIndex}" />
                            <TextBlock Text="{Binding ShredSummary}" VerticalAlignment="Center"
                                       Style="{DynamicResource MutedTextStyle}" />
                        </WrapPanel>

                        <TextBlock Text="粉碎只能用随机数据覆盖文件后再删除，无法恢复。SSD 的 TRIM / 磨损均衡、文件系统日志和云盘同步可能在其他位置保留副本。"
                                   Style="{DynamicResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="{Binding ShredMessage}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding ShredMessage, Converter={StaticResource NonEmptyString}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShredHasError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <ProgressBar Value="{Binding ShredPercent}" Maximum="100"
                                     Visibility="{Binding IsShredding, Converter={StaticResource TrueToVisibility}}" />
                        <TextBlock Text="{Binding ShredStatus}"
                                   Margin="0,4,0,0"
                                   Style="{DynamicResource MutedTextStyle}"
                                   Visibility="{Binding ShredStatus, Converter={StaticResource NonEmptyString}}" />

                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="移除所选" Margin="0,0,8,0"
                                    IsEnabled="{Binding HasShredSelection}"
                                    Command="{Binding RemoveShredEntryCommand}"
                                    CommandParameter="{Binding SelectedShred}" />
                            <Button Content="清空列表" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanEditShredList}"
                                    Command="{Binding ClearShredEntriesCommand}" />
                            <Button Content="开始粉碎" Margin="0,0,8,0"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{Binding CanStartShred}"
                                    Command="{Binding StartShredCommand}" />
                            <Button Content="取消"
                                    IsEnabled="{Binding CanCancelShred}"
                                    Command="{Binding CancelShredCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <Grid>
                        <DataGrid ItemsSource="{Binding ShredEntries}"
                                  SelectedItem="{Binding SelectedShred, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditShredList}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="70" />
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90" />
                                <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="3*" />
                                <DataGridTemplateColumn Header="操作" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="移除"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    IsEnabled="{Binding DataContext.CanEditShredList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.RemoveShredEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="拖入文件或文件夹，或点击上方按钮添加"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Style="{DynamicResource MutedTextStyle}"
                                   Visibility="{Binding ShredEntries.Count, Converter={StaticResource NoItems}}" />
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

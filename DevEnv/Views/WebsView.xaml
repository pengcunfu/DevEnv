<UserControl x:Class="DevEnv.Host.Views.WebsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
            
             d:DataContext="{d:DesignInstance Type=vm:WebsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>

        <ContextMenu x:Key="CardMenu">
            <MenuItem Header="在浏览器中打开" Tag="open" Click="OnCardMenuClick" />
            <MenuItem Header="编辑标题与图标" Tag="rename" Click="OnCardMenuClick" />
            <MenuItem Header="刷新图标" Tag="refreshIcon" Click="OnCardMenuClick" />
            <Separator />
            <MenuItem Header="移除" Tag="remove" Click="OnCardMenuClick" />
        </ContextMenu>

        <ContextMenu x:Key="EmptyMenu">
            <MenuItem Header="添加网站…" Tag="add" Click="OnCardMenuClick" />
            <MenuItem Header="刷新" Tag="reload" Click="OnCardMenuClick" />
        </ContextMenu>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:WebsViewModel />
    </UserControl.DataContext>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Items.Count, Converter={StaticResource HasItems}}">
            <ItemsControl ItemsSource="{Binding Items}"
                          ContextMenu="{StaticResource EmptyMenu}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ShortcutCardStyle}"
                                ContextMenu="{StaticResource CardMenu}"
                                ToolTip="{Binding Url}">
                            <Button Style="{StaticResource CardBodyStyle}"
                                    MouseLeftButtonUp="OnCardMouseUp"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CardIconStyle}">
                                        <Grid>
                                            <Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                                   Width="22" Height="22" Stretch="Uniform" />
                                            <TextBlock Text="WEB"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IconPath, Converter={StaticResource EmptyString}}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,6,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Text="{Binding Name}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="40" />
                                </Grid>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Style="{StaticResource CardStyle}"
                Width="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ContextMenu="{StaticResource EmptyMenu}"
                Visibility="{Binding Items.Count, Converter={StaticResource NoItems}}">
            <StackPanel>
                <TextBlock Text="暂无快捷网站" HorizontalAlignment="Center" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding EmptyHint}"
                           Style="{DynamicResource PageHintStyle}"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>

        <TextBlock Margin="12"
                   VerticalAlignment="Top"
                   Text="{Binding Message}"
                   Style="{DynamicResource ErrorTextStyle}" />
    </Grid>
</UserControl>
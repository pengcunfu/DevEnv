<UserControl x:Class="DevEnv.Host.Views.HostsToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             xmlns:local="clr-namespace:DevEnv.Host.Views"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=vm:HostsToolViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:HostsToolViewModel />
    </UserControl.DataContext>

    <DockPanel Margin="12,10,12,0">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Hosts 文件编辑器" Style="{DynamicResource PageTitleStyle}" />
            <TextBlock Style="{DynamicResource PageHintStyle}" Margin="0,2,0,0">
                <Run Text="{Binding Path, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Message, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <local:HostsEditorView x:Name="Editor"
                               Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <local:HostsEditorView.FooterActions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="保存"
                            MinWidth="80"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding DataContext.CanWrite, ElementName=Root}"
                            Click="OnSaveClick" />
                    <Button Content="重新加载"
                            MinWidth="80"
                            Padding="14,5"
                            Click="OnReloadClick" />
                </StackPanel>
            </local:HostsEditorView.FooterActions>
        </local:HostsEditorView>
    </DockPanel>
</UserControl>

<UserControl x:Class="DevEnv.Host.Views.DiskCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DiskCleanerViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:DiskCleanerViewModel />
    </UserControl.DataContext>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="C 盘清理" Style="{DynamicResource PageTitleStyle}" />
            <TextBlock Text="扫描临时文件、系统缓存、浏览器缓存与回收站，勾选后一键清理"
                       Style="{DynamicResource PageHintStyle}" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="C 盘空间" Style="{DynamicResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding DriveHint}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{DynamicResource MutedTextStyle}" />
                </DockPanel>
                <TextBlock Text="{Binding DriveSummary}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,2,0,8" />
                <ProgressBar Value="{Binding DriveUsedPercent}" Maximum="100" Height="8" />
            </StackPanel>
        </Border>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="扫描 C 盘" Margin="0,0,8,0"
                    Command="{Binding ScanCommand}" />
            <Button Content="清理所选" Margin="0,0,8,0"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding CleanCommand}" />
            <Button Content="全选" Margin="0,0,8,0"
                    Command="{Binding SelectAllCommand}" />
            <Button Content="全不选" Margin="0,0,8,0"
                    Command="{Binding ClearSelectionCommand}" />
            <Button Content="取消" Margin="0,0,12,0"
                    Command="{Binding CancelCommand}" />
            <TextBlock Text="{Binding SelectedSummary}"
                       VerticalAlignment="Center"
                       Style="{DynamicResource MutedTextStyle}" />
        </WrapPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"
                    Visibility="{Binding IsElevated, Converter={StaticResource FalseToVisibility}}">
            <TextBlock Text="当前为普通权限，Windows 临时文件、更新缓存与预读取文件可能无法删除。"
                       Style="{DynamicResource MutedTextStyle}"
                       VerticalAlignment="Center" />
            <Button Content="以管理员身份重启" Margin="8,0,0,0"
                    Style="{StaticResource LinkButtonStyle}"
                    Command="{Binding RestartElevatedCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ProgressBar Value="{Binding ProgressPercent}"
                         Maximum="100"
                         Height="6"
                         IsIndeterminate="{Binding IsScanning}" />
            <TextBlock Text="{Binding StatusText}"
                       Margin="0,4,0,0"
                       Style="{DynamicResource MutedTextStyle}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Targets}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Description}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="选择" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      IsEnabled="{Binding DataContext.CanScan, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="清理项" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="88" />

                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="92">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="文件数" Binding="{Binding FileCountText}" Width="78">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="权限" Binding="{Binding PermissionText}" Width="78" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100" />
                <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

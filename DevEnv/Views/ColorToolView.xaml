<UserControl x:Class="DevEnv.Host.Views.ColorToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ColorToolViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:ColorToolViewModel />
    </UserControl.DataContext>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="颜色工具" Style="{DynamicResource PageTitleStyle}" />
            <TextBlock Text="HEX / RGB / HSL 互转，滑杆调色并生成同色系明暗色板"
                       Style="{DynamicResource PageHintStyle}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <Border Height="132" CornerRadius="6" Margin="0,0,0,12"
                            Background="{Binding PreviewBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" />

                    <TextBlock Text="HEX 输入" Style="{DynamicResource SectionTitleStyle}" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="应用" Margin="8,0,0,0"
                                Command="{Binding ApplyHexCommand}" />
                        <TextBox Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 KeyDown="OnHexKeyDown" />
                    </DockPanel>
                    <TextBlock Text="支持 #RRGGBB、#AARRGGBB、rgb() 与 hsl()"
                               Style="{DynamicResource MutedTextStyle}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Red, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding Red}" TextAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="G" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Green, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding Green}" TextAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="B" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Blue, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding Blue}" TextAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="A" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Alpha, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding Alpha}" TextAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>

                    <Button Content="随机颜色" Command="{Binding RandomColorCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="颜色值" Style="{DynamicResource SectionTitleStyle}" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HEX" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding HexText}" Style="{DynamicResource MonoTextStyle}" />
                            <Button Grid.Column="2" Content="复制" Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding CopyHexCommand}" />
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RGB" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding RgbText}" Style="{DynamicResource MonoTextStyle}" />
                            <Button Grid.Column="2" Content="复制" Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding CopyRgbCommand}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HSL" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding HslText}" Style="{DynamicResource MonoTextStyle}" />
                            <Button Grid.Column="2" Content="复制" Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding CopyHslCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding Error}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Error, Converter={StaticResource NonEmptyString}}" />
                        <TextBlock Text="{Binding Message}"
                                   Style="{DynamicResource MutedTextStyle}"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="同色系色板（点击选用）" Style="{DynamicResource SectionTitleStyle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Palette}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="52" Height="52" Margin="0,0,8,8" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTip="{Binding Hex}"
                                            Command="{Binding DataContext.UseColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Hex}">
                                        <Border Background="{Binding Brush}" CornerRadius="6" Margin="2" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>

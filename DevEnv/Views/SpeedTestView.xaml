<UserControl x:Class="DevEnv.Host.Views.SpeedTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SpeedTestViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:SpeedTestViewModel />
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="16">
        <Border Style="{StaticResource CardStyle}"
                MaxWidth="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="28,24">
            <StackPanel>
                <!-- 标题区 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE9A6;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Margin="0,2,10,0"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="网络测速"
                               Style="{DynamicResource PageTitleStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="测量延迟、下载与上传速度，节点会在公共测速服务器之间自动切换。"
                           Style="{DynamicResource PageHintStyle}"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap" />

                <!-- 操作区 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <Button Content="{Binding PrimaryActionText}"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="112"
                            Padding="16,8"
                            Margin="0,0,10,0"
                            Command="{Binding StartSpeedTestCommand}"
                            IsEnabled="{Binding CanStart}" />
                    <Button Content="取消"
                            MinWidth="80"
                            Padding="14,8"
                            Command="{Binding CancelSpeedTestCommand}"
                            IsEnabled="{Binding CanCancel}" />
                </StackPanel>

                <!-- 空闲提示 -->
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,20"
                        Visibility="{Binding ShowsIdleHint, Converter={StaticResource TrueToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="点击「开始测速」即可开始"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="测速过程会短暂占用带宽，建议关闭正在下载的任务。"
                                   Style="{DynamicResource MutedTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 进行中：阶段 + 进度 -->
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,20"
                        Visibility="{Binding ShowsProgress, Converter={StaticResource TrueToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Ellipse Width="10" Height="10" Margin="0,0,0,6"
                                         Fill="{DynamicResource AccentBrush}"
                                         Opacity="{Binding IsPingPhase, Converter={StaticResource BoolToOpacity}}" />
                                <TextBlock Text="延迟"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <Ellipse Width="10" Height="10" Margin="0,0,0,6"
                                         Fill="{DynamicResource AccentBrush}"
                                         Opacity="{Binding IsDownloadPhase, Converter={StaticResource BoolToOpacity}}" />
                                <TextBlock Text="下载"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Ellipse Width="10" Height="10" Margin="0,0,0,6"
                                         Fill="{DynamicResource AccentBrush}"
                                         Opacity="{Binding IsUploadPhase, Converter={StaticResource BoolToOpacity}}" />
                                <TextBlock Text="上传"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding ProgressPercentText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PhaseLabel}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ProgressBar Height="8"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding SpeedProgress.OverallPercent, Mode=OneWay}" />

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding SpeedProgress.CurrentSpeedText, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding SpeedProgress.Message, Mode=OneWay}"
                                       Style="{DynamicResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,12,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 四格指标：底色用 SurfaceAlt，避免嵌套白卡糊成一片 -->
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,8,0"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="下载"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding DownloadDisplay}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,8,0"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="上传"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding UploadDisplay}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,8,0"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="延迟"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding PingDisplay}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="抖动"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding JitterDisplay}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="{Binding ServerSummary}"
                           Style="{DynamicResource MutedTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />

                <TextBlock Text="{Binding SpeedError}"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="{Binding SpeedError, Converter={StaticResource NonEmptyString}}" />
                <TextBlock Text="{Binding Message}"
                           Style="{DynamicResource PageHintStyle}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

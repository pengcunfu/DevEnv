<Window x:Class="DevEnv.Views.HashCalculatorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x6587;&#x4EF6;&#x54C8;&#x5E0C;&#x8BA1;&#x7B97;&#x5668;"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        MinHeight="400" MinWidth="600"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ControlTheme x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="4"/>
        </ControlTheme>

        <ControlTheme x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D1D1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </ControlTheme>

        <ControlTheme x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D1D1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </ControlTheme>

        <ControlTheme x:Key="ResultBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#D1D1D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </ControlTheme>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,15" x:Name="MainTabControl">
            <TabItem Header="&#x1F4C1; &#x6587;&#x4EF6;&#x54C8;&#x5E0C;" x:Name="FileHashTab">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Theme="{StaticResource ResultBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Theme="{StaticResource ModernTextBoxStyle}"
                                     x:Name="FilePathTextBox"
                                     Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True"
                                     VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="&#x1F4C2; &#x6D4F;&#x89C8;"
                                    Theme="{StaticResource ModernButtonStyle}"
                                    Command="{Binding BrowseFileCommand}"/>

                            <Button Grid.Column="2"
                                    Content="&#x1F4CB; &#x7C98;&#x8D34;&#x6587;&#x4EF6;&#x8DEF;&#x5F84;"
                                    Theme="{StaticResource ModernButtonStyle}"
                                    Command="{Binding PastePathCommand}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="&#x9009;&#x62E9;&#x54C8;&#x5E0C;&#x7B97;&#x6CD5;:" FontWeight="Bold" Margin="5"/>
                            <ComboBox Theme="{StaticResource ModernComboBoxStyle}"
                                      x:Name="HashTypeComboBox"
                                      SelectedItem="{Binding SelectedHashType}">
                                <ComboBoxItem Content="MD5"/>
                                <ComboBoxItem Content="SHA-1"/>
                                <ComboBoxItem Content="SHA-256"/>
                                <ComboBoxItem Content="SHA-384"/>
                                <ComboBoxItem Content="SHA-512"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="&#x8BA1;&#x7B97;&#x64CD;&#x4F5C;:" FontWeight="Bold" Margin="5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="&#x1F522; &#x8BA1;&#x7B97;&#x54C8;&#x5E0C;"
                                        Theme="{StaticResource ModernButtonStyle}"
                                        Command="{Binding CalculateHashCommand}"/>

                                <Button Grid.Column="1"
                                        Content="&#x1F522; &#x5168;&#x90E8;&#x7B97;&#x6CD5;"
                                        Theme="{StaticResource ModernButtonStyle}"
                                        Command="{Binding CalculateAllHashesCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Theme="{StaticResource ResultBorderStyle}"
                            Margin="0,10,0,0"
                            DragDrop.AllowDrop="True"
                            DragDrop.Drop="Border_Drop"
                            DragDrop.DragOver="Border_DragOver"
                            DragDrop.DragLeave="Border_DragLeave">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F4C1;"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Opacity="0.5"/>
                            <TextBlock Text="&#x62D6;&#x62FD;&#x6587;&#x4EF6;&#x5230;&#x6B64;&#x5904;"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       Opacity="0.6"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="&#x1F4DD; &#x6587;&#x672C;&#x54C8;&#x5E0C;" x:Name="TextHashTab">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="&#x8F93;&#x5165;&#x6587;&#x672C;&#x5185;&#x5BB9;:" FontWeight="Bold" Margin="5"/>
                    <TextBox Grid.Row="1"
                             Theme="{StaticResource ModernTextBoxStyle}"
                             x:Name="TextInputTextBox"
                             Text="{Binding TextInput, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="150"/>

                    <Button Grid.Row="2"
                            Content="&#x1F522; &#x8BA1;&#x7B97;&#x6587;&#x672C;&#x54C8;&#x5E0C;"
                            Theme="{StaticResource ModernButtonStyle}"
                            Command="{Binding CalculateTextHashCommand}"
                            Margin="5,10,5,5"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" x:Name="ProgressGrid" IsVisible="False" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="0"
                         Height="20"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Progress}"/>

            <TextBlock Grid.Row="1"
                       Text="{Binding ProgressText}"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding HashResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Theme="{StaticResource ResultBorderStyle}" Margin="0,5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding Algorithm}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Margin="0,0,0,5"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding Hash}"
                                             IsReadOnly="True"
                                             Background="White"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             VerticalAlignment="Center"
                                             Margin="0,0,5,0"/>

                                    <Button Grid.Column="1"
                                            Content="&#x1F4CB; &#x590D;&#x5236;"
                                            Theme="{StaticResource ModernButtonStyle}"
                                            Command="{Binding DataContext.CopyHashCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Hash}"/>
                                </Grid>

                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            Margin="0,5,0,0"
                                            Opacity="0.7">
                                    <TextBlock Text="&#x6587;&#x4EF6;&#x5927;&#x5C0F;: "/>
                                    <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"/>
                                    <TextBlock Text="  |  " Margin="10,0,10,0"/>
                                    <TextBlock Text="&#x8BA1;&#x7B97;&#x7528;&#x65F6;: "/>
                                    <TextBlock Text="{Binding CalculationTime, StringFormat='{}{0:fff} ms'}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Margin="0,15,0,0" Background="#F0F0F0" BorderBrush="#D1D1D1" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}"/>
        </Border>
    </Grid>
</Window>

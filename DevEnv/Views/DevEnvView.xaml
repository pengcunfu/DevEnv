<UserControl x:Class="DevEnv.Host.Views.DevEnvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DevEnvViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:DevEnvViewModel />
    </UserControl.DataContext>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStyle}" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="添加服务" Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding AddServiceCommand}" />
                <Button Content="刷新" Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ReloadCommand}" />
            </StackPanel>
        </Border>

        <!-- 无消息时不占位，避免顶部多出一条空隙 -->
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,6"
                   Text="{Binding Message}"
                   Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}"
                   Style="{DynamicResource PageHintStyle}" />

        <Grid>
            <DataGrid ItemsSource="{Binding Services}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="服务" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StartCommand}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding StartCommand}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="工作目录" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WorkingDirectory}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding WorkingDirectory}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100" />
                    <DataGridTemplateColumn Header="操作" Width="300">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="启动" Margin="0,0,6,0" Padding="9,3"
                                            IsEnabled="{Binding CanStart}"
                                            Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="停止" Margin="0,0,6,0" Padding="9,3"
                                            IsEnabled="{Binding CanStop}"
                                            Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="编辑" Margin="0,0,6,0" Padding="9,3"
                                            Command="{Binding DataContext.EditServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="目录" Margin="0,0,6,0" Padding="9,3"
                                            Command="{Binding DataContext.OpenDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="移除" Padding="9,3"
                                            Foreground="{DynamicResource DangerBrush}"
                                            Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="还没有服务，点「添加服务」配一个要常驻的后台进程。"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Style="{DynamicResource PageHintStyle}"
                       Visibility="{Binding Services.Count, Converter={StaticResource NoItems}}" />
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="DevEnv.Host.Views.DevEnvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DevEnvViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:DevEnvViewModel />
    </UserControl.DataContext>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="开发环境" Style="{DynamicResource PageTitleStyle}" />
            <TextBlock Text="本机 MySQL / Redis / PostgreSQL 进程启停。绿色版请用「熔岩环境」。"
                       Style="{DynamicResource PageHintStyle}" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="环境根目录 (BaseEnvPath)" Style="{DynamicResource MutedTextStyle}" />
                <TextBlock Text="{Binding Config.BaseEnvPath}" Style="{DynamicResource MonoTextStyle}" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   Text="{Binding Message}"
                   Style="{DynamicResource PageHintStyle}" />

        <DataGrid ItemsSource="{Binding Services}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="服务" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{DynamicResource MutedTextStyle}" />
                                <TextBlock Text="{Binding InstallPath}" Style="{DynamicResource MonoTextStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100" />
                <DataGridTemplateColumn Header="操作" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="启动" Margin="0,0,6,0" Padding="10,3"
                                        IsEnabled="{Binding CanStart}"
                                        Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="停止" Margin="0,0,6,0" Padding="10,3"
                                        IsEnabled="{Binding CanStop}"
                                        Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="数据目录" Padding="10,3"
                                        Command="{Binding DataContext.OpenDataCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
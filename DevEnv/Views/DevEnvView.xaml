<UserControl x:Class="DevEnv.Host.Views.DevEnvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DevEnvViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:DevEnvViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Running}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource ChromeBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="0,0,0,1">
            <MenuItem Header="服务(_S)" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="添加服务(_A)" Command="{Binding AddServiceCommand}" />
                <MenuItem Header="刷新(_R)" Command="{Binding ReloadCommand}" />
                <MenuItem Header="日志目录(_L)" Command="{Binding OpenLogsDirectoryCommand}" />
            </MenuItem>
            <MenuItem Header="视图(_V)" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="表格视图(_T)" Command="{Binding ShowTableViewCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="✓"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding IsTableView, Converter={StaticResource TrueToVisibility}}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="卡片视图(_C)" Command="{Binding ShowCardViewCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="✓"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding IsCardView, Converter={StaticResource TrueToVisibility}}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid Margin="12">
            <!-- 表格视图 -->
            <DataGrid ItemsSource="{Binding Services}"
                      Visibility="{Binding IsTableView, Converter={StaticResource TrueToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="服务" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding StartCommand}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding StartCommand}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="工作目录" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WorkingDirectory}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding WorkingDirectory}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="状态" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Style="{StaticResource StatusDotStyle}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="340">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="启动" Margin="0,0,6,0" Padding="9,3"
                                            IsEnabled="{Binding CanStart}"
                                            Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="停止" Margin="0,0,6,0" Padding="9,3"
                                            IsEnabled="{Binding CanStop}"
                                            Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="日志" Margin="0,0,6,0" Padding="9,3"
                                            Command="{Binding DataContext.OpenLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="编辑" Margin="0,0,6,0" Padding="9,3"
                                            Command="{Binding DataContext.EditServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="目录" Margin="0,0,6,0" Padding="9,3"
                                            Command="{Binding DataContext.OpenDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="移除" Padding="9,3"
                                            Foreground="{DynamicResource DangerBrush}"
                                            Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 卡片视图 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsCardView, Converter={StaticResource TrueToVisibility}}">
                <ItemsControl ItemsSource="{Binding Services}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="340" Margin="0,0,12,12" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource StatusDotStyle}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding StartCommand}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding StartCommand}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding WorkingDirectory}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding WorkingDirectory}" />

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="启动" Margin="0,0,6,6" Padding="9,3"
                                                IsEnabled="{Binding CanStart}"
                                                Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="停止" Margin="0,0,6,6" Padding="9,3"
                                                IsEnabled="{Binding CanStop}"
                                                Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="日志" Margin="0,0,6,6" Padding="9,3"
                                                Command="{Binding DataContext.OpenLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="编辑" Margin="0,0,6,6" Padding="9,3"
                                                Command="{Binding DataContext.EditServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="目录" Margin="0,0,6,6" Padding="9,3"
                                                Command="{Binding DataContext.OpenDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="移除" Margin="0,0,6,6" Padding="9,3"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="还没有服务，从「服务 → 添加服务」配一个要常驻的后台进程。"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Style="{DynamicResource PageHintStyle}"
                       Visibility="{Binding Services.Count, Converter={StaticResource NoItems}}" />
        </Grid>
    </DockPanel>
</UserControl>

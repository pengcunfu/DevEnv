<UserControl x:Class="DevEnv.Host.Views.HostsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <DockPanel>
        <!-- 校验状态条：正常时只占一行，有问题时可展开逐条定位 -->
        <Border DockPanel.Dock="Bottom"
                Style="{StaticResource CardStyle}"
                Padding="10,7"
                Margin="0,8,0,0">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="ToggleIssuesButton"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource LinkButtonStyle}"
                            Visibility="Collapsed"
                            Click="OnToggleIssuesClick"
                            Content="查看问题" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" FontSize="12" />
                        <TextBlock x:Name="CountText" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource MutedTextStyle}" />
                    </StackPanel>
                </DockPanel>

                <ListBox x:Name="IssueList"
                         Margin="0,6,0,0"
                         MaxHeight="120"
                         Visibility="Collapsed"
                         SelectionChanged="OnIssueSelected">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="6,3" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LineLabel}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Message}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <TextBox x:Name="Editor"
                 FontFamily="Consolas"
                 FontSize="13"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 SpellCheck.IsEnabled="False"
                 Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </DockPanel>
</UserControl>

<UserControl x:Class="DevEnv.Host.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevEnv.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:NetworkViewModel />
    </UserControl.DataContext>

    <DockPanel Margin="14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="网络监控" Style="{DynamicResource PageTitleStyle}" />
                <TextBlock Text="连接流量 · 端口管理 · 一键测速" Style="{DynamicResource PageHintStyle}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Content="管理员重启" Command="{Binding RestartElevatedCommand}" />
        </Grid>

        <TabControl x:Name="Tabs" SelectedIndex="0">
            <!-- ============ 流量 ============ -->
            <TabItem Header="流量">
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Width="260" Margin="0,0,8,0"
                                 Style="{StaticResource SearchBoxStyle}"
                                 ToolTip="搜索进程"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="暂停" Margin="0,0,8,0" Command="{Binding TogglePauseCommand}" />
                        <Button Content="立即刷新" Command="{Binding RefreshSnapshotCommand}" />
                    </WrapPanel>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="10,6" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock>
                                <Run Text="连接: " /><Run Text="{Binding TotalConnections, Mode=OneWay}" />
                                <Run Text="  |  " /><Run Text="{Binding StatusHint, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="24,0,0,0">
                                <Run Text="总下载: " /><Run Text="{Binding TotalDownload, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Margin="24,0,0,0">
                                <Run Text="总上传: " /><Run Text="{Binding TotalUpload, Mode=OneWay}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" Margin="0,0,10,0"
                                  ItemsSource="{Binding Processes}"
                                  SelectedItem="{Binding SelectedProcess, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="进程" Binding="{Binding DisplayName}" Width="2*" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                                <DataGridTextColumn Header="连接" Binding="{Binding ConnectionCount}" Width="60" />
                                <DataGridTextColumn Header="下载" Binding="{Binding DownloadRateText}" Width="90" />
                                <DataGridTextColumn Header="上传" Binding="{Binding UploadRateText}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="12,10"
                                           Text="连接详情" Style="{DynamicResource SectionTitleStyle}" />
                                <TextBlock DockPanel.Dock="Top" Margin="12,0,12,6"
                                           Style="{DynamicResource PageHintStyle}">
                                    <Run Text="{Binding SelectedProcess.DisplayName, Mode=OneWay}" />
                                    <Run Text=" (PID " /><Run Text="{Binding SelectedProcess.ProcessId, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                                <DataGrid ItemsSource="{Binding SelectedConnections}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="60" />
                                        <DataGridTextColumn Header="本地" Binding="{Binding LocalEndpoint}" Width="*" />
                                        <DataGridTextColumn Header="远程" Binding="{Binding RemoteEndpoint}" Width="*" />
                                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============ 端口 ============ -->
            <TabItem Header="端口">
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Width="260" Margin="0,0,8,0"
                                 Style="{StaticResource SearchBoxStyle}"
                                 ToolTip="搜索端口 / 进程"
                                 Text="{Binding PortQuery, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="刷新" Command="{Binding RefreshPortsCommand}" />
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding FilteredPorts}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="70" />
                            <DataGridTextColumn Header="本地" Binding="{Binding LocalEndpoint}" Width="*" />
                            <DataGridTextColumn Header="远程" Binding="{Binding RemoteEndpoint}" Width="*" />
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110" />
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                            <DataGridTemplateColumn Header="操作" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="结束"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Command="{Binding DataContext.KillPortProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ 测速 ============ -->
            <TabItem Header="测速">
                <Border Style="{StaticResource CardStyle}" Width="520" Margin="0,16,0,0"
                        HorizontalAlignment="Center" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="开始测速" Margin="0,0,8,0" Command="{Binding StartSpeedTestCommand}" />
                            <Button Content="取消" Command="{Binding CancelSpeedTestCommand}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding SpeedRunning, Converter={StaticResource TrueToVisibility}}">
                            <TextBlock Style="{DynamicResource PageHintStyle}">
                                <Run Text="{Binding SpeedProgress.Message, Mode=OneWay}" />
                                <Run Text="{Binding SpeedProgress.Phase, Mode=OneWay}" />
                            </TextBlock>
                            <ProgressBar Height="6" Margin="0,6,0,4" Minimum="0" Maximum="1"
                                         Value="{Binding SpeedProgress.OverallPercent, Mode=OneWay}" />
                            <TextBlock Text="{Binding SpeedProgress.CurrentSpeedText, Mode=OneWay}"
                                       Style="{DynamicResource MutedTextStyle}" />
                        </StackPanel>
                        <Grid Margin="0,12,0,0"
                              Visibility="{Binding SpeedResult, Converter={StaticResource TrueToVisibility}}">
                            <StackPanel>
                                <TextBlock><Run Text="下载 " /><Run Text="{Binding SpeedResult.DownloadText, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" /></TextBlock>
                                <TextBlock><Run Text="上传 " /><Run Text="{Binding SpeedResult.UploadText, Mode=OneWay}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" /></TextBlock>
                                <TextBlock><Run Text="延迟 " /><Run Text="{Binding SpeedResult.PingText, Mode=OneWay}" /></TextBlock>
                                <TextBlock><Run Text="抖动 " /><Run Text="{Binding SpeedResult.JitterText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{DynamicResource MutedTextStyle}" Margin="0,6,0,0">
                                    <Run Text="{Binding SpeedResult.ServerName, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding SpeedResult.DurationText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding SpeedError}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding SpeedError, Converter={StaticResource NonEmptyString}}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding Message}"
                                   Style="{DynamicResource PageHintStyle}"
                                   Visibility="{Binding Message, Converter={StaticResource NonEmptyString}}" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
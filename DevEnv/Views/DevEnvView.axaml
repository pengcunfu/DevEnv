<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:DevEnv.Converters"
             xmlns:app="using:DevEnv"
             x:Class="DevEnv.Views.DevEnvView"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>

        <ControlTheme x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </ControlTheme>

        <ControlTheme x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </ControlTheme>

        <ControlTheme x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </ControlTheme>

        <ControlTheme x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </ControlTheme>

        <ControlTheme x:Key="InstallButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.footer-link">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.footer-link:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.toolbar-nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="Button.toolbar-nav:pressed">
            <Setter Property="Background" Value="{DynamicResource ActiveNavBrush}"/>
        </Style>
        <Style Selector="Border.process-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static app:AppInfo.ProductShortName}"
                               FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="绿色版开发环境 · 进程管理 · 免管理员权限"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="toolbar-nav" Content="软件下载" Theme="{StaticResource ToolbarButton}"
                                Click="OpenSoftwareDownloader_Click"/>
                        <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="2,0"/>
                        <Button Classes="toolbar-nav" Content="下载管理" Theme="{StaticResource ToolbarButton}"
                                Click="OpenDownloadManager_Click"/>
                        <Button Classes="toolbar-nav" Content="环境扫描" Theme="{StaticResource ToolbarButton}"
                                Click="OpenEnvironmentScanner_Click"/>
                        <Button Classes="toolbar-nav" Content="镜像配置" Theme="{StaticResource ToolbarButton}"
                                Click="OpenMirrorConfig_Click"/>
                        <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="2,0"/>
                        <Button x:Name="ToolsMenuButton"
                                Classes="toolbar-nav"
                                Content="工具 ▾"
                                Theme="{StaticResource ToolbarButton}"
                                Margin="0"
                                Click="ToolsMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="环境变量" Click="OpenEnvironmentVariables_Click"/>
                                    <MenuItem Header="应用目录" Click="OpenAppsDir_Click"/>
                                    <MenuItem Header="数据目录" Click="OpenSettings_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 进程列表 -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,10">
            <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="本地服务" FontSize="13"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="下载绿色包后解压到应用目录即可启停"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="10,6" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="120,*,140,128">
                        <TextBlock Grid.Column="0" Text="程序" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="说明" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="状态" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="操作" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Processes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="process-row"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="120,*,140,128">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Description}"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,8,0"
                                                   ToolTip.Tip="{Binding Description}"/>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                     Fill="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11" FontWeight="Medium"
                                                       Foreground="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="108"
                                                       ToolTip.Tip="{Binding StatusText}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="6">
                                            <Button Content="启动"
                                                    Theme="{StaticResource StartButton}"
                                                    Click="StartProcess_Click"
                                                    Tag="{Binding}"
                                                    IsVisible="{Binding CanStart}"/>
                                            <Button Content="停止"
                                                    Theme="{StaticResource StopButton}"
                                                    Click="StopProcess_Click"
                                                    Tag="{Binding}"
                                                    IsVisible="{Binding CanStop}"/>
                                            <Button Content="去下载"
                                                    Theme="{StaticResource InstallButton}"
                                                    Click="OpenSoftwareDownload_Click"
                                                    IsVisible="{Binding NeedsInstall}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="无需管理员权限 · 绿色版解压即用 · 进程方式启动"
                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Classes="footer-link"
                       HorizontalAlignment="Left"
                       Text="官方文档"
                       Tapped="OpenDocs_Click"
                       ToolTip.Tip="在浏览器中打开帮助文档"/>
            <TextBlock Classes="footer-link"
                       HorizontalAlignment="Right"
                       Text="{Binding AppVersion, StringFormat=v{0}}"
                       Tapped="Version_Click"
                       ToolTip.Tip="点击查看关于"/>
        </Grid>
    </Grid>
</UserControl>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- shadcn/ui zinc · Light -->
  <Color x:Key="BackgroundColor">#FFFFFF</Color>
  <Color x:Key="ForegroundColor">#09090B</Color>
  <Color x:Key="CardColor">#FFFFFF</Color>
  <Color x:Key="MutedColor">#F4F4F5</Color>
  <Color x:Key="MutedForegroundColor">#71717A</Color>
  <Color x:Key="BorderColor">#E4E4E7</Color>
  <Color x:Key="PrimaryColor">#18181B</Color>
  <Color x:Key="PrimaryForegroundColor">#FAFAFA</Color>
  <Color x:Key="SecondaryColor">#F4F4F5</Color>
  <Color x:Key="SecondaryForegroundColor">#18181B</Color>
  <Color x:Key="AccentColor">#F4F4F5</Color>
  <Color x:Key="AccentForegroundColor">#18181B</Color>
  <Color x:Key="DestructiveColor">#DC2626</Color>
  <Color x:Key="DestructiveForegroundColor">#FAFAFA</Color>
  <Color x:Key="RingColor">#18181B</Color>
  <Color x:Key="HoverColor">#F4F4F5</Color>
  <Color x:Key="ActiveNavColor">#E4E4E7</Color>
  <Color x:Key="SuccessColor">#16A34A</Color>
  <Color x:Key="WarningColor">#CA8A04</Color>
  <Color x:Key="IconBackgroundColor">#F4F4F5</Color>
  <Color x:Key="PrimaryLightColor">#3F3F46</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
  <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource CardColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ForegroundColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource MutedForegroundColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
  <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}"/>
  <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
  <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
  <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}"/>
  <SolidColorBrush x:Key="DestructiveBrush" Color="{StaticResource DestructiveColor}"/>
  <SolidColorBrush x:Key="DestructiveForegroundBrush" Color="{StaticResource DestructiveForegroundColor}"/>
  <SolidColorBrush x:Key="RingBrush" Color="{StaticResource RingColor}"/>
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
  <SolidColorBrush x:Key="ActiveNavBrush" Color="{StaticResource ActiveNavColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="IconBackgroundBrush" Color="{StaticResource IconBackgroundColor}"/>

  <!-- Translator / legacy aliases -->
  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BackgroundColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ForegroundColor}"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource MutedForegroundColor}"/>
  <SolidColorBrush x:Key="BorderBrushKey" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#D4D4D8"/>
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#27272A"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#09090B"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource PrimaryForegroundColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DestructiveColor}"/>

  <!-- Density -->
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">6</CornerRadius>
  <CornerRadius x:Key="RadiusLg">8</CornerRadius>
  <x:Double x:Key="ControlHeight">32</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeSm">12</x:Double>
  <x:Double x:Key="TabItemHeaderFontSize">13</x:Double>
  <Thickness x:Key="TabItemHeaderMargin">6,0,6,0</Thickness>
  <x:Double x:Key="TabItemMinHeight">32</x:Double>
  <FontWeight x:Key="TabItemHeaderThemeFontWeight">Normal</FontWeight>
  <x:Double x:Key="ScrollBarSize">8</x:Double>
  <x:Double x:Key="ScrollBarButtonArrowIconFontSize">6</x:Double>
</ResourceDictionary>

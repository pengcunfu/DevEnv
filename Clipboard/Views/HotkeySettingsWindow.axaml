<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClipboardApp.Views.HotkeySettingsWindow"
        Title="全局快捷键设置"
        Height="300" Width="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BackgroundBrush}">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
    <TextBlock Grid.Row="0" Text="设置用于唤起剪贴板 Tab 的全局快捷键"
               FontSize="15" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
    <TextBlock Grid.Row="1" Text="直接按下你想要的快捷键组合，支持 Ctrl、Alt、Shift、Win 等修饰键"
               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
               TextWrapping="Wrap" Margin="0,0,0,16"/>

    <DockPanel Grid.Row="2" Margin="0,0,0,12">
      <TextBlock Text="快捷键：" VerticalAlignment="Center" FontWeight="SemiBold" Width="70"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBox x:Name="HotkeyBox"
               IsReadOnly="True"
               Height="48"
               FontSize="16"
               FontWeight="SemiBold"
               Padding="12,0"
               KeyDown="HotkeyBox_OnKeyDown"/>
    </DockPanel>

    <TextBlock Grid.Row="3" x:Name="PreviewLabel" Margin="0,0,0,8"
               Foreground="{DynamicResource TextSecondaryBrush}"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="清除快捷键" Classes="outline" Padding="12,6" Click="ClearButton_OnClick"/>
    </StackPanel>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Spacing="8">
      <Button Content="确定" Width="90" Height="32" Click="OkButton_OnClick"/>
      <Button Content="取消" Classes="outline" Width="90" Height="32" Click="CancelButton_OnClick"/>
    </StackPanel>
  </Grid>
</Window>

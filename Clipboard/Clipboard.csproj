<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ClipboardApp</RootNamespace>
    <AssemblyName>Clipboard</AssemblyName>
    <Version>1.3.5</Version>
    <FileVersion>1.3.5</FileVersion>
    <InformationalVersion>1.3.5</InformationalVersion>
    <Company>Fireneb-炎序星图</Company>
    <Product>Clipboard</Product>
    <Copyright>Copyright © 2026 Fireneb-炎序星图</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!-- Avalonia / 独立入口已退役：只保留 Models / Services 供 DevBox.Api 使用 -->
  <ItemGroup>
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="Program.cs" />
    <Compile Remove="AssemblyInfo.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="GlobalUsings.cs" />
    <Compile Remove="GlobalUsings.Avalonia.cs" />
    <Compile Remove="Dialogs\**" />
    <Compile Remove="Views\**" />
    <Compile Remove="UI\**" />
    <Compile Remove="Services\HotkeyService.cs" />
    <Compile Remove="Services\UpdateService.cs" />
    <Compile Remove="Services\Updater.cs" />
    <Compile Remove="Services\AutostartService.cs" />
    <Compile Remove="Services\CodeHighlighter.cs" />
    <Page Remove="**\*.xaml" />
    <None Remove="App.xaml" />
    <None Remove="MainWindow.xaml" />
    <None Remove="Dialogs\**\*.xaml" />
    <None Remove="Views\**" />
    <None Remove="**\*.axaml" />
    <None Remove="Assets\**" />
  </ItemGroup>

</Project>

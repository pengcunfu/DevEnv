<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevEnv</RootNamespace>
    <!-- Must differ from Host AssemblyName DevEnv (exe); NuGet rejects duplicate project names. -->
    <AssemblyName>LavaEnv</AssemblyName>
    <Version>1.0.0</Version>
    <Product>熔岩环境管理工具</Product>
    <AssemblyTitle>熔岩环境管理工具</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- ImageSharp 4.x 需商业许可；改用 Apache-2.0 的 Magick.NET -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude root icon.*: Host already ships Resources/icon.ico|png; NETSDK1152 on publish otherwise. -->
    <Content Include="Resources\**\*" Exclude="Resources\icon.ico;Resources\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProcessWatch.Views.ProcessWatchView"
             FontSize="13"
             Background="{DynamicResource BackgroundBrush}">
  <Border Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto"
          TextElement.Foreground="{DynamicResource ForegroundBrush}">
      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock Text="进程监控" FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBlock Text="实时查看本机进程的 CPU、内存占用"
                   Classes="muted" Margin="0,4,0,0"/>
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,0,0,12" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="搜索进程名 / PID / 路径…"
                 Margin="0,0,12,0" TextChanged="SearchBox_TextChanged"/>
        <ComboBox x:Name="SortComboBox" Grid.Column="1" Width="120" Margin="0,0,12,0"
                  SelectionChanged="SortComboBox_SelectionChanged">
          <ComboBoxItem Content="按 CPU" Tag="Cpu" IsSelected="True"/>
          <ComboBoxItem Content="按内存" Tag="Memory"/>
          <ComboBoxItem Content="按名称" Tag="Name"/>
        </ComboBox>
        <Button x:Name="PauseButton" Grid.Column="2" Content="暂停" Classes="outline"
                Margin="0,0,8,0" Click="PauseButton_Click"/>
        <Button x:Name="RefreshButton" Grid.Column="3" Content="立即刷新" Classes="outline"
                Margin="0,0,8,0" Click="RefreshButton_Click"/>
        <Button x:Name="KillButton" Grid.Column="4" Content="结束进程" Classes="outline"
                Margin="0,0,8,0" Click="KillButton_Click" IsEnabled="False"/>
        <Button x:Name="KillTreeButton" Grid.Column="5" Content="结束进程树" Classes="outline"
                Margin="0,0,8,0" Click="KillTreeButton_Click" IsEnabled="False"/>
        <Button x:Name="OpenFolderButton" Grid.Column="6" Content="打开目录" Classes="outline"
                Click="OpenFolderButton_Click" IsEnabled="False"/>
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="1.6*,8,*">
        <Border Grid.Column="0" Classes="Card" Padding="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="进程列表" FontWeight="SemiBold" Margin="4,4,4,8"/>
            <DataGrid x:Name="ProcessGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      SelectionChanged="ProcessGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="进程" Binding="{Binding DisplayName}" Width="1.2*"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/>
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="80"/>
                <DataGridTextColumn Header="内存" Binding="{Binding MemoryText}" Width="90"/>
                <DataGridTextColumn Header="线程" Binding="{Binding ThreadCount}" Width="60"/>
                <DataGridTextColumn Header="路径" Binding="{Binding PathText}" Width="2*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Classes="Card" Padding="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="进程详情" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ScrollViewer>
              <StackPanel Spacing="6">
                <TextBlock x:Name="DetailNameText" FontWeight="SemiBold" TextWrapping="Wrap" Text="未选择进程"/>
                <TextBlock x:Name="DetailPidText" Classes="muted"/>
                <TextBlock x:Name="DetailPathText" Classes="muted" TextWrapping="Wrap"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4"/>
                <TextBlock x:Name="DetailCpuText"/>
                <TextBlock x:Name="DetailMemoryText"/>
                <TextBlock x:Name="DetailPrivateText"/>
                <TextBlock x:Name="DetailVirtualText"/>
                <TextBlock x:Name="DetailThreadsText"/>
                <TextBlock x:Name="DetailHandlesText"/>
                <TextBlock x:Name="DetailStartText"/>
                <TextBlock x:Name="DetailRespondingText"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <Border Grid.Row="3" Classes="Card" Margin="0,12,0,0" Padding="12,10">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock x:Name="StatusText" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0">
            <TextBlock Text="工作集合计: " Classes="muted"/>
            <TextBlock x:Name="TotalMemoryText" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock x:Name="UpdateTimeText" Grid.Column="2" Classes="muted" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>

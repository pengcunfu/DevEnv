{
  "name": "devenv-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "check-links": "python scripts/check_links.py",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1",
    "deploy:skip-build": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -SkipBuild"
  },
  "dependencies": {
    "@unhead/vue": "^1.11.20",
    "vue": "^3.5.34",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-container": "^4.0.0",
    "vite": "^5.4.21",
    "vite-ssg": "^0.24.3",
    "wrangler": "^4.40.0"
  }
}

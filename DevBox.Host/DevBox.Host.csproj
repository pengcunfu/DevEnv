<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DevBox.Host</RootNamespace>
    <AssemblyName>DevBox</AssemblyName>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>程序盒子</Product>
    <Company>FNSoftware</Company>
    <Copyright>© 2026 FNSoftware. All rights reserved.</Copyright>
    <Authors>FNSoftware</Authors>
    <Description>Windows 上的开发环境管理工具：多语言运行时切换、系统工具快捷入口、本地/Web 应用与服务集中管理。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/pengcunfu/DevBox.Net</RepositoryUrl>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WebView2 package also ships Wpf.dll which pulls WindowsBase 5.x; WinForms host only needs WinForms. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevBox.Api\DevBox.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\icons\win\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

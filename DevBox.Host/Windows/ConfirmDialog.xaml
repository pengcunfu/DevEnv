<Window x:Class="DevBox.Host.Windows.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ChromeBrush}">
    <StackPanel Margin="18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="84" Height="28" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="确定" Width="84" Height="28" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
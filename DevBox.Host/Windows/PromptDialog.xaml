<Window x:Class="DevBox.Host.Windows.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ChromeBrush}">
    <StackPanel Margin="18">
        <TextBlock x:Name="MessageText" Style="{DynamicResource PageHintStyle}" Margin="0,0,0,10" />
        <TextBox x:Name="InputBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Height="28" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" />
            <Button Content="确定" Width="80" Height="28" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
<UserControl x:Class="DevBox.Host.Views.ImageToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevBox.Host.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ImageToolViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:ImageToolViewModel />
    </UserControl.DataContext>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="图像格式转换器" Style="{DynamicResource PageTitleStyle}" />
            <TextBlock Text="批量转换图片格式（绿色版熔岩模块使用 Magick.NET）" Style="{DynamicResource PageHintStyle}" />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="选择图片…" Margin="0,0,8,0" Command="{Binding PickFilesCommand}" />
            <ComboBox Width="100" Margin="0,0,8,0" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" />
            <TextBox Width="60" Margin="0,0,8,0" Style="{StaticResource SearchBoxStyle}"
                     Text="{Binding Quality, UpdateSourceTrigger=PropertyChanged}" ToolTip="质量 1-100" />
            <TextBox Width="240" Margin="0,0,8,0" Style="{StaticResource SearchBoxStyle}"
                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="输出目录（留空 = 与源文件同目录）" />
            <Button Content="目录…" Margin="0,0,8,0" Command="{Binding PickOutputDirectoryCommand}" />
            <Button Content="转换" Style="{StaticResource AccentButtonStyle}" Command="{Binding ConvertCommand}" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   Text="{Binding Message}" Style="{DynamicResource PageHintStyle}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{DynamicResource SectionTitleStyle}">
                        <Run Text="已选 " /><Run Text="{Binding Files.Count, Mode=OneWay}" /><Run Text=" 个文件" />
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{DynamicResource MonoTextStyle}" Margin="0,0,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <DataGrid Grid.Column="1" ItemsSource="{Binding Results}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="输入" Binding="{Binding Input}" Width="*" />
                    <DataGridTextColumn Header="输出" Binding="{Binding Output}" Width="*" />
                    <DataGridTextColumn Header="结果" Binding="{Binding Success}" Width="80" />
                    <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
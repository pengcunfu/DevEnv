<Project>
  <!--
    统一各 csproj 的 bin / obj 到仓库根目录，避免散落在子项目下。
    布局：bin/<ProjectName>/<Configuration>/…  obj/<ProjectName>/…

    例外：WPF 标记编译会临时生成 <ProjectName>_<random>_wpftmp 项目，MSBuild 显式把主项目的
    BaseIntermediateOutputPath / MSBuildProjectExtensionsPath 传给它，用来定位已经复制过去的
    nuget.g.props。若这里再按 $(MSBuildProjectName) 重定向一次，临时项目就会去找一个从未被写入
    的 obj 目录，报 NETSDK1004 找不到 project.assets.json。
  -->
  <PropertyGroup Condition="!$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('_wpftmp'))">
    <_RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</_RepoRoot>
    <BaseIntermediateOutputPath>$(_RepoRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(_RepoRoot)bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
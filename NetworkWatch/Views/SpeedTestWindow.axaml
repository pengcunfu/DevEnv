<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetworkWatch.Views.SpeedTestWindow"
        Title="网络测速"
        Height="560" Width="700"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontSize="13"
        Background="{DynamicResource BackgroundBrush}">
  <Border Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
          TextElement.Foreground="{DynamicResource ForegroundBrush}">
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock Text="网络测速" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}"/>
        <TextBlock Text="测量网络下载与上传速度，数据来自公共测速节点"
                   Classes="muted" Margin="0,4,0,0"/>
      </StackPanel>

      <Border Grid.Row="1" Classes="Card" Padding="16,12">
        <Grid ColumnDefinitions="*,170,80">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PhaseText" Text="就绪" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Text="点击「开始测速」进行测试"
                       Classes="muted" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="当前速率" Classes="muted" HorizontalAlignment="Right"/>
            <TextBlock x:Name="SpeedText" Text="--" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Right"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="用时" Classes="muted" HorizontalAlignment="Right"/>
            <TextBlock x:Name="ElapsedText" Text="0.0s" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="2" Margin="0,14,0,0" ColumnDefinitions="*,Auto">
        <ProgressBar x:Name="MainProgressBar" Height="12" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="PercentText" Grid.Column="1" Margin="12,0,0,0" Width="48"
                   VerticalAlignment="Center" HorizontalAlignment="Right" Text="0%"/>
      </Grid>

      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
        <Button x:Name="StartButton" Content="开始测速" Click="StartButton_Click"
                Margin="0,0,10,0" Padding="22,9" FontWeight="SemiBold" MinWidth="120"/>
        <Button x:Name="CancelButton" Content="取消" Classes="outline" Click="CancelButton_Click"
                IsEnabled="False" MinWidth="80"/>
      </StackPanel>

      <Grid Grid.Row="4" Margin="0,18,0,0" ColumnDefinitions="*,12,*">
        <Border Classes="Card" Padding="18">
          <StackPanel>
            <TextBlock Text="下载速度" Classes="muted" FontSize="14"/>
            <TextBlock x:Name="DownloadValue" Text="--" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0"/>
            <TextBlock x:Name="DownloadDetailText" Classes="muted"
                       Margin="0,8,0,0" Text="下载 100 MB 测试数据"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="Card" Padding="18">
          <StackPanel>
            <TextBlock Text="上传速度" Classes="muted" FontSize="14"/>
            <TextBlock x:Name="UploadValue" Text="--" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
            <TextBlock x:Name="UploadDetailText" Classes="muted"
                       Margin="0,8,0,0" Text="上传 100 MB 测试数据"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="5" Classes="Card" Margin="0,14,0,0" Padding="14,10">
        <Grid ColumnDefinitions="*,*,1.4*,*">
          <StackPanel>
            <TextBlock Text="延迟" Classes="muted"/>
            <TextBlock x:Name="PingValue" Text="--" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="抖动" Classes="muted"/>
            <TextBlock x:Name="JitterValue" Text="--" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="测速节点" Classes="muted"/>
            <TextBlock x:Name="ServerValue" Text="--" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="总用时" Classes="muted"/>
            <TextBlock x:Name="DurationValue" Text="--" FontWeight="SemiBold"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

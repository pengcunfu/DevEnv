<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetworkWatch.Views.ProcessDetailWindow"
        Title="进程详细信息"
        Height="600" Width="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NetworkWatch/Themes/NetworkWatch.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border Background="{DynamicResource NwBackgroundBrush}">
    <Grid Margin="16" RowDefinitions="*,Auto"
          TextElement.Foreground="{DynamicResource NwTextBrush}">
      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
          <Border Background="{DynamicResource NwPanelBrush}" BorderBrush="{DynamicResource NwBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="基本信息" FontWeight="Bold"
                         Foreground="{DynamicResource NwAccentBrush}" Margin="0,0,0,8"/>
              <TextBlock x:Name="BasicText" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource NwPanelBrush}" BorderBrush="{DynamicResource NwBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="CPU 信息" FontWeight="Bold"
                         Foreground="{DynamicResource NwAccentBrush}" Margin="0,0,0,8"/>
              <TextBlock x:Name="CpuText" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource NwPanelBrush}" BorderBrush="{DynamicResource NwBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="内存信息" FontWeight="Bold"
                         Foreground="{DynamicResource NwAccentBrush}" Margin="0,0,0,8"/>
              <TextBlock x:Name="MemoryText" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource NwPanelBrush}" BorderBrush="{DynamicResource NwBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="连接信息" FontWeight="Bold"
                         Foreground="{DynamicResource NwAccentBrush}" Margin="0,0,0,8"/>
              <TextBlock x:Name="ConnectionText" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource NwPanelBrush}" BorderBrush="{DynamicResource NwBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
              <TextBlock Text="其他信息" FontWeight="Bold"
                         Foreground="{DynamicResource NwAccentBrush}" Margin="0,0,0,8"/>
              <TextBlock x:Name="OtherText" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="关闭" Click="CloseButton_Click" MinWidth="90"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>

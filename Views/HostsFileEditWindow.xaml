<Window x:Class="DevEnv.Views.HostsFileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hosts 文件编辑器" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <!-- 工具栏 -->
        <ToolBar DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="LocateFileButton" Content="定位到文件" Width="100" Height="30"
                    Command="{Binding LocateFileCommand}" Margin="0,0,5,0"/>
            <Button x:Name="OpenNotepadButton" Content="在记事本中打开" Width="120" Height="30"
                    Command="{Binding OpenInNotepadCommand}" Margin="0,0,5,0"/>
            <Button x:Name="EnvVarsButton" Content="环境变量" Width="100" Height="30"
                    Command="{Binding OpenEnvVarsCommand}"/>
        </ToolBar>

        <!-- 标签页 -->
        <TabControl x:Name="MainTabControl" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- 文本编辑标签页 -->
            <TabItem Header="文本编辑">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="HostsTextBox"
                             Grid.Row="0"
                             Text="{Binding HostsText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ReloadTextButton" Content="重新加载" Width="100" Height="30"
                                Command="{Binding ReloadCommand}" Margin="0,0,10,0"/>
                        <Button x:Name="SaveTextButton" Content="保存" Width="100" Height="30"
                                Command="{Binding SaveTextCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 按条编辑标签页 -->
            <TabItem Header="按条编辑">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="EntriesDataGrid"
                              Grid.Row="0"
                              ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding SelectedEntry}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP地址" Binding="{Binding Ip}" Width="2*"/>
                            <DataGridTextColumn Header="域名" Binding="{Binding Domain}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AddButton" Content="添加" Width="80" Height="30"
                                Command="{Binding AddEntryCommand}" Margin="0,0,10,0"/>
                        <Button x:Name="DeleteButton" Content="删除" Width="80" Height="30"
                                Command="{Binding DeleteEntryCommand}" Margin="0,0,10,0"/>
                        <Button x:Name="ModifyButton" Content="修改" Width="80" Height="30"
                                Command="{Binding ModifyEntryCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Height="25">
            <StatusBarItem>
                <TextBlock Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </DockPanel>
</Window>

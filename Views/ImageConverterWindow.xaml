<Window x:Class="DevEnv.Views.ImageConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DevEnv"
        mc:Ignorable="d"
        Title="图像格式转换器" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- 转换状态样式 -->
        <Style x:Key="StatusRunning" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Orange"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StatusSuccess" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Green"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StatusError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 输入文件选择 -->
        <GroupBox Grid.Row="0" Header="输入文件" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputFilesTextBox"
                         Grid.Column="0"
                         Margin="5"
                         VerticalAlignment="Center"
                         IsReadOnly="True"
                         Text="{Binding SelectedFilesText, Mode=OneWay}"/>

                <Button x:Name="SelectFilesButton"
                        Grid.Column="1"
                        Content="选择文件..."
                        Width="100"
                        Margin="5,0,0,0"
                        Click="SelectFilesButton_Click"/>

                <Button x:Name="SelectFolderButton"
                        Grid.Column="2"
                        Content="选择文件夹..."
                        Width="100"
                        Margin="5,0,0,0"
                        Click="SelectFolderButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- 输出设置 -->
        <GroupBox Grid.Row="1" Header="输出设置" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 输出格式 -->
                <TextBlock Text="输出格式："
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="5"/>

                <ComboBox x:Name="OutputFormatComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          Margin="5"
                          SelectedIndex="0"
                          SelectedItem="{Binding SelectedOutputFormat}">
                    <ComboBoxItem Content="JPEG (.jpg)"/>
                    <ComboBoxItem Content="PNG (.png)"/>
                    <ComboBoxItem Content="BMP (.bmp)"/>
                    <ComboBoxItem Content="GIF (.gif)"/>
                    <ComboBoxItem Content="TIFF (.tiff)"/>
                    <ComboBoxItem Content="WEBP (.webp)"/>
                    <ComboBoxItem Content="ICO (.ico)"/>
                </ComboBox>

                <!-- 质量设置（仅对有损格式显示） -->
                <TextBlock Text="质量："
                           Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="5"
                           Visibility="{Binding IsQualityVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Grid Grid.Row="1"
                      Grid.Column="1"
                      Margin="5"
                      Visibility="{Binding IsQualityVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Slider x:Name="QualitySlider"
                            Grid.Column="0"
                            Minimum="1"
                            Maximum="100"
                            Value="{Binding Quality}"
                            VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ElementName=QualitySlider, Path=Value, StringFormat={}{0}%}"
                               Width="50"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 输出目录 -->
                <TextBlock Text="输出目录："
                           Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="5"/>

                <TextBox x:Name="OutputDirectoryTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding OutputDirectory}"/>

                <Button x:Name="BrowseOutputButton"
                        Grid.Row="2"
                        Grid.Column="2"
                        Content="浏览..."
                        Width="80"
                        Margin="5,0,0,0"
                        Click="BrowseOutputButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- 转换选项 -->
        <GroupBox Grid.Row="2" Header="转换选项" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="UseSourceDirectoryCheckBox"
                          Grid.Column="0"
                          Content="使用源文件目录"
                          Margin="5"
                          IsChecked="{Binding UseSourceDirectory}"/>

                <CheckBox x:Name="OverwriteExistingCheckBox"
                          Grid.Column="1"
                          Content="覆盖已存在的文件"
                          Margin="5"
                          IsChecked="{Binding OverwriteExisting}"/>
            </Grid>
        </GroupBox>

        <!-- 日志输出 -->
        <GroupBox Grid.Row="3" Header="转换日志" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogTextBox"
                             IsReadOnly="True"
                             Text="{Binding LogText}"
                             FontFamily="Consolas"
                             TextWrapping="Wrap"
                             Background="#f0f0f0"/>
                </ScrollViewer>

                <!-- 统计信息 -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="5">
                    <TextBlock Text="成功: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding SuccessCount}" Foreground="Green" FontWeight="Bold" Margin="0,0,10,0"/>

                    <TextBlock Text="失败: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding ErrorCount}" Foreground="Red" FontWeight="Bold" Margin="0,0,10,0"/>

                    <TextBlock Text="总进度: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding ProgressText}" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button x:Name="StartConversionButton"
                    Content="开始转换"
                    Width="100"
                    Height="30"
                    Margin="5"
                    Click="StartConversionButton_Click"
                    IsEnabled="{Binding CanStartConversion}"/>

            <Button x:Name="ClearLogButton"
                    Content="清空日志"
                    Width="100"
                    Height="30"
                    Margin="5"
                    Click="ClearLogButton_Click"/>

            <Button x:Name="CloseButton"
                    Content="关闭"
                    Width="100"
                    Height="30"
                    Margin="5"
                    IsCancel="True"/>
        </StackPanel>

        <!-- 进度条 -->
        <ProgressBar Grid.Row="4"
                     Value="{Binding Progress}"
                     Maximum="100"
                     Height="20"
                     Margin="0,10,0,45"
                     Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</Window>
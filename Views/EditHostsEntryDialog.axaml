<Window x:Class="DevEnv.Views.EditHostsEntryDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="添加Hosts条目" Height="200" Width="350"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- IP地址输入 -->
        <Label Grid.Row="0" Content="IP地址:" Margin="0,0,0,5"/>
        <TextBox x:Name="IpTextBox" Grid.Row="1" Height="25"
                 Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,15"
                 VerticalContentAlignment="Center"/>

        <!-- 域名输入 -->
        <Label Grid.Row="2" Content="域名:" Margin="0,0,0,5"/>
        <TextBox x:Name="DomainTextBox" Grid.Row="3" Height="25"
                 Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,15"
                 VerticalContentAlignment="Center"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ConfirmButton" Content="确定" Width="80" Height="30"
                    Click="ConfirmButton_Click" IsDefault="True" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Height="30"
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>


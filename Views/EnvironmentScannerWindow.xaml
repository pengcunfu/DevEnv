<Window x:Class="DevEnv.Views.EnvironmentScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="环境扫描" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Name="BtnScan" Content="扫描系统环境" Width="120" Height="30" Click="BtnScan_Click"/>
            <TextBlock Name="TxtSummary" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Name="EnvGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="*"/>
                <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="2*"/>
                <DataGridCheckBoxColumn Header="在 PATH 中" Binding="{Binding IsInPath}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Name="TxtStatus" Text="点击「扫描系统环境」开始检测"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

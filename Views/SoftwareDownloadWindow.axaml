<Window x:Class="DevEnv.Views.SoftwareDownloadWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x8F6F;&#x4EF6;&#x4E0B;&#x8F7D;"
        Height="520" Width="820"
        MinHeight="400" MinWidth="720" MaxHeight="560" MaxWidth="860"
        Background="#F3F4F6"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ControlTheme x:Key="FilterButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </ControlTheme>

        <ControlTheme x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="DataGrid#SoftwareDataGrid">
            <Setter Property="RowHeight" Value="36"/>
        </Style>
        <Style Selector="DataGrid#SoftwareDataGrid DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="&#x8F6F;&#x4EF6;&#x4E0B;&#x8F7D;"
                           FontSize="15" FontWeight="SemiBold" Foreground="#111827"
                           VerticalAlignment="Center" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="&#x641C;&#x7D22;"
                           FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <TextBox Grid.Row="1" Grid.Column="1" Name="TxtSearch"
                         Height="26" FontSize="12" VerticalContentAlignment="Center"
                         Padding="8,0" Margin="0,0,8,0"
                         Watermark="&#x8F93;&#x5165;&#x8F6F;&#x4EF6;&#x540D;&#x79F0;&#x6216;&#x5173;&#x952E;&#x8BCD;"
                         TextChanged="TxtSearch_TextChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="&#x5206;&#x7C7B;"
                           FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Row="1" Grid.Column="3" Name="CmbCategory"
                          Height="26" FontSize="12" Margin="0,0,8,0"
                          SelectionChanged="CmbCategory_SelectionChanged"/>

                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                    <Button Name="BtnSearch" Content="&#x641C;&#x7D22;" Theme="{StaticResource PrimaryButton}" Margin="0,0,4,0"
                            Click="BtnSearch_Click"/>
                    <Button Name="BtnReset" Content="&#x91CD;&#x7F6E;" Theme="{StaticResource FilterButton}" Margin="0,0,4,0"
                            Click="BtnReset_Click"/>
                    <Button Name="BtnOpenDownloadManager" Content="&#x4E0B;&#x8F7D;&#x7BA1;&#x7406;" Theme="{StaticResource FilterButton}"
                            Click="BtnOpenDownloadManager_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="4,2">
            <DataGrid Name="SoftwareDataGrid" Classes="compact-data-grid"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="False" CanUserSortColumns="False"
                      IsReadOnly="False" SelectionMode="Single"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="&#x8F6F;&#x4EF6;" Binding="{Binding Name}" Width="108" IsReadOnly="True"/>
                    <DataGridTextColumn Header="&#x5206;&#x7C7B;" Binding="{Binding Category}" Width="112" IsReadOnly="True"/>
                    <DataGridTextColumn Header="&#x63CF;&#x8FF0;" Binding="{Binding Description}" Width="*" MinWidth="140" IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="&#x7248;&#x672C;" Width="128" IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Classes="compact-grid-combo"
                                          ItemsSource="{Binding Versions}"
                                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Version}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          PointerPressed="VersionComboBox_PointerPressed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="&#x64CD;&#x4F5C;" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="&#x4E0B;&#x8F7D;" Tag="{Binding}"
                                        Theme="{StaticResource CompactGridButton}"
                                        Click="BtnDownload_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="4,0">
            <Grid>
                <TextBlock Name="TxtStatus" Text="&#x5C31;&#x7EEA;" FontSize="11" Foreground="#059669" VerticalAlignment="Center"/>
                <TextBlock Name="TxtCount" Text="&#x5171; 0 &#x9879;" FontSize="11" Foreground="#9CA3AF"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

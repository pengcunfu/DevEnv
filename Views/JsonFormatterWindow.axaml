<Window x:Class="DevEnv.Views.JsonFormatterWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DevEnv" Title="JSON 格式化工具" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Name="BtnFormat" Content="格式化" Width="80" Height="30" Margin="5,0" Click="BtnFormat_Click"/>
            <Button Name="BtnMinify" Content="压缩" Width="80" Height="30" Margin="5,0" Click="BtnMinify_Click"/>
            <Button Name="BtnValidate" Content="验证" Width="80" Height="30" Margin="5,0" Click="BtnValidate_Click"/>
            <Button Name="BtnClear" Content="清空" Width="80" Height="30" Margin="5,0" Click="BtnClear_Click"/>
            <Separator Width="20"/>
            <Button Name="BtnCopyInput" Content="复制输入" Width="80" Height="30" Margin="5,0" Click="BtnCopyInput_Click"/>
            <Button Name="BtnCopyOutput" Content="复制输出" Width="80" Height="30" Margin="5,0" Click="BtnCopyOutput_Click"/>
        </StackPanel>

        <!-- JSON 输入和输出 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="120"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="JSON 输入" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox Name="TxtInput"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 MinHeight="200"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          Margin="4,0"
                          Background="#E5E7EB"
                          ResizeDirection="Columns"/>

            <Border Grid.Column="2" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="JSON 输出" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox Name="TxtOutput"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 IsReadOnly="True"
                                 Background="#F5F5F5"
                                 MinHeight="200"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,10,0,0" Background="#F0F0F0" BorderBrush="#D1D1D1" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Name="TxtStatus" Text="就绪"/>
        </Border>
    </Grid>
</Window>


<Window x:Class="DevEnv.Views.SoftwareDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="软件下载"
        Height="520" Width="820"
        MinHeight="400" MinWidth="720" MaxHeight="560" MaxWidth="860"
        Background="#F3F4F6"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DownloadButton" TargetType="Button" BasedOn="{StaticResource CompactGridButton}"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 筛选栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="软件下载"
                           FontSize="15" FontWeight="SemiBold" Foreground="#111827"
                           VerticalAlignment="Center" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="搜索"
                           FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <TextBox Grid.Row="1" Grid.Column="1" Name="TxtSearch"
                         Height="26" FontSize="12" VerticalContentAlignment="Center"
                         Padding="8,0" Margin="0,0,8,0"
                         TextChanged="TxtSearch_TextChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="分类"
                           FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Row="1" Grid.Column="3" Name="CmbCategory"
                          Height="26" FontSize="12" Margin="0,0,8,0"
                          SelectionChanged="CmbCategory_SelectionChanged"/>

                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                    <Button Name="BtnSearch" Content="搜索" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"
                            Click="BtnSearch_Click"/>
                    <Button Name="BtnReset" Content="重置" Style="{StaticResource FilterButton}" Margin="0,0,4,0"
                            Click="BtnReset_Click"/>
                    <Button Name="BtnOpenDownloadManager" Content="下载管理" Style="{StaticResource FilterButton}"
                            Click="BtnOpenDownloadManager_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 软件列表 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="4,2">
            <DataGrid Name="SoftwareDataGrid" Style="{StaticResource CompactDataGrid}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="False" CanUserSortColumns="False"
                      IsReadOnly="False" SelectionMode="Single"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="软件" Binding="{Binding Name}" Width="128" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextPrimary}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="84" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextMuted}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" MinWidth="100" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextMuted}">
                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="版本" Width="108">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource CompactGridComboBox}"
                                          ItemsSource="{Binding Versions}"
                                          SelectedIndex="0"
                                          DisplayMemberPath="Version"
                                          Tag="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="下载" Tag="{Binding}"
                                        Style="{StaticResource DownloadButton}"
                                        Click="BtnDownload_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="4,0">
            <Grid>
                <TextBlock Name="TxtStatus" Text="就绪" FontSize="11" Foreground="#059669" VerticalAlignment="Center"/>
                <TextBlock Name="TxtCount" Text="共 0 项" FontSize="11" Foreground="#9CA3AF"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

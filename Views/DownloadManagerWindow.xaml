<Window x:Class="DevEnv.Views.DownloadManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载管理" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Name="BtnRefresh" Content="刷新" Width="80" Height="28" Margin="0,0,5,0" Click="BtnRefresh_Click"/>
            <Button Name="BtnClearCompleted" Content="清除已完成" Width="100" Height="28" Margin="0,0,5,0" Click="BtnClearCompleted_Click"/>
            <Button Name="BtnClearFailed" Content="清除失败" Width="80" Height="28" Margin="0,0,5,0" Click="BtnClearFailed_Click"/>
            <Button Name="BtnClearAll" Content="清空历史" Width="80" Height="28" Margin="0,0,5,0" Click="BtnClearAll_Click"/>
            <Button Name="BtnOpenFolder" Content="打开下载目录" Width="100" Height="28" Click="BtnOpenFolder_Click"/>
        </StackPanel>

        <TabControl Grid.Row="1" Name="TabControl">
            <TabItem Header="活动下载">
                <DataGrid Name="ActiveGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="软件" Binding="{Binding SoftwareName}" Width="120"/>
                        <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="80"/>
                        <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80"/>
                        <DataGridTextColumn Header="进度" Binding="{Binding Progress, StringFormat={}{0}%}" Width="60"/>
                        <DataGridTextColumn Header="速度" Binding="{Binding SpeedText}" Width="90"/>
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="140"/>
                        <DataGridTemplateColumn Header="操作" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="取消" Tag="{Binding Id}" Click="BtnCancel_Click" Width="60" Height="22"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="下载历史">
                <DataGrid Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="软件" Binding="{Binding SoftwareName}" Width="120"/>
                        <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="80"/>
                        <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80"/>
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="120"/>
                        <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
                        <DataGridTemplateColumn Header="操作" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="打开" Tag="{Binding SavePath}" Click="BtnOpenFile_Click" Width="60" Height="22"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="统计信息">
                <StackPanel Margin="20">
                    <TextBlock Name="TxtStatsTotal" FontSize="14" Margin="0,5"/>
                    <TextBlock Name="TxtStatsCompleted" FontSize="14" Margin="0,5"/>
                    <TextBlock Name="TxtStatsFailed" FontSize="14" Margin="0,5"/>
                    <TextBlock Name="TxtStatsDownloading" FontSize="14" Margin="0,5"/>
                    <TextBlock Name="TxtStatsBytes" FontSize="14" Margin="0,5"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Name="TxtStatus" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

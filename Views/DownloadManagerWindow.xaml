<Window x:Class="DevEnv.Views.DownloadManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载管理"
        Height="520" Width="820"
        MinHeight="400" MinWidth="720" MaxHeight="560" MaxWidth="860"
        Background="#F3F4F6"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="下载管理" FontSize="15" FontWeight="SemiBold" Foreground="#111827"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Name="BtnRefresh" Content="刷新" Style="{StaticResource CompactGridButton}" Margin="0,0,4,0" Click="BtnRefresh_Click"/>
                <Button Name="BtnClearCompleted" Content="清除已完成" Style="{StaticResource CompactGridButton}" Margin="0,0,4,0" Click="BtnClearCompleted_Click"/>
                <Button Name="BtnClearFailed" Content="清除失败" Style="{StaticResource CompactGridButton}" Margin="0,0,4,0" Click="BtnClearFailed_Click"/>
                <Button Name="BtnClearAll" Content="清空历史" Style="{StaticResource CompactGridDangerButton}" Margin="0,0,4,0" Click="BtnClearAll_Click"/>
                <Button Name="BtnOpenFolder" Content="打开目录" Style="{StaticResource CompactGridButton}" Click="BtnOpenFolder_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="4,2">
            <TabControl Name="TabControl" BorderThickness="0" Background="Transparent" Padding="4,2,4,0">
                <TabItem Header="活动下载" FontSize="12">
                    <DataGrid Name="ActiveGrid" Style="{StaticResource CompactDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="软件" Binding="{Binding SoftwareName}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextPrimary}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="72">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextMuted}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextMuted}">
                                        <Setter Property="ToolTip" Value="{Binding FileName}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="72">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextMuted}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="进度" Binding="{Binding Progress, StringFormat={}{0}%}" Width="52">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextPrimary}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="速度" Binding="{Binding SpeedText}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextMuted}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="取消" Tag="{Binding Id}" Style="{StaticResource CompactGridDangerButton}" Click="BtnCancel_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="下载历史" FontSize="12">
                    <DataGrid Name="HistoryGrid" Style="{StaticResource CompactDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="软件" Binding="{Binding SoftwareName}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextPrimary}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="72">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextMuted}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextMuted}">
                                        <Setter Property="ToolTip" Value="{Binding FileName}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="72">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextMuted}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="时间" Binding="{Binding StartTime, StringFormat=MM-dd HH:mm}" Width="88">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextMuted}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="打开" Tag="{Binding SavePath}" Style="{StaticResource CompactGridButton}" Click="BtnOpenFile_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="统计" FontSize="12">
                    <StackPanel Margin="12,8">
                        <TextBlock Name="TxtStatsTotal" FontSize="12" Foreground="#374151" Margin="0,4"/>
                        <TextBlock Name="TxtStatsCompleted" FontSize="12" Foreground="#374151" Margin="0,4"/>
                        <TextBlock Name="TxtStatsFailed" FontSize="12" Foreground="#374151" Margin="0,4"/>
                        <TextBlock Name="TxtStatsDownloading" FontSize="12" Foreground="#374151" Margin="0,4"/>
                        <TextBlock Name="TxtStatsBytes" FontSize="12" Foreground="#374151" Margin="0,4"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="4,0">
            <TextBlock Name="TxtStatus" Text="就绪" FontSize="11" Foreground="#6B7280"/>
        </Border>
    </Grid>
</Window>
